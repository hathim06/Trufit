<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <style>
        .success-page {
            min-height: 80vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #F9FAFB;
            padding: 40px 20px;
        }
        .success-card {
            background: #FFFFFF;
            max-width: 600px;
            width: 100%;
            padding: 60px 40px;
            border-radius: 20px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.05);
            text-align: center;
        }
        .success-icon {
            width: 80px;
            height: 80px;
            background: #10B981;
            color: #FFFFFF;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 30px;
            font-size: 40px;
        }
        .success-card h1 {
            font-size: 32px;
            font-weight: 700;
            margin-bottom: 10px;
            color: #111827;
        }
        .success-card p {
            color: #6B7280;
            font-size: 16px;
            margin-bottom: 40px;
        }
        .order-info {
            background: #F3F4F6;
            padding: 25px;
            border-radius: 12px;
            text-align: left;
            margin-bottom: 40px;
        }
        .info-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 12px;
            font-size: 14px;
        }
        .info-row:last-child {
            margin-bottom: 0;
            padding-top: 12px;
            border-top: 1px solid #E5E7EB;
            font-weight: 700;
            font-size: 16px;
            color: #111827;
        }
        .btn-group {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }
        .btn-success {
            padding: 15px;
            border-radius: 8px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s;
        }
        .btn-primary-success {
            background: #000;
            color: #FFF;
        }
        .btn-secondary-success {
            border: 1px solid #E5E7EB;
            color: #374151;
        }
        .btn-primary-success:hover {
            background: #374151;
        }
        .btn-secondary-success:hover {
            background: #F9FAFB;
        }
    </style>
</head>
<body>
    <%- include('partials/header') %>
    <main class="success-page">
        <div class="success-card">
            <div class="success-icon">
                <i data-lucide="check-circle"></i>
            </div>
            <h1>Order Placed!</h1>
            <p>Your order has been placed successfully and is being processed.</p>
            
            <div class="order-info">
                <div class="info-row">
                    <span>Order ID</span>
                    <span>#<%= order.orderId %></span>
                </div>
                <div class="info-row">
                    <span>Payment Method</span>
                    <span><%= order.paymentMethod %></span>
                </div>
                <div class="info-row">
                    <span>Amount Paid</span>
                    <span>₹<%= order.totalAmount.toLocaleString() %></span>
                </div>
            </div>

            <div class="btn-group">
                <a href="/profile/orders" class="btn-success btn-primary-success">View Orders</a>
                <a href="/shop" class="btn-success btn-secondary-success">Continue Shopping</a>
            </div>
        </div>
    </main>
    <%- include('partials/footer') %>
    <script>lucide.createIcons();</script>
</body>
</html>
