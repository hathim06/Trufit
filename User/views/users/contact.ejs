<!DOCTYPE html>
<html lang="en">

<%- include('partials/head') %>
    <style>
        /* Contact Page Content */
        .contact-content {
            padding: 60px 0;
        }

        .page-title {
            margin-bottom: 20px;
            font-size: 24px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .section-heading {
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 40px;
            text-transform: uppercase;
        }

        .contact-grid {
            display: grid;
            grid-template-columns: 1fr 400px;
            gap: 80px;
        }

        .contact-form {
            display: flex;
            flex-direction: column;
            gap: 25px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .form-group label {
            font-size: 14px;
            font-weight: 500;
            color: #4B5563;
        }

        .form-group label span {
            color: #FF0000;
        }

        .form-group input, .form-group textarea {
            padding: 12px 15px;
            border: 1px solid #D1D5DB;
            border-radius: 0;
            font-family: inherit;
            font-size: 14px;
            outline: none;
            transition: var(--transition);
        }

        .form-group textarea {
            height: 150px;
            resize: none;
        }

        .form-group input:focus, .form-group textarea:focus {
            border-color: #000;
        }

        .send-btn {
            background: #000000;
            color: #FFFFFF;
            padding: 15px 40px;
            border: none;
            font-weight: 700;
            font-size: 18px;
            cursor: pointer;
            text-transform: uppercase;
            width: fit-content;
            margin-top: 10px;
            transition: var(--transition);
        }

        .send-btn:hover {
            opacity: 0.8;
            transform: translateY(-2px);
        }

        /* Info Sidebar */
        .info-sidebar {
            background-color: #F9FAFB;
            padding: 40px;
        }

        .company-name {
            font-weight: 700;
            font-size: 16px;
            margin-bottom: 5px;
            text-align: center;
        }

        .location {
            font-size: 14px;
            color: #6B7280;
            margin-bottom: 30px;
            text-align: center;
        }

        .contact-info-list {
            margin-bottom: 40px;
        }

        .info-item {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 20px;
            font-size: 14px;
            color: #000;
        }

        .info-item i {
            width: 20px;
            color: #000;
        }

        .social-section {
            border-top: 1px solid #E5E7EB;
            padding-top: 30px;
            text-align: center;
        }

        .social-section h4 {
            font-size: 14px;
            font-weight: 700;
            margin-bottom: 25px;
            text-transform: uppercase;
        }

        .social-icons-row {
            display: flex;
            justify-content: center;
            gap: 25px;
        }

        .social-icon {
            color: #000;
            transition: var(--transition);
        }

        .social-icon:hover {
            transform: scale(1.2);
        }

        /* Footer Styling */
        .footer {
            border-top: 1px solid #E5E7EB;
            padding: 60px 0 0;
            margin-top: 80px;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: 200px 1fr 1fr 1fr;
            gap: 40px;
            margin-bottom: 60px;
        }

        .footer-logo {
            text-align: center;
        }

        .footer-logo img {
            width: 80px;
            margin-bottom: 10px;
        }

        .footer-logo div {
            font-weight: 700;
            font-size: 18px;
        }

        .footer-col h3 {
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 25px;
        }

        .footer-col ul {
            list-style: none;
        }

        .footer-col li {
            margin-bottom: 15px;
        }

        .footer-col a {
            color: #6B7280;
            text-decoration: none;
            font-size: 14px;
        }

        .social-link {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #000;
            font-size: 14px;
            text-decoration: none;
        }

        .copyright-bar {
            background: #000000;
            color: #FFFFFF;
            padding: 20px 0;
            text-align: center;
            font-size: 14px;
        }

        @media (max-width: 992px) {
            .contact-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>
<%- include('partials/header') %>

    <main class="container contact-content">
        <h1 class="page-title">CONTACT</h1>
        <h2 class="section-heading">GET IN TOUCH</h2>

        <div class="contact-grid">
            <form class="contact-form">
                <div class="form-group">
                    <label>Your Name <span>*</span></label>
                    <input type="text" required>
                </div>
                <div class="form-group">
                    <label>Email <span>*</span></label>
                    <input type="email" required>
                </div>
                <div class="form-group">
                    <label>Message <span>*</span></label>
                    <textarea required></textarea>
                </div>
                <button type="submit" class="send-btn">SEND MESSAGE</button>
            </form>

            <aside class="info-sidebar">
                <div class="company-name">Trufit</div>
                <div class="location">Mumbai, India</div>

                <div class="contact-info-list">
                    <div class="info-item">
                        <i data-lucide="map-pin"></i>
                        <span>Trufit, Mumbai,India</span>
                    </div>
                    <div class="info-item">
                        <i data-lucide="phone"></i>
                        <span>+91 73333 55557</span>
                    </div>
                    <div class="info-item">
                        <i data-lucide="mail"></i>
                        <span>Trufit@gmail.com</span>
                    </div>
                </div>

                <div class="social-section">
                    <h4>FOLLOW US ON</h4>
                    <div class="social-icons-row">
                        <a href="#" class="social-icon"><i data-lucide="facebook"></i></a>
                        <a href="#" class="social-icon"><i data-lucide="instagram"></i></a>
                        <a href="#" class="social-icon"><i data-lucide="twitter"></i></a>
                        <a href="#" class="social-icon"><i data-lucide="chrome"></i></a>
                    </div>
                </div>
            </aside>
        </div>
    </main>

    <%- include('partials/footer') %>

    <script>
        lucide.createIcons();
    </script>
</body>

</html>
