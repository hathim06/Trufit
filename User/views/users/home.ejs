<!DOCTYPE html>
<html lang="en">

<%- include('partials/head') %>
    <style>
        /* =============================================
           3-SCENE SCROLL-DRIVEN HERO ANIMATION
           ============================================= */

        /* Tall scroll container — 3 scenes × ~267vh each */
        .watch-scroll-section {
            position: relative;
            height: 900vh;
            background: transparent;
            /* Break out of any parent padding/max-width */
            width: 100vw;
            margin-left: calc(-50vw + 50%);
        }

        /* Sticky viewport that stays pinned while user scrolls */
        .watch-sticky-wrap {
            position: sticky;
            top: 0;
            width: 100vw;
            height: 100vh;
            min-height: 600px;
            overflow: hidden;
            background: #000;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Animated scene background (colour tint shifts per scene) */
        .scene-bg {
            position: absolute;
            inset: 0;
            z-index: 0;
            transition: background 1.2s ease;
            background: radial-gradient(ellipse at 50% 60%, #0a1628 0%, #04080f 55%, #000 100%);
        }

        /* Ambient glow behind the watch */
        .watch-glow {
            position: absolute;
            inset: 0;
            pointer-events: none;
            z-index: 1;
        }
        .watch-glow::before {
            content: '';
            position: absolute;
            top: 50%; left: 50%;
            transform: translate(-50%, -50%);
            width: 600px; height: 600px;
            background: radial-gradient(circle, rgba(30,100,255,0.18) 0%, rgba(0,200,255,0.08) 40%, transparent 70%);
            animation: glowPulse 4s ease-in-out infinite;
            border-radius: 50%;
        }
        @keyframes glowPulse {
            0%, 100% { opacity: 0.6; transform: translate(-50%,-50%) scale(1); }
            50%       { opacity: 1;   transform: translate(-50%,-50%) scale(1.12); }
        }

        /* Floating particles */
        .watch-particles {
            position: absolute;
            inset: 0;
            z-index: 1;
            pointer-events: none;
            overflow: hidden;
        }
        .particle {
            position: absolute;
            border-radius: 50%;
            background: rgba(100,180,255,0.5);
            animation: floatParticle linear infinite;
        }
        @keyframes floatParticle {
            0%   { transform: translateY(110vh) scale(0.5); opacity: 0; }
            10%  { opacity: 1; }
            90%  { opacity: 0.6; }
            100% { transform: translateY(-15vh) scale(1.1); opacity: 0; }
        }

        /* Ambient glow ring */
        .watch-glow {
            position: absolute;
            inset: 0;
            pointer-events: none;
            z-index: 1;
        }
        .watch-glow::before {
            content: '';
            position: absolute;
            top: 50%; left: 50%;
            transform: translate(-50%,-50%);
            width: 70vw; height: 70vw;
            max-width: 800px; max-height: 800px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(30,100,255,0.2) 0%, rgba(0,200,255,0.07) 45%, transparent 70%);
            animation: glowPulse 4s ease-in-out infinite;
        }
        @keyframes glowPulse {
            0%, 100% { opacity: 0.5; transform: translate(-50%,-50%) scale(1); }
            50%       { opacity: 1;   transform: translate(-50%,-50%) scale(1.1); }
        }

        /* ── PRODUCT IMAGE LAYER ── */
        .product-stage {
            position: absolute;
            inset: 0;
            z-index: 3;
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        /* Canvas rendering the watch frames — true full viewport */
        .scene-canvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            display: block;
            will-change: transform;
            filter: drop-shadow(0 30px 80px rgba(20,100,255,0.28)) drop-shadow(0 0 60px rgba(0,200,255,0.13));
        }

        /* ── TEXT PANELS ── */
        /* Each panel is absolutely positioned; JS drives opacity + translateY directly */
        .text-panel {
            position: absolute;
            z-index: 5;
            left: 5%;
            bottom: 12%;
            max-width: 420px;
            opacity: 0;
            transform: translateY(40px);
            will-change: transform, opacity;
            pointer-events: none;
        }
        .text-panel .tp-eyebrow {
            font-size: 10px;
            letter-spacing: 4px;
            text-transform: uppercase;
            color: rgba(100,180,255,0.85);
            margin-bottom: 12px;
            font-weight: 600;
        }
        .text-panel h2 {
            font-size: clamp(26px, 4.5vw, 58px);
            font-weight: 800;
            line-height: 1.08;
            margin-bottom: 14px;
            background: linear-gradient(135deg, #fff 0%, #cce2ff 55%, #7ab8ff 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .text-panel .tp-desc {
            font-size: 15px;
            color: rgba(200,225,255,0.65);
            line-height: 1.75;
            margin-bottom: 28px;
            -webkit-text-fill-color: rgba(200,225,255,0.65);
        }
        .tp-cta {
            display: flex;
            gap: 14px;
            flex-wrap: wrap;
        }
        .tp-btn-primary {
            display: inline-block;
            padding: 13px 30px;
            background: linear-gradient(135deg, #1a6bff, #0097ff);
            color: #fff;
            border-radius: 50px;
            font-weight: 600;
            font-size: 13px;
            letter-spacing: 0.5px;
            text-decoration: none;
            box-shadow: 0 8px 28px rgba(26,107,255,0.45);
            transition: transform 0.22s, box-shadow 0.22s;
        }
        .tp-btn-primary:hover { transform: translateY(-3px); box-shadow: 0 14px 36px rgba(26,107,255,0.65); color:#fff; }
        .tp-btn-outline {
            display: inline-block;
            padding: 13px 30px;
            border: 1.5px solid rgba(255,255,255,0.22);
            color: rgba(255,255,255,0.85);
            border-radius: 50px;
            font-weight: 600;
            font-size: 13px;
            text-decoration: none;
            backdrop-filter: blur(12px);
            background: rgba(255,255,255,0.04);
            transition: all 0.22s;
        }
        .tp-btn-outline:hover { background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.45); color:#fff; transform:translateY(-3px); }

        /* ── SPEC BADGES (right side) ── */
        .hero-specs-wrap {
            position: absolute;
            z-index: 5;
            right: 5%;
            bottom: 12%;
            display: flex;
            flex-direction: column;
            gap: 14px;
            align-items: flex-end;
            opacity: 0;
            transform: translateY(30px);
            will-change: transform, opacity;
        }
        .spec-badge {
            background: rgba(255,255,255,0.055);
            border: 1px solid rgba(255,255,255,0.1);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            border-radius: 14px;
            padding: 11px 20px;
            text-align: right;
            min-width: 140px;
        }
        .spec-badge .spec-val {
            font-size: 20px;
            font-weight: 700;
            color: #fff;
            line-height: 1;
        }
        .spec-badge .spec-lbl {
            font-size: 10px;
            color: rgba(160,200,255,0.7);
            letter-spacing: 1.5px;
            text-transform: uppercase;
            margin-top: 3px;
        }

        /* ── SCENE DOT INDICATORS ── */
        .scene-dots {
            position: absolute;
            z-index: 6;
            right: 28px;
            top: 50%;
            transform: translateY(-50%);
            display: flex;
            flex-direction: column;
            gap: 12px;
        }
        .scene-dot {
            width: 7px; height: 7px;
            border-radius: 50%;
            background: rgba(255,255,255,0.25);
            transition: all 0.4s ease;
            cursor: default;
        }
        .scene-dot.active {
            background: #fff;
            height: 22px;
            border-radius: 4px;
        }

        /* ── SCROLL PROGRESS BAR ── */
        .scroll-progress-bar {
            position: absolute;
            bottom: 0; left: 0;
            height: 2px;
            background: linear-gradient(90deg, #1a6bff, #00d4ff);
            z-index: 10;
            width: 0%;
            transition: width 0.04s linear;
        }

        /* ── SCROLL HINT ── */
        .scroll-hint {
            position: absolute;
            bottom: 26px;
            left: 50%;
            z-index: 10;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 5px;
            color: rgba(255,255,255,0.35);
            font-size: 10px;
            letter-spacing: 3px;
            text-transform: uppercase;
            animation: bounceDown 2s ease-in-out infinite;
            transition: opacity 0.5s;
        }
        .scroll-hint svg { width: 18px; height: 18px; stroke: rgba(255,255,255,0.35); }
        @keyframes bounceDown {
            0%,100% { transform: translateX(-50%) translateY(0); }
            50%      { transform: translateX(-50%) translateY(8px); }
        }

        /* ── SCENE TITLE TICKER (top-centre) ── */
        .scene-label {
            position: absolute;
            top: 28px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 6;
            font-size: 11px;
            letter-spacing: 4px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.3);
            white-space: nowrap;
            transition: opacity 0.5s;
        }

        /* ── RESPONSIVE ── */
        @media (max-width: 900px) {
            .text-panel { left: 4%; max-width: 360px; bottom: 10%; }
            .hero-specs-wrap { display: none; }
        }
        @media (max-width: 600px) {
            .text-panel { left: 4%; right: 4%; max-width: 100%; bottom: 8%; }
            .text-panel h2 { font-size: 32px; }
        }

        /* =============================================
           SCROLL-TRIGGERED SECTION ANIMATIONS
           ============================================= */

        /* Base invisible state — elements start hidden & shifted down */
        .anim-fade-up {
            opacity: 0;
            transform: translateY(48px);
            transition: opacity 0.7s cubic-bezier(0.22,1,0.36,1),
                        transform 0.7s cubic-bezier(0.22,1,0.36,1);
        }
        .anim-fade-up.is-visible {
            opacity: 1;
            transform: translateY(0);
        }

        /* Slide in from left */
        .anim-slide-left {
            opacity: 0;
            transform: translateX(-56px);
            transition: opacity 0.7s cubic-bezier(0.22,1,0.36,1),
                        transform 0.7s cubic-bezier(0.22,1,0.36,1);
        }
        .anim-slide-left.is-visible {
            opacity: 1;
            transform: translateX(0);
        }

        /* Slide in from right */
        .anim-slide-right {
            opacity: 0;
            transform: translateX(56px);
            transition: opacity 0.7s cubic-bezier(0.22,1,0.36,1),
                        transform 0.7s cubic-bezier(0.22,1,0.36,1);
        }
        .anim-slide-right.is-visible {
            opacity: 1;
            transform: translateX(0);
        }

        /* Scale pop-in */
        .anim-scale-in {
            opacity: 0;
            transform: scale(0.82);
            transition: opacity 0.65s cubic-bezier(0.34,1.56,0.64,1),
                        transform 0.65s cubic-bezier(0.34,1.56,0.64,1);
        }
        .anim-scale-in.is-visible {
            opacity: 1;
            transform: scale(1);
        }

        /* Stagger delays via nth-child (up to 8 children) */
        .stagger-children > *:nth-child(1) { transition-delay: 0.00s; }
        .stagger-children > *:nth-child(2) { transition-delay: 0.10s; }
        .stagger-children > *:nth-child(3) { transition-delay: 0.20s; }
        .stagger-children > *:nth-child(4) { transition-delay: 0.30s; }
        .stagger-children > *:nth-child(5) { transition-delay: 0.40s; }
        .stagger-children > *:nth-child(6) { transition-delay: 0.50s; }
        .stagger-children > *:nth-child(7) { transition-delay: 0.60s; }
        .stagger-children > *:nth-child(8) { transition-delay: 0.70s; }

        /* Section title reveal — underline sweep */
        .section-title-reveal {
            position: relative;
            display: inline-block;
        }
        .section-title-reveal::after {
            content: '';
            position: absolute;
            left: 0; bottom: -4px;
            width: 0; height: 3px;
            background: linear-gradient(90deg, #1a6bff, #00d4ff);
            border-radius: 2px;
            transition: width 0.8s cubic-bezier(0.22,1,0.36,1) 0.35s;
        }
        .section-title-reveal.is-visible::after {
            width: 100%;
        }

        /* Category card hover enhanced */
        .category-card {
            position: relative;
            overflow: hidden;
        }
        .category-card::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(26,107,255,0.06) 0%, rgba(0,212,255,0.04) 100%);
            opacity: 0;
            transition: opacity 0.35s ease;
            border-radius: inherit;
        }
        .category-card:hover::before { opacity: 1; }

        /* Product card shimmer line on hover */
        .product-card {
            position: relative;
            overflow: hidden;
        }
        .product-card::after {
            content: '';
            position: absolute;
            top: -60%;
            left: -75%;
            width: 50%;
            height: 200%;
            background: linear-gradient(120deg,
                rgba(255,255,255,0) 0%,
                rgba(255,255,255,0.18) 50%,
                rgba(255,255,255,0) 100%);
            transform: skewX(-20deg);
            transition: left 0.55s ease;
            pointer-events: none;
        }
        .product-card:hover::after { left: 130%; }

        /* Service icon spin on hover */
        .service-icon {
            transition: background 0.3s ease, transform 0.4s cubic-bezier(0.34,1.56,0.64,1);
        }
        .service-item:hover .service-icon {
            background: linear-gradient(135deg, #1a6bff22, #00d4ff22);
            transform: rotate(8deg) scale(1.12);
        }

        /* Testimonial card subtle lift on hover */
        .testimonial-card {
            transition: transform 0.35s cubic-bezier(0.22,1,0.36,1),
                        box-shadow 0.35s ease;
        }
        .testimonial-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 18px 48px rgba(0,0,0,0.09);
        }

        /* 5. Categories Section */
        .category-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 30px;
        }

        .category-card {
            background: #F9FAFB;
            border-radius: 20px;
            padding: 30px;
            display: flex;
            align-items: center;
            gap: 20px;
            transition: transform 0.35s cubic-bezier(0.22,1,0.36,1),
                        box-shadow 0.35s ease;
        }

        .category-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 12px 36px rgba(26,107,255,0.1);
        }

        .category-card .card-image {
            width: 100px;
            height: 100px;
            background: #FFFFFF;
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 15px;
        }

        .category-card .card-content h3 {
            font-size: 20px;
            margin-bottom: 8px;
        }

        .category-card .card-content p {
            font-size: 14px;
            color: #6B7280;
            line-height: 1.4;
        }

        /* 6. Product Grid */
        .product-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 40px;
        }

        .product-card {
            background: #FFFFFF;
            border-radius: 20px;
            overflow: hidden;
            transition: var(--transition);
            position: relative;
        }

        .product-card:hover {
            transform: translateY(-8px);
        }

        .product-image {
            background: #F9FAFB;
            padding: 40px;
            position: relative;
            display: flex;
            justify-content: center;
        }

        .product-image img {
            height: 220px;
            object-fit: contain;
        }

        .card-actions {
            position: absolute;
            top: 20px;
            right: 20px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .action-btn {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #FFFFFF;
            border: 1px solid #E5E7EB;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: var(--transition);
        }

        .heart-btn.active,
        .heart-btn:hover {
            background: #ef4444;
            color: #FFFFFF;
            border-color: #ef4444;
        }

        .cart-btn:hover {
            background: #000000;
            color: #FFFFFF;
        }

        .product-info {
            padding: 20px;
            text-align: center;
        }

        .product-info h3 {
            font-size: 20px;
            margin-bottom: 10px;
        }

        .rating {
            margin-bottom: 10px;
            display: flex;
            justify-content: center;
            gap: 2px;
        }

        .rating i {
            width: 16px;
            color: #D1D5DB;
        }

        .rating i.filled {
            color: #FBBF24;
            fill: #FBBF24;
        }

        .price {
            display: flex;
            justify-content: center;
            gap: 15px;
            align-items: center;
            font-weight: 700;
        }

        .old-price {
            text-decoration: line-through;
            color: #9CA3AF;
            font-weight: 400;
        }

        .new-price {
            color: #000000;
            font-size: 20px;
        }

        .view-more {
            text-align: center;
            margin-top: 50px;
        }

        .disabled-product-overlay {
            position: absolute;
            inset: 0;
            background: rgba(255, 255, 255, 0.6);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 10;
        }

        .disabled-badge {
            background: rgba(0, 0, 0, 0.8);
            color: #fff;
            padding: 10px 20px;
            border-radius: 30px;
            font-size: 14px;
            font-weight: 600;
            letter-spacing: 1px;
            text-transform: uppercase;
            backdrop-filter: blur(4px);
        }

        /* 7. Testimonials */
        .testimonial-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 30px;
        }

        .testimonial-card {
            background: #F9FAFB;
            border-radius: 20px;
            padding: 30px;
            display: flex;
            gap: 25px;
        }

        .user-img {
            width: 80px;
            height: 80px;
            border-radius: 20px;
            overflow: hidden;
            flex-shrink: 0;
        }

        .user-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .testimonial-content h3 {
            font-size: 20px;
            margin-bottom: 8px;
        }

        .testimonial-content p {
            color: #6B7280;
            margin-bottom: 15px;
            font-style: italic;
        }

        .carousel-dots {
            display: flex;
            justify-content: center;
            gap: 12px;
            margin-top: 40px;
        }

        .dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: #D1D5DB;
            cursor: pointer;
        }

        .dot.active {
            background: #3B82F6;
            width: 25px;
            border-radius: 10px;
        }

        /* 8. Services */
        .services-title {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 20px;
            margin-bottom: 50px;
        }

        .services-title .line {
            height: 1px;
            background: #E5E7EB;
            flex: 1;
        }

        .services-title h2 {
            font-size: 14px;
            letter-spacing: 2px;
            color: #9CA3AF;
            white-space: nowrap;
        }

        .services-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 30px;
        }

        .service-item {
            text-align: center;
        }

        .service-icon {
            width: 70px;
            height: 70px;
            background: #F3F4F6;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
        }

        .service-icon i {
            width: 30px;
            color: #000000;
        }

        .service-item h3 {
            font-size: 16px;
            margin-bottom: 10px;
            text-transform: uppercase;
        }

        .service-item p {
            font-size: 14px;
            color: #6B7280;
        }

        /* 9. Footer */
        .footer {
            background: #FFFFFF;
            padding-top: 80px;
            border-top: 1px solid #F3F4F6;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 50px;
            margin-bottom: 60px;
        }

        .footer-col h3 {
            font-size: 18px;
            margin-bottom: 25px;
        }

        .footer-col ul {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .footer-col ul li a {
            color: #6B7280;
        }

        .footer-col ul li a:hover {
            color: #000000;
            padding-left: 5px;
        }

        .social-col ul li {
            display: flex;
            align-items: center;
            gap: 12px;
            color: #6B7280;
        }

        .social-col i {
            width: 18px;
        }

        .copyright {
            padding: 30px 0;
            background: #000000;
            color: #FFFFFF;
            text-align: center;
            font-size: 14px;
        }

        /* 10. Responsive */
        @media (max-width: 1100px) {
            .hero h1 {
                font-size: 48px;
            }

            .hero-image img {
                width: 400px;
            }
        }

        @media (max-width: 992px) {
            .header-left .search-bar {
                display: none;
            }

            .category-grid,
            .product-grid,
            .services-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .footer-grid {
                grid-template-columns: 1fr 1fr;
            }
        }

        @media (max-width: 768px) {
            .container {
                padding: 0 15px;
            }

            .hero .container {
                flex-direction: column;
                text-align: center;
            }

            .hero-content {
                max-width: 100%;
                margin-bottom: 50px;
            }

            .hero-image {
                justify-content: center;
            }

            .hero h1 {
                font-size: 36px;
            }

            .nav {
                display: none;
            }

            .testimonial-grid {
                grid-template-columns: 1fr;
            }

            .footer-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 480px) {

            .category-grid,
            .product-grid,
            .services-grid {
                grid-template-columns: 1fr;
            }

            .hero h1 {
                font-size: 32px;
            }

            .section-spacing {
                padding: 50px 0;
            }
        }
    </style>
    </head>

    <body>
        <%- include('partials/header') %>

            <main>
                <!-- =============================================
                     3-SCENE SCROLL-DRIVEN HERO ANIMATION
                     ============================================= -->
                <section class="watch-scroll-section" id="watchScrollSection">
