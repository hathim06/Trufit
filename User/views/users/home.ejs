<!DOCTYPE html>
<html lang="en">

<%- include('partials/head') %>
    <style>
        /* 4. Hero Section */
        /* Dynamic Hero Slider */
        .hero-slider {
            position: relative;
            width: 100%;
            height: 600px;
            overflow: hidden;
            background: #000;
        }

        .slide {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            opacity: 0;
            visibility: hidden;
            transition: opacity 1s ease-in-out, visibility 1s;
            display: flex;
            align-items: center;
        }

        .slide.active {
            opacity: 1;
            visibility: visible;
        }

        .slide-bg {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
        }

        .slide-bg img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            filter: brightness(0.7);
        }

        .slide-content {
            position: relative;
            z-index: 2;
            width: 100%;
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
            color: #fff;
        }

        .slide-content h1 {
            font-size: 64px;
            font-weight: 700;
            line-height: 1.1;
            margin-bottom: 20px;
            transform: translateY(30px);
            opacity: 0;
            transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1) 0.3s;
        }

        .slide-content p {
            font-size: 20px;
            color: #D1D5DB;
            margin-bottom: 40px;
            max-width: 600px;
            transform: translateY(30px);
            opacity: 0;
            transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1) 0.5s;
        }

        .slide-content .btn {
            transform: translateY(30px);
            opacity: 0;
            transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1) 0.7s;
        }

        .slide.active .slide-content h1,
        .slide.active .slide-content p,
        .slide.active .slide-content .btn {
            transform: translateY(0);
            opacity: 1;
        }

        .slider-nav {
            position: absolute;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 3;
            display: flex;
            gap: 15px;
        }

        .slider-dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.3);
            cursor: pointer;
            transition: all 0.3s;
        }

        .slider-dot.active {
            background: #fff;
            width: 30px;
            border-radius: 10px;
        }

        /* 5. Categories Section */
        .category-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 30px;
        }

        .category-card {
            background: #F9FAFB;
            border-radius: 20px;
            padding: 30px;
            display: flex;
            align-items: center;
            gap: 20px;
            transition: var(--transition);
        }

        .category-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
        }

        .category-card .card-image {
            width: 100px;
            height: 100px;
            background: #FFFFFF;
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 15px;
        }

        .category-card .card-content h3 {
            font-size: 20px;
            margin-bottom: 8px;
        }

        .category-card .card-content p {
            font-size: 14px;
            color: #6B7280;
            line-height: 1.4;
        }

        /* 6. Product Grid */
        .product-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 40px;
        }

        .product-card {
            background: #FFFFFF;
            border-radius: 20px;
            overflow: hidden;
            transition: var(--transition);
            position: relative;
        }

        .product-card:hover {
            transform: translateY(-8px);
        }

        .product-image {
            background: #F9FAFB;
            padding: 40px;
            position: relative;
            display: flex;
            justify-content: center;
        }

        .product-image img {
            height: 220px;
            object-fit: contain;
        }

        .card-actions {
            position: absolute;
            top: 20px;
            right: 20px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .action-btn {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #FFFFFF;
            border: 1px solid #E5E7EB;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: var(--transition);
        }

        .heart-btn.active,
        .heart-btn:hover {
            background: #ef4444;
            color: #FFFFFF;
            border-color: #ef4444;
        }

        .cart-btn:hover {
            background: #000000;
            color: #FFFFFF;
        }

        .product-info {
            padding: 20px;
            text-align: center;
        }

        .product-info h3 {
            font-size: 20px;
            margin-bottom: 10px;
        }

        .rating {
            margin-bottom: 10px;
            display: flex;
            justify-content: center;
            gap: 2px;
        }

        .rating i {
            width: 16px;
            color: #D1D5DB;
        }

        .rating i.filled {
            color: #FBBF24;
            fill: #FBBF24;
        }

        .price {
            display: flex;
            justify-content: center;
            gap: 15px;
            align-items: center;
            font-weight: 700;
        }

        .old-price {
            text-decoration: line-through;
            color: #9CA3AF;
            font-weight: 400;
        }

        .new-price {
            color: #000000;
            font-size: 20px;
        }

        .view-more {
            text-align: center;
            margin-top: 50px;
        }

        /* 7. Testimonials */
        .testimonial-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 30px;
        }

        .testimonial-card {
            background: #F9FAFB;
            border-radius: 20px;
            padding: 30px;
            display: flex;
            gap: 25px;
        }

        .user-img {
            width: 80px;
            height: 80px;
            border-radius: 20px;
            overflow: hidden;
            flex-shrink: 0;
        }

        .user-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .testimonial-content h3 {
            font-size: 20px;
            margin-bottom: 8px;
        }

        .testimonial-content p {
            color: #6B7280;
            margin-bottom: 15px;
            font-style: italic;
        }

        .carousel-dots {
            display: flex;
            justify-content: center;
            gap: 12px;
            margin-top: 40px;
        }

        .dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: #D1D5DB;
            cursor: pointer;
        }

        .dot.active {
            background: #3B82F6;
            width: 25px;
            border-radius: 10px;
        }

        /* 8. Services */
        .services-title {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 20px;
            margin-bottom: 50px;
        }

        .services-title .line {
            height: 1px;
            background: #E5E7EB;
            flex: 1;
        }

        .services-title h2 {
            font-size: 14px;
            letter-spacing: 2px;
            color: #9CA3AF;
            white-space: nowrap;
        }

        .services-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 30px;
        }

        .service-item {
            text-align: center;
        }

        .service-icon {
            width: 70px;
            height: 70px;
            background: #F3F4F6;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
        }

        .service-icon i {
            width: 30px;
            color: #000000;
        }

        .service-item h3 {
            font-size: 16px;
            margin-bottom: 10px;
            text-transform: uppercase;
        }

        .service-item p {
            font-size: 14px;
            color: #6B7280;
        }

        /* 9. Footer */
        .footer {
            background: #FFFFFF;
            padding-top: 80px;
            border-top: 1px solid #F3F4F6;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 50px;
            margin-bottom: 60px;
        }

        .footer-col h3 {
            font-size: 18px;
            margin-bottom: 25px;
        }

        .footer-col ul {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .footer-col ul li a {
            color: #6B7280;
        }

        .footer-col ul li a:hover {
            color: #000000;
            padding-left: 5px;
        }

        .social-col ul li {
            display: flex;
            align-items: center;
            gap: 12px;
            color: #6B7280;
        }

        .social-col i {
            width: 18px;
        }

        .copyright {
            padding: 30px 0;
            background: #000000;
            color: #FFFFFF;
            text-align: center;
            font-size: 14px;
        }

        /* 10. Responsive */
        @media (max-width: 1100px) {
            .hero h1 {
                font-size: 48px;
            }

            .hero-image img {
                width: 400px;
            }
        }

        @media (max-width: 992px) {
            .header-left .search-bar {
                display: none;
            }

            .category-grid,
            .product-grid,
            .services-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .footer-grid {
                grid-template-columns: 1fr 1fr;
            }
        }

        @media (max-width: 768px) {
            .container {
                padding: 0 15px;
            }

            .hero .container {
                flex-direction: column;
                text-align: center;
            }

            .hero-content {
                max-width: 100%;
                margin-bottom: 50px;
            }

            .hero-image {
                justify-content: center;
            }

            .hero h1 {
                font-size: 36px;
            }

            .nav {
                display: none;
            }

            .testimonial-grid {
                grid-template-columns: 1fr;
            }

            .footer-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 480px) {

            .category-grid,
            .product-grid,
            .services-grid {
                grid-template-columns: 1fr;
            }

            .hero h1 {
                font-size: 32px;
            }

            .section-spacing {
                padding: 50px 0;
            }
        }
    </style>
    </head>

    <body>
        <%- include('partials/header') %>

            <main>
                <!-- Hero Slider Section -->
                <section class="hero-slider">
                    <% if (banners && banners.length > 0) { %>
                        <% banners.forEach((banner, index) => { %>
                            <div class="slide <%= index === 0 ? 'active' : '' %>" data-index="<%= index %>">
                                <div class="slide-bg">
                                    <img src="/<%= banner.image %>" alt="<%= banner.title %>">
                                </div>
                                <div class="slide-content">
                                    <h1><%= banner.title %></h1>
                                    <% if (banner.subtitle) { %>
                                        <p><%= banner.subtitle %></p>
                                    <% } %>
                                    <a href="<%= banner.link || '/shop' %>" class="btn btn-primary">SHOP NOW</a>
                                </div>
                            </div>
                        <% }) %>
                        <div class="slider-nav">
                            <% banners.forEach((_, index) => { %>
                                <div class="slider-dot <%= index === 0 ? 'active' : '' %>" data-index="<%= index %>"></div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <!-- Fallback Static Banner -->
                        <div class="slide active">
                            <div class="slide-bg">
                                <img src="public/apple_smart_3.png" alt="Featured Smartwatch" style="background: #111;">
                            </div>
                            <div class="slide-content">
                                <h1>Discover Most Suitable Watches</h1>
                                <p>Find the best, reliable, and cheap smart watches here. We focus on product quality.</p>
                                <a href="/shop" class="btn btn-primary">ORDER NOW</a>
                            </div>
                        </div>
                    <% } %>
                </section>

                <!-- Categories Section -->
                <section class="categories section-spacing">
                    <div class="container">
                        <div class="category-grid">
                            <div class="category-card">
                                <div class="card-image">
                                    <img src="public/apple_smart_1.png" alt="Apple Watch">
                                </div>
                                <div class="card-content">
                                    <h3>Apple</h3>
                                    <p>Apple is one of the most famous smart watches providing company.</p>
                                </div>
                            </div>
                            <div class="category-card">
                                <div class="card-image">
                                    <img src="public/apple_smart_2.png" alt="Xiaomi Watch">
                                </div>
                                <div class="card-content">
                                    <h3>Xiaomi</h3>
                                    <p>Xiaomi smart watches are produced by MI company.</p>
                                </div>
                            </div>
                            <div class="category-card">
                                <div class="card-image">
                                    <img src="public/fitbit_max_1.png" alt="FitBit Watch">
                                </div>
                                <div class="card-content">
                                    <h3>FitBit</h3>
                                    <p>FitBit smart watches are best for there health and fitness features.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Product Section -->
                <section class="products section-spacing">
                    <div class="container">
                        <div class="section-title">
                            <p>Find your favourite smart watch.</p>
                            <h2>Our Latest Products</h2>
                        </div>
                        <div class="product-grid">
                            <% if (products && products.length> 0) { %>
                                <% products.forEach(product=> { %>
                                    <div class="product-card">
                                        <a href="/product/<%= product._id %>"
                                            style="text-decoration: none; color: inherit;">
                                            <div class="product-image">
                                                <% if (product.image && product.image.length> 0) { %>
                                                    <img src="<%= product.image[0] %>" alt="<%= product.name %>">
                                                    <% } else { %>
                                                        <img src="public/placeholder.png" alt="No Image Available">
                                                        <% } %>

                                                            <div class="card-actions">
                                                                <div class="heart-btn"
                                                                    onclick="addToWishlist(event, '<%= product._id %>')">
                                                                    <i data-lucide="heart"></i>
                                                                </div>

                                                                <div class="cart-btn-circle"
                                                                    onclick="addToCart(event, '<%= product._id %>')">
                                                                    <i data-lucide="shopping-cart"></i>
                                                                </div>
                                                            </div>

                                            </div>
                                            <div class="product-info">
                                                <h3>
                                                    <%= product.name %>
                                                </h3>
                                                <div class="rating">
                                                    <i data-lucide="star" class="filled"></i>
                                                    <i data-lucide="star" class="filled"></i>
                                                    <i data-lucide="star" class="filled"></i>
                                                    <i data-lucide="star" class="filled"></i>
                                                    <i data-lucide="star"></i>
                                                </div>
                                                <div class="price">
                                                    <% if (product.offerPrice && product.offerPrice < product.price) {
                                                        %>
                                                        <span class="old-price">₹<%= product.price %></span>
                                                        <span class="new-price">₹<%= product.offerPrice %></span>
                                                        <% } else { %>
                                                            <span class="new-price">₹<%= product.price %></span>
                                                            <% } %>
                                                </div>
                                            </div>
                                        </a>
                                    </div>
                                    <% }) %>
                                        <% } else { %>
                                            <div style="grid-column: 1 / -1; text-align: center; padding: 40px;">
                                                <p>No products featured on the home page yet.</p>
                                            </div>
                                            <% } %>
                        </div>
                        <div class="view-more">
                            <a href="/shop" class="btn btn-primary-outline">View More</a>
                        </div>
                    </div>
                </section>

                <!-- Testimonials Section -->
                <section class="testimonials section-spacing">
                    <div class="container">
                        <div class="section-title">
                            <p>Here are our some of the best clients.</p>
                            <h2>What People Say About Us</h2>
                        </div>
                        <div class="testimonial-grid">
                            <div class="testimonial-card">
                                <div class="user-img">
                                    <img src="public/avatar1.png" alt="Hamza Faizi">
                                </div>
                                <div class="testimonial-content">
                                    <h3>Hamza Faizi</h3>
                                    <p>Don’t waste time, just order! This is the best website to purchase smart watches.
                                    </p>
                                    <div class="rating">
                                        <i data-lucide="star" class="filled"></i>
                                        <i data-lucide="star" class="filled"></i>
                                        <i data-lucide="star" class="filled"></i>
                                        <i data-lucide="star" class="filled"></i>
                                        <i data-lucide="star" class="filled"></i>
                                    </div>
                                </div>
                            </div>
                            <div class="testimonial-card">
                                <div class="user-img">
                                    <img src="public/avatar2.png" alt="Hafiz Huzaifa">
                                </div>
                                <div class="testimonial-content">
                                    <h3>Hafiz Huzaifa</h3>
                                    <p>I’ve been purchasing smart watches of Trufit for a long time. All the products
                                        are
                                        good
                                        quality.</p>
                                    <div class="rating">
                                        <i data-lucide="star" class="filled"></i>
                                        <i data-lucide="star" class="filled"></i>
                                        <i data-lucide="star" class="filled"></i>
                                        <i data-lucide="star" class="filled"></i>
                                        <i data-lucide="star" class="filled"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="carousel-dots">
                            <span class="dot"></span>
                            <span class="dot"></span>
                            <span class="dot"></span>
                            <span class="dot active"></span>
                        </div>
                    </div>
                </section>

                <!-- Services Section -->
                <section class="services section-spacing">
                    <div class="container">
                        <div class="services-title">
                            <div class="line"></div>
                            <h2>OUR SERVICE</h2>
                            <div class="line"></div>
                        </div>
                        <div class="services-grid">
                            <div class="service-item">
                                <div class="service-icon">
                                    <i data-lucide="percent"></i>
                                </div>
                                <h3>5 % OFF</h3>
                                <p>5 % OFF on Pre-paid orders</p>
                            </div>
                            <div class="service-item">
                                <div class="service-icon">
                                    <i data-lucide="truck"></i>
                                </div>
                                <h3>SHIPPING WITHIN 48 HOURS</h3>
                                <p>Your order will be shipped within 48 hours from the time since order is placed</p>
                            </div>
                            <div class="service-item">
                                <div class="service-icon">
                                    <i data-lucide="shield-check"></i>
                                </div>
                                <h3>Quality Assurance</h3>
                                <p>Crafted with quality and care in India, from raw materials to the final product.</p>
                            </div>
                            <div class="service-item">
                                <div class="service-icon">
                                    <i data-lucide="clock"></i>
                                </div>
                                <h3>Durable Style</h3>
                                <p>Durable, stylish footwear built for everyday comfort.</p>
                            </div>
                        </div>
                    </div>
                </section>
            </main>

            <%- include('partials/footer') %>

                <script>
                    lucide.createIcons();

                    // Hero Slider Logic
                    const slides = document.querySelectorAll('.slide');
                    const dots = document.querySelectorAll('.slider-dot');
                    let currentSlide = 0;
                    let slideInterval;

                    function showSlide(n) {
                        slides.forEach(s => s.classList.remove('active'));
                        dots.forEach(d => d.classList.remove('active'));
                        
                        currentSlide = (n + slides.length) % slides.length;
                        
                        slides[currentSlide].classList.add('active');
                        dots[currentSlide].classList.add('active');
                    }

                    function nextSlide() {
                        showSlide(currentSlide + 1);
                    }

                    function startSlider() {
                        if (slides.length > 1) {
                            slideInterval = setInterval(nextSlide, 5000);
                        }
                    }

                    dots.forEach((dot, index) => {
                        dot.addEventListener('click', () => {
                            clearInterval(slideInterval);
                            showSlide(index);
                            startSlider();
                        });
                    });

                    startSlider();

                    // 1. ADD TO CART FUNCTION
                    async function addToCart(event, productId) {
                        // Stop the click from triggering the anchor tag
                        event.preventDefault();
                        event.stopPropagation();

                        try {
                            // Replace '/cart/add' with your actual backend route if different
                            const response = await fetch('/cart/add', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json'
                                },
                                body: JSON.stringify({ productId: productId, quantity: 1 })
                            });

                            const data = await response.json();

                            if (response.ok) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Added to Cart',
                                    text: 'Product successfully added to your cart!',
                                    timer: 1500,
                                    showConfirmButton: false
                                });
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Oops...',
                                    text: data.message || 'Please log in to add items to cart'
                                });
                            }
                        } catch (error) {
                            console.error("Cart Error:", error);
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: 'Something went wrong!'
                            });
                        }
                    }

                    // 2. ADD TO WISHLIST FUNCTION
                    async function addToWishlist(event, productId) {
                        event.preventDefault();
                        event.stopPropagation();

                        // Find the specific button that was clicked to animate it later
                        const button = event.currentTarget;

                        try {
                            // Replace '/wishlist/add' with your actual backend route if different
                            const response = await fetch('/wishlist/add', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json'
                                },
                                body: JSON.stringify({ productId: productId })
                            });

                            const data = await response.json();

                            if (response.ok) {
                                // Optionally turn the heart Red
                                button.classList.add('active');
                                button.style.color = '#EF4444'; // Tailwind Red-500

                                Swal.fire({
                                    icon: 'success',
                                    title: 'Added to Wishlist',
                                    text: 'Product successfully saved for later!',
                                    timer: 1500,
                                    showConfirmButton: false,
                                    toast: true,           // Small popup in the corner
                                    position: 'top-end'    // Top right position
                                });
                            } else {
                                Swal.fire({
                                    icon: 'warning',
                                    title: 'Notice',
                                    text: data.message || 'Please log in to add items'
                                });
                            }
                        } catch (error) {
                            console.error("Wishlist Error:", error);
                        }
                    }
                </script>
    </body>

</html>