                <script>
                    lucide.createIcons();

                    /* ╔═══════════════════════════════════════════╗
                       ║  3-SCENE SCROLL-DRIVEN HERO ANIMATION     ║
                       ║  Scene 1: 186 PNG frames (watch1)         ║
                       ║  Scene 2: 192 PNG frames (watch2)         ║
                       ║  Scene 3: 192 PNG frames (watch3)         ║
                       ╚═══════════════════════════════════════════╝ */
                    (function () {
                        'use strict';

                        // ── DOM refs ──────────────────────────────────
                        const section   = document.getElementById('watchScrollSection');
                        const canvas    = document.getElementById('watchCanvas');
                        const panel1    = document.getElementById('textPanel1');
                        const panel2    = document.getElementById('textPanel2');
                        const panel3    = document.getElementById('textPanel3');
                        const specsWrap = document.getElementById('heroSpecsWrap');
                        const specAVal  = document.getElementById('specAVal');
                        const specALbl  = document.getElementById('specALbl');
                        const specBVal  = document.getElementById('specBVal');
                        const specBLbl  = document.getElementById('specBLbl');
                        const specCVal  = document.getElementById('specCVal');
                        const specCLbl  = document.getElementById('specCLbl');
                        const progBar   = document.getElementById('scrollProgressBar');
                        const hint      = document.getElementById('scrollHint');
                        const sceneBg   = document.getElementById('sceneBg');
                        const sceneLabel = document.getElementById('sceneLabel');
                        const dots      = [document.getElementById('dot0'),
                                           document.getElementById('dot1'),
                                           document.getElementById('dot2')];

                        // ── Config ───────────────────────────────────
                        // Scene scroll boundaries (0–1)
                        const S1_END = 0.38;   // Scene 1 occupies 0 → 38%
                        const S2_END = 0.70;   // Scene 2 occupies 38% → 70%
                        // Scene 3: 70% → 100%

                        const SPECS = [
                            { a:['100M','Water Resist'], b:['14d','Battery Life'],  c:['MIL','Grade 810H'] },
                            { a:['50M', 'Water Resist'], b:['18h','Battery Life'],  c:['ECG','+ Blood O₂'] },
                            { a:['5ATM','Water Resist'], b:['7d', 'Battery Life'],  c:['GPS','Multi-Band']  }
                        ];
                        const LABELS = [
                            'Trufit · Rugged Series',
                            'Trufit · Premium Series',
                            'Trufit · Fitness Pro'
                        ];
                        const BG_COLORS = [
                            'radial-gradient(ellipse at 50% 60%, #0a1628 0%, #04080f 55%, #000 100%)',
                            'radial-gradient(ellipse at 40% 55%, #13082a 0%, #060411 55%, #000 100%)',
                            'radial-gradient(ellipse at 60% 50%, #031a10 0%, #030b08 55%, #000 100%)'
                        ];

                        const scenesConfig = [
                            {
                                path: '/public/banner/watch1/ezgif-frame-',
                                total: 186,
                                images: []
                            },
                            {
                                path: '/public/banner/watch2/ezgif-frame-',
                                total: 192,
                                images: []
                            },
                            {
                                path: '/public/banner/watch3/ezgif-frame-',
                                total: 192,
                                images: []
                            }
                        ];

                        // Initialize image objects for all scenes
                        scenesConfig.forEach(scene => {
                            for (let i = 1; i <= scene.total; i++) {
                                const img = new Image();
                                scene.images.push(img);
                            }
                        });

                        function getFrameUrl(sceneIdx, frameNum) {
                            const config = scenesConfig[sceneIdx];
                            return config.path + String(frameNum).padStart(3, '0') + '.png';
                        }

                        // ── Progressive Loading ──────────────────────
                        // Phase 1: Load first frame of each scene immediately
                        scenesConfig.forEach((scene, sceneIdx) => {
                            const img = scene.images[0];
                            img.onload = () => {
                                if (sceneIdx === 0) {
                                    renderActiveFrame();
                                }
                            };
                            img.src = getFrameUrl(sceneIdx, 1);
                        });

                        // Phase 2 & 3 loading triggered after page loads
                        window.addEventListener('load', () => {
                            setTimeout(() => {
                                loadKeyframes();
                            }, 200);
                        });

                        // Load every 5th frame for low-res preview scroll coverage
                        function loadKeyframes() {
                            let loadedCount = 0;
                            let totalKeyframes = 0;
                            
                            scenesConfig.forEach((scene, sceneIdx) => {
                                for (let i = 1; i <= scene.total; i += 5) {
                                    if (i === 1) continue; // Already loaded in Phase 1
                                    totalKeyframes++;
                                    const img = scene.images[i - 1];
                                    img.onload = () => {
                                        loadedCount++;
                                        if (loadedCount === totalKeyframes) {
                                            // Keyframes loaded, start loading remaining frames
                                            loadRemainingFrames();
                                        }
                                    };
                                    img.src = getFrameUrl(sceneIdx, i);
                                }
                            });
                            
                            if (totalKeyframes === 0) {
                                loadRemainingFrames();
                            }
                        }

                        // Load all remaining frames
                        function loadRemainingFrames() {
                            scenesConfig.forEach((scene, sceneIdx) => {
                                for (let i = 1; i <= scene.total; i++) {
                                    const img = scene.images[i - 1];
                                    if (!img.src) {
                                        img.src = getFrameUrl(sceneIdx, i);
                                    }
                                }
                            });
                        }

                        // ── State ────────────────────────────────────
                        let curPct = 0; // Current scroll percent (lerped)
                        let tgtPct = 0; // Target scroll percent (raw)
                        let rafId = null;
                        let lastScene = -1;
                        let sectionTop = 0;
                        let sectionHeight = 0;

                        function updateDimensions() {
                            const rect = section.getBoundingClientRect();
                            sectionTop = rect.top + window.scrollY;
                            sectionHeight = section.offsetHeight;
                        }

                        // ── Helpers ──────────────────────────────────
                        function lerp(a, b, t) { return a + (b - a) * t; }
                        function clamp(v, lo, hi) { return Math.max(lo, Math.min(hi, v)); }
                        function range(t, a, b) { return clamp((t - a) / (b - a), 0, 1); }

                        function updateTextPanelDirect(panel, sp) {
                            let opacity = 0;
                            let translateY = 50; // start 50px below

                            if (sp < 0.15) {
                                // Entering
                                const t = range(sp, 0.0, 0.15);
                                opacity = t;
                                translateY = lerp(50, 0, t);
                            } else if (sp <= 0.80) {
                                // Active
                                opacity = 1;
                                translateY = 0;
                            } else if (sp < 0.95) {
                                // Exiting
                                const t = range(sp, 0.80, 0.95);
                                opacity = 1 - t;
                                translateY = lerp(0, -50, t);
                            } else {
                                // Fully exited
                                opacity = 0;
                                translateY = -50;
                            }

                            panel.style.opacity = opacity;
                            panel.style.transform = `translateY(${translateY}px)`;
                            panel.style.pointerEvents = opacity > 0.1 ? 'all' : 'none';
                        }

                        function drawFrame(img) {
                            if (!img) return;
                            const ctx = canvas.getContext('2d');
                            const cw = canvas.width;
                            const ch = canvas.height;

                            // Reset transform so we draw in physical pixel coordinates
                            ctx.setTransform(1, 0, 0, 1, 0, 0);

                            ctx.clearRect(0, 0, cw, ch);

                            const iw = img.naturalWidth || img.width;
                            const ih = img.naturalHeight || img.height;
                            if (!iw || !ih) return;

                            const aspect = iw / ih;
                            let dw = cw;
                            let dh = ch;
                            let dx = 0;
                            let dy = 0;

                            // Cover aspect ratio scaling (Full Width & Height, cropped to fit)
                            if (cw / ch > aspect) {
                                dw = cw;
                                dh = cw / aspect;
                                dy = (ch - dh) / 2;
                            } else {
                                dw = ch * aspect;
                                dh = ch;
                                dx = (cw - dw) / 2;
                            }

                            ctx.drawImage(img, dx, dy, dw, dh);
                        }

                        function renderActiveFrame() {
                            let sceneIdx = 0;
                            let localPct = 0;

                            if (curPct <= S1_END) {
                                sceneIdx = 0;
                                localPct = range(curPct, 0, S1_END);
                            } else if (curPct <= S2_END) {
                                sceneIdx = 1;
                                localPct = range(curPct, S1_END, S2_END);
                            } else {
                                sceneIdx = 2;
                                localPct = range(curPct, S2_END, 1.0);
                            }

                            // ── Render watch frame on canvas ───────────
                            const scene = scenesConfig[sceneIdx];
                            const totalFrames = scene.total;
                            const targetIdx = clamp(Math.round(localPct * (totalFrames - 1)), 0, totalFrames - 1);

                            let img = scene.images[targetIdx];
                            if (!img.complete || img.naturalWidth === 0) {
                                let found = false;
                                for (let offset = 1; offset < totalFrames; offset++) {
                                    const prevIdx = targetIdx - offset;
                                    const nextIdx = targetIdx + offset;

                                    if (prevIdx >= 0 && scene.images[prevIdx].complete && scene.images[prevIdx].naturalWidth > 0) {
                                        img = scene.images[prevIdx];
                                        found = true;
                                        break;
                                    }
                                    if (nextIdx < totalFrames && scene.images[nextIdx].complete && scene.images[nextIdx].naturalWidth > 0) {
                                        img = scene.images[nextIdx];
                                        found = true;
                                        break;
                                    }
                                }
                                if (!found) {
                                    img = scene.images[0];
                                }
                            }

                            drawFrame(img);

                            // ── Update active text panel ───────────────
                            updateTextPanelDirect(panel1, sceneIdx === 0 ? localPct : (sceneIdx < 0 ? 0 : 1));
                            updateTextPanelDirect(panel2, sceneIdx === 1 ? localPct : (sceneIdx < 1 ? 0 : 1));
                            updateTextPanelDirect(panel3, sceneIdx === 2 ? localPct : (sceneIdx < 2 ? 0 : 1));

                            // ── Update specs and details ───────────────
                            updateTextPanelDirect(specsWrap, localPct);

                            // ── Update scene indicators and background ──
                            if (lastScene !== sceneIdx) {
                                lastScene = sceneIdx;
                                dots.forEach((d, i) => d.classList.toggle('active', i === sceneIdx));
                                applySpecs(sceneIdx);
                                sceneBg.style.background = BG_COLORS[sceneIdx];
                                sceneLabel.textContent = LABELS[sceneIdx];
                            }
                        }

                        function applySpecs(sceneIdx) {
                            const s = SPECS[sceneIdx];
                            specAVal.textContent = s.a[0]; specALbl.textContent = s.a[1];
                            specBVal.textContent = s.b[0]; specBLbl.textContent = s.b[1];
                            specCVal.textContent = s.c[0]; specCLbl.textContent = s.c[1];
                        }

                        // ── Canvas Resizer ───────────────────────────
                        function resizeCanvas() {
                            const dpr = window.devicePixelRatio || 1;
                            const w   = window.innerWidth;
                            const h   = window.innerHeight;
                            canvas.style.width  = w + 'px';
                            canvas.style.height = h + 'px';
                            canvas.width  = w * dpr;
                            canvas.height = h * dpr;
                            
                            updateDimensions();
                            
                            renderActiveFrame();
                        }

                        // ── Scroll handler ───────────────────────────
                        function onScroll() {
                            const vH     = window.innerHeight;
                            const pct    = clamp((window.scrollY - sectionTop) / (sectionHeight - vH), 0, 1);

                            // Progress bar
                            progBar.style.width = (pct * 100) + '%';

                            // Scroll hint
                            hint.style.opacity = pct > 0.025 ? '0' : '1';

                            tgtPct = pct;
                            if (!rafId) {
                                rafId = requestAnimationFrame(animateLoop);
                            }
                        }

                        // ── Inertia/Lerp Animation Loop ──────────────
                        function animateLoop() {
                            const diff = tgtPct - curPct;
                            if (Math.abs(diff) > 0.0002) {
                                curPct = lerp(curPct, tgtPct, 0.07); // smooth damping (0.07 for high-end inertia feel)
                                renderActiveFrame();
                                rafId = requestAnimationFrame(animateLoop);
                            } else {
                                curPct = tgtPct;
                                renderActiveFrame();
                                rafId = null;
                            }
                        }

                        window.addEventListener('scroll', onScroll, { passive: true });
                        window.addEventListener('resize', resizeCanvas);

                        // Initial setup
                        resizeCanvas();
                        onScroll();

                    })();

                    /* ── FLOATING PARTICLES ──────────────────────── */
                    (function () {
                        const c = document.getElementById('watchParticles');
                        if (!c) return;
                        for (let i = 0; i < 32; i++) {
                            const p = document.createElement('div');
                            p.className = 'particle';
                            const sz = Math.random() * 4 + 1.5;
                            p.style.cssText = [
                                'width:'  + sz + 'px',
                                'height:' + sz + 'px',
                                'left:'   + (Math.random() * 100) + '%',
                                'animation-duration:' + (Math.random() * 14 + 9) + 's',
                                'animation-delay:'    + (Math.random() * 14) + 's',
                                'opacity:' + (Math.random() * 0.5 + 0.15),
                                'background:rgba(' + (100 + Math.round(Math.random()*60)) + ',' +
                                                     (170 + Math.round(Math.random()*50)) + ',255,0.5)'
                            ].join(';');
                            c.appendChild(p);
                        }
                    })();

                    /* ╔═══════════════════════════════════════════════════════╗
                       ║  SCROLL-TRIGGERED SECTION ANIMATIONS                  ║
                       ║  Uses IntersectionObserver to fire CSS class toggles   ║
                       ╚═══════════════════════════════════════════════════════╝ */
                    (function () {
                        'use strict';

                        // Selectors: any element that should animate on scroll
                        const animSelectors = [
                            '.anim-fade-up',
                            '.anim-slide-left',
                            '.anim-slide-right',
                            '.anim-scale-in',
                            '.section-title-reveal'
                        ];

                        const allAnimEls = document.querySelectorAll(animSelectors.join(','));

                        if (!allAnimEls.length) return;

                        const observer = new IntersectionObserver(
                            (entries) => {
                                entries.forEach(entry => {
                                    if (entry.isIntersecting) {
                                        entry.target.classList.add('is-visible');
                                        // Stop observing once revealed (one-shot)
                                        observer.unobserve(entry.target);
                                    }
                                });
                            },
                            {
                                root: null,          // viewport
                                threshold: 0.12,     // 12% of the element must be visible
                                rootMargin: '0px 0px -40px 0px'  // trigger 40px before bottom of viewport
                            }
                        );

                        allAnimEls.forEach(el => observer.observe(el));

                        // Also observe section-title-reveal elements separately with a lower threshold
                        document.querySelectorAll('.section-title-reveal').forEach(el => {
                            // Already observed above but ensure they get picked up
                            if (!el.classList.contains('is-visible')) {
                                observer.observe(el);
                            }
                        });
                    })();

                    // 1. ADD TO CART FUNCTION
                    async function addToCart(event, productId) {
                        // Stop the click from triggering the anchor tag
                        event.preventDefault();
                        event.stopPropagation();

                        try {
                            // Replace '/cart/add' with your actual backend route if different
                            const response = await fetch('/cart/add', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json'
                                },
                                body: JSON.stringify({ productId: productId, quantity: 1 })
                            });

                            const data = await response.json();

                            if (response.ok) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Added to Cart',
                                    text: 'Product successfully added to your cart!',
                                    timer: 1500,
                                    showConfirmButton: false
                                });
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Oops...',
                                    text: data.message || 'Please log in to add items to cart'
                                });
                            }
                        } catch (error) {
                            console.error("Cart Error:", error);
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: 'Something went wrong!'
                            });
                        }
                    }

                    // 2. ADD TO WISHLIST FUNCTION
                    async function addToWishlist(event, productId) {
                        event.preventDefault();
                        event.stopPropagation();

                        // Find the specific button that was clicked to animate it later
                        const button = event.currentTarget;

                        try {
                            // Replace '/wishlist/add' with your actual backend route if different
                            const response = await fetch('/wishlist/add', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json'
                                },
                                body: JSON.stringify({ productId: productId })
                            });

                            const data = await response.json();

                            if (response.ok) {
                                // Optionally turn the heart Red
                                button.classList.add('active');
                                button.style.color = '#EF4444'; // Tailwind Red-500

                                Swal.fire({
                                    icon: 'success',
                                    title: 'Added to Wishlist',
                                    text: 'Product successfully saved for later!',
                                    timer: 1500,
                                    showConfirmButton: false,
                                    toast: true,           // Small popup in the corner
                                    position: 'top-end'    // Top right position
                                });
                            } else {
                                Swal.fire({
                                    icon: 'warning',
                                    title: 'Notice',
                                    text: data.message || 'Please log in to add items'
                                });
                            }
                        } catch (error) {
                            console.error("Wishlist Error:", error);
                        }
                    }
                </script>
    </body>

</html>