<!DOCTYPE html>
<html lang="en">

<%- include('partials/head') %>
    <style>
        /* Cart Content */
        .cart-page {
            padding: 60px 0;
        }

        .cart-title {
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 40px;
            text-transform: uppercase;
            text-decoration: underline;
            text-underline-offset: 8px;
            text-decoration-thickness: 3px;
        }

        .cart-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 40px;
        }

        .cart-table th {
            text-align: left;
            padding: 15px 10px;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 1px;
            border-bottom: 1px solid #EEE;
            background: #F9FAFB;
            color: #6B7280;
            font-weight: 600;
        }

        .cart-table td {
            padding: 30px 10px;
            border-bottom: 1px solid #F3F4F6;
            vertical-align: middle;
        }

        .product-cell {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .product-img {
            width: 100px;
            height: 100px;
            background: #F8F8F8;
            border-radius: 12px;
            padding: 10px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .product-img img {
            max-height: 100%;
            object-fit: contain;
        }

        .product-name {
            font-size: 16px;
            font-weight: 600;
        }

        .size-text {
            font-size: 14px;
            color: #4B5563;
        }

        .price-text,
        .total-text {
            font-size: 14px;
            font-weight: 600;
        }

        /* Quantity Selector */
        .qty-selector {
            display: flex;
            align-items: center;
            gap: 15px;
            background: #F9FAFB;
            padding: 5px 15px;
            border-radius: 4px;
            width: fit-content;
        }

        .qty-btn {
            background: none;
            border: none;
            font-size: 18px;
            cursor: pointer;
            color: #9CA3AF;
        }

        .qty-input {
            width: 30px;
            text-align: center;
            border: none;
            background: transparent;
            font-weight: 600;
            font-size: 14px;
        }

        .btn-remove {
            background: #EF4444;
            color: #FFF;
            padding: 8px 24px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
            border: none;
            cursor: pointer;
            transition: var(--transition);
        }

        .cart-footer {
            display: flex;
            justify-content: flex-end;
            padding-top: 20px;
        }

        .btn-checkout {
            background: #F97316;
            color: #000;
            padding: 15px 35px;
            border-radius: 30px;
            font-size: 18px;
            font-weight: 700;
            border: none;
            cursor: pointer;
            transition: var(--transition);
        }

        .btn:hover {
            transform: translateY(-2px);
            opacity: 0.95;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        }

        .stock-warning {
            color: #EF4444;
            font-size: 12px;
            margin-top: 5px;
            font-weight: 600;
        }

        .item-out-of-stock {
            opacity: 0.6;
            background-color: #FEF2F2;
        }

        .qty-btn:disabled {
            cursor: not-allowed;
            opacity: 0.3;
        }

        /* Footer */
        .footer {
            padding: 80px 0 40px;
            border-top: 1px solid #EEE;
            background: #FFFFFF;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr 1fr;
            gap: 40px;
            margin-bottom: 60px;
        }

        .footer-col-logo {
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .logo-box {
            background: #11362F;
            /* Dark green as in mockup */
            width: 100px;
            height: 100px;
            border-radius: 20px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            color: #FFFFFF;
        }

        .logo-box i {
            width: 40px;
            height: 40px;
        }

        .logo-box span {
            font-size: 14px;
            font-weight: 700;
            margin-top: 5px;
        }

        .footer-col ul li {
            margin-bottom: 15px;
        }

        .footer-col ul li a {
            color: #6B7280;
            font-size: 14px;
        }

        .footer-col ul li a:hover {
            color: #000;
        }

        .social-info {
            color: #6B7280;
            font-size: 14px;
        }

        .social-info p {
            margin-bottom: 12px;
        }

        .copyright {
            padding: 30px 0;
            background: #000;
            color: #FFF;
            text-align: center;
            font-size: 14px;
        }

        /* Responsive */
        @media (max-width: 900px) {
            .cart-table thead {
                display: none;
            }

            .cart-table tr {
                display: block;
                padding: 20px 0;
                border-bottom: 1px solid #EEE;
            }

            .cart-table td {
                display: flex;
                justify-content: space-between;
                padding: 10px 0;
                border: none;
            }

            .product-cell {
                justify-content: center;
                margin-bottom: 15px;
            }

            .header-left .search-bar {
                display: none;
            }

            .footer-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
    </head>

    <body>
        <%- include('partials/header') %>

            <main class="container">
                <!-- Cart Content -->
                <section class="cart-page">
                    <h1 class="cart-title">YOUR CART</h1>

                    <!-- Error banner from checkout validation -->
                    <div id="cart-error-banner" style="display:none; background:#FEF2F2; border:1px solid #FECACA; color:#991B1B; padding:14px 20px; border-radius:8px; margin-bottom:20px; font-size:14px; font-weight:500;"></div>

                    <table class="cart-table">
                        <thead>
                            <tr>
                                <th style="width: 40%;">Product</th>
                                <th>Size</th>
                                <th>Price</th>
                                <th>Quantity</th>
                                <th>Total</th>
                                <th>ACTION</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% let cartTotal = 0; %>
                            <% if (typeof cart !== 'undefined' && cart && cart.items && cart.items.length > 0) { %>
                                <% cart.items.forEach(item => { %>
                                    <% let currentPrice = (item.productId.offerPrice && item.productId.offerPrice < item.productId.price) ? item.productId.offerPrice : item.productId.price; %>
                                    <% let itemTotal = currentPrice * item.quantity; %>
                                    <% cartTotal += itemTotal; %>
                                    <% 
                                        let stock = item.variantId ? item.variantId.quantity : item.productId.quantity;
                                        let isOutOfStock = stock < item.quantity;
                                        let totalStock = stock;
                                    %>
                                    <tr class="<%= isOutOfStock ? 'item-out-of-stock' : '' %>">
                                        <td>
                                            <div class="product-cell">
                                                <div class="product-img">
                                                    <% if (item.variantId && item.variantId.image && item.variantId.image.length > 0) { %>
                                                        <img src="<%= item.variantId.image[0] %>" alt="<%= item.productId.name %>">
                                                    <% } else if (item.productId.image && item.productId.image.length > 0) { %>
                                                        <img src="<%= item.productId.image[0] %>" alt="<%= item.productId.name %>">
                                                    <% } else { %>
                                                        <img src="/public/placeholder.png" alt="No image">
                                                    <% } %>
                                                </div>
                                                <div>
                                                    <span class="product-name"><%= item.productId.name %></span>
                                                    <% if (isOutOfStock) { %>
                                                        <div class="stock-warning">Insufficient stock (Available: <%= totalStock %>)</div>
                                                    <% } %>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="size-text">
                                                <%= item.variantId ? item.variantId.size : '-' %>
                                                <%= item.variantId ? ' / ' + item.variantId.color : '' %>
                                            </span>
                                        </td>
                                        <td><span class="price-text">₹<%= currentPrice.toLocaleString() %></span></td>
                                        <td>
                                            <div class="qty-selector">
                                                <button class="qty-btn update-qty" data-id="<%= item.productId ? item.productId._id : '' %>" data-qty="<%= item.quantity - 1 %>" <%= (item.quantity <= 1) ? "disabled" : "" %>>-</button>
                                                <input type="text" value="<%= item.quantity %>" class="qty-input" readonly>
                                                <button class="qty-btn update-qty" data-id="<%= item.productId ? item.productId._id : '' %>" data-qty="<%= item.quantity + 1 %>" <%= (item.quantity >= 5 || item.quantity >= totalStock) ? "disabled" : "" %>>+</button>
                                            </div>
                                            <% if (item.quantity >= 5) { %>
                                                <div style="font-size: 10px; color: #6B7280; margin-top: 5px;">Max limit reached</div>
                                            <% } %>
                                        </td>
                                        <td><span class="total-text">₹<%= itemTotal.toLocaleString() %></span></td>
                                        <td>
                                            <button class="btn btn-remove remove-item" data-id="<%= item.productId ? item.productId._id : '' %>">Remove</button>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr>
                                    <td colspan="6" style="text-align: center; padding: 50px 0;">
                                        <p style="color: #6B7280; font-size: 18px; margin-bottom: 20px;">Your cart is currently empty.</p>
                                        <a href="/shop" class="btn btn-checkout">Continue Shopping</a>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>

                    <% if (typeof cart !== 'undefined' && cart && cart.items && cart.items.length > 0) { %>
                    <div style="display: flex; justify-content: flex-end; gap: 40px; align-items: start;">
                        <!-- Summary Section -->
                        <div class="cart-footer" style="width: 350px; flex-direction: column; align-items: stretch; gap: 15px; background: #FFF; padding: 25px; border-radius: 12px; border: 1px solid #EEE;">
                            <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
                                <span style="color: #6B7280;">Subtotal</span>
                                <span style="font-weight: 600;" id="cart-subtotal">₹<%= cartTotal %></span>
                            </div>

                            <div style="height: 1px; background: #EEE; margin: 10px 0;"></div>
                            
                            <div style="display: flex; justify-content: space-between; margin-bottom: 20px;">
                                <span style="font-size: 18px; font-weight: 700;">Grand Total</span>
                                <span style="font-size: 18px; font-weight: 700;" id="cart-total">₹<%= cartTotal.toLocaleString() %></span>
                            </div>
                            
                            <a href="/checkout" class="btn-checkout" id="checkout-btn" style="text-align: center; text-decoration: none;">PROCEED TO CHECKOUT</a>
                        </div>
                    </div>
                    <% } %>
                </section>
                
                <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
                <script>
                    // Event delegation for Cart actions
                    document.addEventListener('click', (e) => {
                        if (e.target.classList.contains('update-qty')) {
                            const id = e.target.dataset.id;
                            const qty = parseInt(e.target.dataset.qty);
                            if (id && !isNaN(qty)) updateQuantity(id, qty);
                        } else if (e.target.classList.contains('remove-item')) {
                            const id = e.target.dataset.id;
                            if (id) removeFromCart(id);
                        }
                    });

                    async function updateQuantity(productId, newQty) {
                        if (newQty < 1 || newQty > 5) return;
                        
                        if (window.TrufitLoader) window.TrufitLoader.show();
                        try {
                            const response = await fetch(`/cart/update/${productId}`, {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ quantity: newQty })
                            });
                            
                            const data = await response.json();
                            if (response.ok) {
                                location.reload();
                            } else {
                                if (window.TrufitLoader) window.TrufitLoader.hide();
                                Swal.fire('Error', data.message || 'Failed to update quantity', 'error');
                            }
                        } catch (error) {
                            if (window.TrufitLoader) window.TrufitLoader.hide();
                            Swal.fire('Error', 'Something went wrong', 'error');
                        }
                    }

                    async function removeFromCart(productId) {
                        const result = await Swal.fire({
                            title: 'Remove item?',
                            text: 'Are you sure you want to remove this item from your cart?',
                            icon: 'warning',
                            showCancelButton: true,
                            confirmButtonColor: '#EF4444',
                            confirmButtonText: 'Yes, remove it!'
                        });

                        if (!result.isConfirmed) return;

                        try {
                            const response = await fetch(`/cart/remove/${productId}`, { method: 'POST' });
                            if (response.ok) {
                                // Remove the row from the DOM
                                const row = document.querySelector(`button.remove-item[data-id="${productId}"]`)?.closest('tr');
                                if (row) {
                                    row.style.transition = 'opacity 0.3s ease';
                                    row.style.opacity = '0';
                                    setTimeout(() => {
                                        row.remove();
                                        refreshCartTotals();
                                    }, 300);
                                }
                                if (typeof updateHeaderCounts === 'function') updateHeaderCounts();
                            } else {
                                Swal.fire('Error', 'Could not remove item', 'error');
                            }
                        } catch (error) {
                            Swal.fire('Error', 'Failed to remove item', 'error');
                        }
                    }

                    function refreshCartTotals() {
                        const rows = document.querySelectorAll('.cart-table tbody tr:not([style*="opacity: 0"])');
                        let total = 0;
                        rows.forEach(row => {
                            const totalCell = row.querySelector('.total-text');
                            if (totalCell) {
                                const val = parseInt(totalCell.textContent.replace(/[^0-9]/g, ''));
                                if (!isNaN(val)) total += val;
                            }
                        });

                        const subtotalEl = document.getElementById('cart-subtotal');
                        const totalEl = document.getElementById('cart-total');
                        const summarySection = document.querySelector('.cart-footer')?.parentElement;

                        const activeRows = document.querySelectorAll('.cart-table tbody tr');
                        const hasItems = Array.from(activeRows).some(r => r.querySelector('.remove-item'));

                        if (!hasItems) {
                            // Show empty state
                            document.querySelector('.cart-table tbody').innerHTML = `
                                <tr>
                                    <td colspan="6" style="text-align: center; padding: 50px 0;">
                                        <p style="color: #6B7280; font-size: 18px; margin-bottom: 20px;">Your cart is currently empty.</p>
                                        <a href="/shop" class="btn btn-checkout">Continue Shopping</a>
                                    </td>
                                </tr>`;
                            if (summarySection) summarySection.style.display = 'none';
                            return;
                        }

                        if (subtotalEl) subtotalEl.textContent = '₹' + total.toLocaleString();
                        if (totalEl) totalEl.textContent = '₹' + total.toLocaleString();
                    }

                    // Coupon functions temporarily removed
                </script>
                </section>
            </main>

            <footer class="footer">
                <div class="copyright">
                    Copyright @ 2022 | Trufit
                </div>
            </footer>

            <script>
                lucide.createIcons();

                // Show error from query param (e.g. checkout validation redirect)
                (function() {
                    const params = new URLSearchParams(window.location.search);
                    const err = params.get('error');
                    const banner = document.getElementById('cart-error-banner');
                    if (err && banner) {
                        banner.textContent = err;
                        banner.style.display = 'block';
                        setTimeout(() => { banner.style.display = 'none'; }, 6000);
                    }
                })();
            </script>
    </body>

</html>
