<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <style>
        :root {
            --error-accent: #3B82F6;
            --card-bg: #FFFFFF;
        }

        body {
            background-color: #F9FAFB;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            margin: 0;
            font-family: 'Outfit', sans-serif;
            color: #111827;
        }

        /* Minimal Clean Header */
        .minimal-header {
            padding: 20px 40px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .minimal-header .brand-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 22px;
            font-weight: 700;
            color: #000000;
            text-decoration: none;
            letter-spacing: -0.5px;
        }

        .minimal-header .brand-logo i {
            width: 24px;
            height: 24px;
            stroke-width: 2.2;
        }

        .minimal-header .nav-back-link {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 14px;
            font-weight: 600;
            color: #4B5563;
            text-decoration: none;
            padding: 8px 16px;
            border-radius: 30px;
            background: #F3F4F6;
            transition: all 0.2s ease;
        }

        .minimal-header .nav-back-link:hover {
            background: #E5E7EB;
            color: #111827;
            transform: translateY(-1px);
        }

        /* Error Container */
        .error-wrapper {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 60px 20px;
            position: relative;
            overflow: hidden;
        }

        /* Ambient Background Elements */
        .ambient-glow {
            position: absolute;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(59, 130, 246, 0.08) 0%, rgba(255, 255, 255, 0) 70%);
            border-radius: 50%;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            pointer-events: none;
            z-index: 0;
        }

        .ambient-glow-2 {
            position: absolute;
            width: 350px;
            height: 350px;
            background: radial-gradient(circle, rgba(16, 185, 129, 0.06) 0%, rgba(255, 255, 255, 0) 70%);
            border-radius: 50%;
            top: 40%;
            left: 45%;
            transform: translate(-50%, -50%);
            pointer-events: none;
            z-index: 0;
        }

        .error-card {
            position: relative;
            z-index: 1;
            background: var(--card-bg);
            border-radius: 24px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.06), 0 1px 3px rgba(0, 0, 0, 0.04);
            border: 1px solid rgba(0, 0, 0, 0.06);
            max-width: 580px;
            width: 100%;
            padding: 50px 40px;
            text-align: center;
            backdrop-filter: blur(10px);
        }

        /* Smartwatch Visual Graphic */
        .watch-visual {
            position: relative;
            width: 110px;
            height: 110px;
            margin: 0 auto 28px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: linear-gradient(135deg, #111827 0%, #1F2937 100%);
            color: #FFFFFF;
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.15), 0 0 0 10px rgba(59, 130, 246, 0.08);
            animation: floatAnimation 4s ease-in-out infinite;
        }

        @keyframes floatAnimation {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-8px); }
        }

        .watch-visual i {
            width: 52px;
            height: 52px;
            stroke-width: 1.5;
            color: #60A5FA;
        }

        .time-badge {
            position: absolute;
            bottom: -6px;
            background: #EF4444;
            color: #FFFFFF;
            font-size: 11px;
            font-weight: 700;
            padding: 3px 10px;
            border-radius: 12px;
            letter-spacing: 0.5px;
            box-shadow: 0 4px 10px rgba(239, 68, 68, 0.3);
        }

        .error-code-badge {
            display: inline-block;
            font-size: 76px;
            font-weight: 800;
            line-height: 1;
            background: linear-gradient(135deg, #111827 0%, #3B82F6 100%);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 12px;
            letter-spacing: -2px;
        }

        .error-title {
            font-size: 26px;
            font-weight: 700;
            color: #111827;
            margin-bottom: 12px;
            letter-spacing: -0.3px;
        }

        .error-description {
            font-size: 15px;
            color: #6B7280;
            line-height: 1.6;
            margin-bottom: 30px;
            max-width: 460px;
            margin-left: auto;
            margin-right: auto;
        }

        /* Search Box in Card */
        .error-search-form {
            display: flex;
            align-items: center;
            background: #F3F4F6;
            border: 1px solid #E5E7EB;
            border-radius: 16px;
            padding: 6px 6px 6px 16px;
            margin-bottom: 30px;
            transition: all 0.2s ease;
        }

        .error-search-form:focus-within {
            background: #FFFFFF;
            border-color: #3B82F6;
            box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.12);
        }

        .error-search-form input {
            border: none;
            background: transparent;
            outline: none;
            flex: 1;
            font-size: 14px;
            font-family: inherit;
            color: #111827;
        }

        .error-search-form button {
            border: none;
            background: #111827;
            color: #FFFFFF;
            border-radius: 12px;
            padding: 10px 16px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            font-weight: 600;
            transition: background 0.2s ease;
        }

        .error-search-form button:hover {
            background: #1F2937;
        }

        /* Actions Group */
        .actions-group {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .btn-action {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 13px 24px;
            border-radius: 14px;
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.25s ease;
            cursor: pointer;
            border: none;
        }

        .btn-action i {
            width: 18px;
            height: 18px;
        }

        .btn-primary-action {
            background: #111827;
            color: #FFFFFF;
            box-shadow: 0 4px 14px rgba(17, 24, 39, 0.15);
        }

        .btn-primary-action:hover {
            background: #1F2937;
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(17, 24, 39, 0.25);
            color: #FFFFFF;
        }

        .btn-secondary-action {
            background: #F3F4F6;
            color: #374151;
            border: 1px solid #E5E7EB;
        }

        .btn-secondary-action:hover {
            background: #E5E7EB;
            color: #111827;
            transform: translateY(-2px);
        }

        .btn-ghost-action {
            background: transparent;
            color: #6B7280;
        }

        .btn-ghost-action:hover {
            color: #111827;
            background: #F3F4F6;
        }

        /* Minimal Clean Footer */
        .minimal-footer {
            padding: 24px 40px;
            text-align: center;
            border-top: 1px solid rgba(0, 0, 0, 0.05);
            background: #FFFFFF;
            font-size: 13px;
            color: #6B7280;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
        }

        .minimal-footer .footer-copy {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .minimal-footer .footer-links {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .minimal-footer .footer-links a {
            color: #6B7280;
            text-decoration: none;
            transition: color 0.2s ease;
        }

        .minimal-footer .footer-links a:hover {
            color: #111827;
        }

        @media (max-width: 640px) {
            .minimal-header {
                padding: 16px 20px;
            }
            .error-card {
                padding: 36px 24px;
                border-radius: 20px;
            }
            .actions-group {
                flex-direction: column;
                width: 100%;
            }
            .btn-action {
                width: 100%;
            }
            .minimal-footer {
                flex-direction: column;
                justify-content: center;
                gap: 8px;
                padding: 20px;
            }
        }
    </style>
</head>
<body>
    <%- include('partials/loader') %>

    <!-- Minimal Clean Header -->
    <header class="minimal-header">
        <a href="/" class="brand-logo">
            <i data-lucide="watch"></i>
            Trufit
        </a>
        <a href="/" class="nav-back-link">
            <i data-lucide="home" style="width: 16px; height: 16px;"></i>
            Homepage
        </a>
    </header>

    <!-- Main 404 Error Content -->
    <main class="error-wrapper">
        <div class="ambient-glow"></div>
        <div class="ambient-glow-2"></div>

        <div class="error-card">
            <!-- Smartwatch Icon Graphic -->
            <div class="watch-visual">
                <i data-lucide="watch"></i>
                <div class="time-badge">404 OUT OF SYNC</div>
            </div>

            <div class="error-code-badge">404</div>
            <h1 class="error-title">Oops! Page Out of Sync</h1>
            <p class="error-message error-description">
                The page you are looking for might have been moved, renamed, or is temporarily unavailable. Let's get you back on track!
            </p>

            <!-- Embedded Quick Search Box -->
            <form action="/shop" method="GET" class="error-search-form">
                <input type="text" name="search" placeholder="Search smartwatches, accessories..." aria-label="Search products">
                <button type="submit">
                    <i data-lucide="search" style="width: 15px; height: 15px;"></i>
                    Search
                </button>
            </form>

            <!-- Action Buttons -->
            <div class="actions-group">
                <a href="/" class="btn-action btn-primary-action">
                    <i data-lucide="home"></i>
                    Back to Home
                </a>
                <a href="/shop" class="btn-action btn-secondary-action">
                    <i data-lucide="shopping-bag"></i>
                    Browse Shop
                </a>
                <button onclick="window.history.back()" class="btn-action btn-ghost-action">
                    <i data-lucide="arrow-left"></i>
                    Go Back
                </button>
            </div>
        </div>
    </main>

    <!-- Minimal Clean Footer -->
    <footer class="minimal-footer">
        <div class="footer-copy">
            <span>© 2026</span>
            <i data-lucide="watch" style="width: 14px; height: 14px; display: inline-block;"></i>
            <span>Trufit. All rights reserved.</span>
        </div>
        <div class="footer-links">
            <a href="/">Home</a>
            <a href="/shop">Shop</a>
            <a href="/contact">Contact Support</a>
        </div>
    </footer>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }
        });
    </script>
</body>
</html>
