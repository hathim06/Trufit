<!-- Global Loader Overlay -->
<div id="globalLoader" class="loader-overlay" style="display: none;">
    <div class="loader-content">
        <div class="spinner"></div>
        <p>Loading...</p>
    </div>
</div>

<style>
    .loader-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(255, 255, 255, 0.85);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 10000;
        backdrop-filter: blur(5px);
        transition: opacity 0.3s ease;
    }

    .loader-content {
        text-align: center;
    }

    .spinner {
        width: 50px;
        height: 50px;
        border: 4px solid #F3F3F3;
        border-top: 4px solid #000; /* Primary color */
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin: 0 auto 15px;
    }

    .loader-content p {
        font-weight: 600;
        color: #000;
        font-family: 'Outfit', sans-serif;
        text-transform: uppercase;
        letter-spacing: 2px;
        font-size: 14px;
    }

    @keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
</style>

<script>
    (function() {
        const loader = document.getElementById('globalLoader');

        function showLoader() {
            if (loader) {
                loader.style.display = 'flex';
                // Add a small fade-in effect
                loader.style.opacity = '0';
                setTimeout(() => {
                    loader.style.opacity = '1';
                }, 10);
            }
        }

        function hideLoader() {
            if (loader) {
                loader.style.opacity = '0';
                setTimeout(() => {
                    loader.style.display = 'none';
                }, 300);
            }
        }

        // 1. Intercept all link clicks
        document.addEventListener('click', function(e) {
            const link = e.target.closest('a');
            if (link) {
                const href = link.getAttribute('href');
                const target = link.getAttribute('target');

                // Conditions to show loader:
                // - Has an href
                // - Not a javascript: link
                // - Not a fragment link (#)
                // - Not opening in a new tab
                // - Not a download link
                if (href && 
                    !href.startsWith('#') && 
                    !href.startsWith('javascript:') && 
                    (!target || target === '_self') &&
                    !link.hasAttribute('download')) {
                    showLoader();
                }
            }
        });

        // 2. Intercept all form submissions
        document.addEventListener('submit', function(e) {
            // Check if it's a normal form submission (not handled by AJAX)
            // If the form has a special class like 'no-loader', we can skip it
            if (!e.defaultPrevented) {
                showLoader();
            }
        });

        // 3. Handle window beforeunload (for other navigation types)
        window.addEventListener('beforeunload', function() {
            showLoader();
        });

        // 4. Hide loader on page load (in case it was shown by beforeunload but navigation was cancelled)
        window.addEventListener('load', function() {
            hideLoader();
        });

        // 5. Handle back/forward navigation (bfcache)
        window.addEventListener('pageshow', function(event) {
            if (event.persisted) {
                hideLoader();
            }
        });

        // Export to global scope if needed for manual AJAX calls
        window.TrufitLoader = {
            show: showLoader,
            hide: hideLoader
        };
    })();
</script>
