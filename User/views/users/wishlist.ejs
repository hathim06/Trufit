<!DOCTYPE html>
<html lang="en">

<%- include('partials/head') %>
    <style>
        /* Wishlist Content */
        .wishlist-page {
            padding: 60px 0;
        }

        .wishlist-title {
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 40px;
            text-transform: uppercase;
        }

        .wishlist-header {
            font-size: 14px;
            font-weight: 700;
            color: #6B7280;
            padding-bottom: 15px;
            border-bottom: 1px solid #E5E7EB;
            margin-bottom: 30px;
            letter-spacing: 1px;
        }

        .wishlist-list {
            display: flex;
            flex-direction: column;
        }

        .wishlist-item {
            display: flex;
            align-items: center;
            padding: 30px 0;
            border-bottom: 1px solid #F3F4F6;
        }

        .item-image {
            width: 120px;
            height: 120px;
            background: #F8F8F8;
            border-radius: 12px;
            padding: 15px;
            display: flex;
            justify-content: center;
            align-items: center;
            flex-shrink: 0;
        }

        .item-image img {
            max-height: 100%;
            object-fit: contain;
        }

        .item-details {
            flex: 1;
            padding: 0 40px;
        }

        .item-name {
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 8px;
        }

        .item-price {
            display: flex;
            align-items: baseline;
            gap: 12px;
            font-size: 16px;
            font-weight: 700;
        }

        .old-price {
            text-decoration: line-through;
            color: #9CA3AF;
            font-weight: 400;
            font-size: 14px;
        }

        .discount-tag {
            color: #ef4444;
            font-size: 13px;
            font-weight: 600;
        }

        .item-actions {
            display: flex;
            gap: 15px;
        }

        .btn {
            padding: 12px 30px;
            border-radius: 30px;
            font-weight: 600;
            font-size: 14px;
            border: none;
            cursor: pointer;
            transition: var(--transition);
            white-space: nowrap;
        }

        .btn-remove {
            background: #EF4444; /* Solid red pill */
            color: #FFFFFF;
        }

        .btn-add {
            background: #F97316; /* Solid orange pill */
            color: #000;
        }

        .btn:hover {
            transform: translateY(-2px);
            opacity: 0.9;
        }

        .btn:disabled {
            background: #D1D5DB;
            color: #6B7280;
            cursor: not-allowed;
            transform: none;
            opacity: 1;
        }

        .stock-pill {
            display: inline-flex;
            margin-top: 10px;
            padding: 5px 10px;
            border-radius: 999px;
            background: #FEE2E2;
            color: #991B1B;
            font-size: 12px;
            font-weight: 700;
        }

        .wishlist-item.is-unavailable {
            opacity: 0.65;
            pointer-events: none;
            position: relative;
        }
        .wishlist-item.is-unavailable .item-actions {
            pointer-events: all;
        }

        .unavailable-overlay {
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255,255,255,0.45);
            z-index: 5;
            pointer-events: none;
            border-radius: 12px;
        }

        .unavailable-badge {
            background: rgba(0,0,0,0.8);
            color: #fff;
            padding: 8px 18px;
            border-radius: 30px;
            font-size: 13px;
            font-weight: 600;
            letter-spacing: 1px;
            text-transform: uppercase;
            backdrop-filter: blur(4px);
        }

        .item-image.grayed img {
            filter: grayscale(100%);
            opacity: 0.5;
        }

        /* Footer */
        

        

        

        

        .logo-box i {
            width: 40px;
            height: 40px;
        }

        .logo-box span {
            font-size: 14px;
            font-weight: 700;
            margin-top: 5px;
        }

        .footer-col h4 {
            font-size: 14px;
            margin-bottom: 25px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #9CA3AF;
            display: none; /* In image, they might just be lists */
        }

        .footer-col ul li {
            margin-bottom: 15px;
        }

        .footer-col ul li a {
            color: #6B7280;
            font-size: 14px;
        }

        .footer-col ul li a:hover {
            color: #000;
        }

        

        .social-info p {
            margin-bottom: 12px;
        }

        

        /* Responsive */
        @media (max-width: 768px) {
            .wishlist-item {
                flex-direction: column;
                text-align: center;
                gap: 20px;
            }
            .item-details {
                padding: 0;
            }
            .header-left .search-bar {
                display: none;
            }
            
        }
    </style>
</head>

<body>
<%- include('partials/header') %>

    <main class="container">
        <!-- Wishlist Content -->
        <section class="wishlist-page">
            <h1 class="wishlist-title">WISHLIST</h1>
            <div class="wishlist-header">PRODUCTS</div>
            <div>
                <button class="btn" onclick="clearWishlist(event)">Clear Wishlist</button>
            </div>
            
            <div class="wishlist-list">
                <% if (typeof wishlist !== 'undefined' && wishlist.length > 0) { %>
                    <% wishlist.forEach(item => { %>
                        <% const unavailableReason = item.unavailableReason || null; %>
                        <% const isOutOfStock = Number(item.productId.totalStock || 0) <= 0; %>
                        <% const isUnavailable = Boolean(unavailableReason); %>
                        <% const isDisabled = isUnavailable || isOutOfStock; %>
                        <div class="wishlist-item <%= isDisabled ? 'is-unavailable' : '' %>">
                            <% if (isDisabled) { %>
                                <div class="unavailable-overlay">
                                    <span class="unavailable-badge"><%= isUnavailable ? unavailableReason : 'Out of Stock' %></span>
                                </div>
                            <% } %>
                            <div class="item-image <%= isDisabled ? 'grayed' : '' %>">
                                <% if (item.productId.image && item.productId.image.length > 0) { %>
                                    <img src="<%= item.productId.image[0] %>" alt="<%= item.productId.name %>">
                                <% } else { %>
                                    <img src="/public/apple_smart_2.png" alt="No image">
                                <% } %>
                            </div>
                            <div class="item-details">
                                <h3 class="item-name"><%= item.productId.name %></h3>
                                <div class="item-price">
                                    <% if (item.productId.offerPrice && item.productId.offerPrice < item.productId.price) { %>
                                        <span class="discounted">₹<%= item.productId.offerPrice %></span>
                                        <span class="old-price">₹<%= item.productId.price %></span>
                                        <% let discount = Math.round(((item.productId.price - item.productId.offerPrice) / item.productId.price) * 100); %>
                                        <span class="discount-tag"><%= discount %>% off</span>
                                    <% } else { %>
                                        <span class="discounted">₹<%= item.productId.price %></span>
                                    <% } %>
                                </div>
                                <% if (isOutOfStock && !isUnavailable) { %>
                                    <span class="stock-pill">Out of Stock</span>
                                <% } %>
                                <% if (isUnavailable) { %>
                                    <span class="stock-pill" style="background: #FEF3C7; color: #92400E;">Unavailable</span>
                                <% } %>
                            </div>
                            <div class="item-actions">
                                <button class="btn btn-remove" onclick="removeFromWishlist(event, '<%= item.productId._id %>')">Remove</button>
                                <button class="btn btn-add" onclick="addToCart(event, '<%= item.productId._id %>')" <%= isDisabled ? 'disabled title="This product is currently unavailable"' : '' %>><%= isDisabled ? (isUnavailable ? 'Unavailable' : 'Out of Stock') : 'Add to cart' %></button>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div id="empty-wishlist" style="padding: 50px 0; text-align: center; color: #6B7280;">
                        <p style="font-size: 18px;">Your wishlist is currently empty.</p>
                        <a href="/shop" class="btn" style="background:#000; color:#fff; display:inline-block; margin-top:20px;">Explore Products</a>
                    </div>
                <% } %>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        lucide.createIcons();

        function showEmptyStateIfNeeded() {
            const list = document.querySelector('.wishlist-list');
            const items = list.querySelectorAll('.wishlist-item');
            if (items.length === 0) {
                list.innerHTML = `
                    <div id="empty-wishlist" style="padding: 50px 0; text-align: center; color: #6B7280;">
                        <p style="font-size: 18px;">Your wishlist is currently empty.</p>
                        <a href="/shop" class="btn" style="background:#000; color:#fff; display:inline-block; margin-top:20px;">Explore Products</a>
                    </div>`;
            }
        }

        async function removeFromWishlist(event, productId) {
            event.preventDefault();
            const btn = event.currentTarget;
            const itemRow = btn.closest('.wishlist-item');

            const result = await Swal.fire({
                title: 'Remove from Wishlist?',
                text: 'Are you sure you want to remove this item?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#EF4444',
                confirmButtonText: 'Yes, remove it!'
            });

            if (!result.isConfirmed) return;

            try {
                const response = await fetch(`/wishlist/remove/${productId}`, { method: 'POST' });
                const data = await response.json();

                if (response.ok && data.success) {
                    itemRow.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
                    itemRow.style.opacity = '0';
                    itemRow.style.transform = 'translateX(20px)';
                    setTimeout(() => {
                        itemRow.remove();
                        showEmptyStateIfNeeded();
                        if (typeof updateHeaderCounts === 'function') updateHeaderCounts();
                    }, 300);
                } else {
                    Swal.fire('Error', data.message || 'Failed to remove item', 'error');
                }
            } catch (error) {
                console.error('Remove Wishlist Error:', error);
                Swal.fire('Error', 'Something went wrong!', 'error');
            }
        }

        async function clearWishlist(event){
            event.preventDefault();
            const btn = event.currentTarget;
            const itemRow = btn.closest('.wishlist-item');
            const result = await Swal.fire({
                title: 'Clear Wishlist?',
                text: 'Are you sure you want to clear your entire wishlist?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#EF4444',
                confirmButtonText: 'Yes, clear it!'
            });

            if (!result.isConfirmed) return;

            try {
                const response = await fetch('/wishlist/clear', { method: 'POST' });
                const data = await response.json();

                if (response.ok && data.success) {
                    document.querySelector('.wishlist-list').innerHTML = `
                        <div id="empty-wishlist" style="padding: 50px 0; text-align: center; color: #6B7280;">
                            <p style="font-size: 18px;">Your wishlist is currently empty.</p>
                            <a href="/shop" class="btn" style="background:#000; color:#fff; display:inline-block; margin-top:20px;">Explore Products</a>
                        </div>`;
                    if (typeof updateHeaderCounts === 'function') updateHeaderCounts();
                } else {
                    Swal.fire('Error', data.message || 'Failed to clear wishlist', 'error');
                }
            } catch (error) {
                console.error('Clear Wishlist Error:', error);
                Swal.fire('Error', 'Something went wrong!', 'error');
            }
        }

        async function addToCart(event, productId) {
            event.preventDefault();
            const btn = event.currentTarget;
            const itemRow = btn.closest('.wishlist-item');

            btn.disabled = true;
            btn.textContent = 'Adding...';

            try {
                const response = await fetch('/cart/add', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ productId: productId, quantity: 1 })
                });

                const data = await response.json();

                if (response.ok && data.success) {
                    // Server removes item from wishlist when added to cart — remove row from DOM
                    itemRow.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
                    itemRow.style.opacity = '0';
                    itemRow.style.transform = 'translateX(20px)';
                    setTimeout(() => {
                        itemRow.remove();
                        showEmptyStateIfNeeded();
                        if (typeof updateHeaderCounts === 'function') updateHeaderCounts();
                    }, 300);

                    Swal.fire({
                        icon: 'success',
                        title: 'Added to Cart!',
                        text: 'Product successfully added to your cart.',
                        timer: 1500,
                        showConfirmButton: false
                    });
                } else {
                    btn.disabled = false;
                    btn.textContent = 'Add to cart';
                    Swal.fire({
                        icon: 'error',
                        title: 'Oops...',
                        text: data.message || 'Error adding to cart'
                    });
                }
            } catch (error) {
                btn.disabled = false;
                btn.textContent = 'Add to cart';
                console.error('Cart Error:', error);
                Swal.fire({ icon: 'error', title: 'Error', text: 'Something went wrong!' });
            }
        }
    </script>
</body>

</html>


