<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/head') %>
        <style>
            .failed-page {
                min-height: 80vh;
                display: flex;
                align-items: center;
                justify-content: center;
                background: #F9FAFB;
                padding: 40px 20px;
            }

            .failed-card {
                background: #FFFFFF;
                max-width: 500px;
                width: 100%;
                padding: 60px 40px;
                border-radius: 20px;
                box-shadow: 0 10px 40px rgba(0, 0, 0, 0.05);
                text-align: center;
            }

            .failed-icon {
                width: 80px;
                height: 80px;
                background: #EF4444;
                color: #FFFFFF;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0 auto 30px;
                font-size: 40px;
            }

            .failed-card h1 {
                font-size: 32px;
                font-weight: 700;
                margin-bottom: 10px;
                color: #111827;
            }

            .failed-card p {
                color: #6B7280;
                font-size: 16px;
                margin-bottom: 40px;
            }

            .btn-retry {
                display: block;
                width: 100%;
                background: #000;
                color: #FFF;
                padding: 18px;
                border-radius: 8px;
                font-size: 16px;
                font-weight: 700;
                text-transform: uppercase;
                text-decoration: none;
                transition: all 0.3s;
            }

            .btn-retry:hover {
                background: #374151;
            }

            .back-link {
                display: inline-block;
                margin-top: 20px;
                color: #6B7280;
                font-size: 14px;
                text-decoration: none;
            }

            .back-link:hover {
                text-decoration: underline;
            }
        </style>
</head>

<body>
    <%- include('partials/header') %>
        <main class="failed-page">
            <div class="failed-card">
                <div class="failed-icon">
                    <i data-lucide="x-circle"></i>
                </div>
                <h1>Order Failed!</h1>
                <p>
                    <%= typeof message !=='undefined' ? message : 'Something went wrong while processing your payment.'
                        %>
                </p>

                <% if (typeof orderId !=='undefined' && orderId && typeof canRetry !== 'undefined' && canRetry) { %>
                    <button onclick="retryPayment('<%= orderId %>')" class="btn-retry"
                        style="border:none; cursor:pointer; margin-bottom: 15px;">Retry Payment</button>
                    <a href="/profile/orders/<%= orderId %>" class="back-link"
                        style="display:block; font-weight:600; margin-bottom: 10px;">View Order Details</a>
                    <% } else if (typeof orderId !=='undefined' && orderId) { %>
                        <a href="/profile/orders/<%= orderId %>" class="btn-retry">View Order Details</a>
                    <% } else { %>
                        <a href="/checkout" class="btn-retry">Retry Checkout</a>
                        <% } %>
                            <a href="/cart" class="back-link">Return to Cart</a>

            </div>
        </main>
        <%- include('partials/footer') %>
            <script>lucide.createIcons();</script>
            <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

            <script>
                async function retryPayment(orderId) {
                    try {
                        const response = await fetch(`/profile/orders/${orderId}/retry-payment`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' }
                        });
                        const data = await response.json();

                        if (!data.success) {
                            return Swal.fire('Error', data.message || 'Failed to retry payment', 'error');
                        }

                        const options = {
                            key: data.key,
                            amount: data.amount,
                            currency: 'INR',
                            name: 'Trufit Smartwatches',
                            description: 'Payment Retry',
                            order_id: data.rzpOrderId,
                            handler: async function (response) {
                                const verifyResponse = await fetch('/verify-payment', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({
                                        razorpay_order_id: response.razorpay_order_id,
                                        razorpay_payment_id: response.razorpay_payment_id,
                                        razorpay_signature: response.razorpay_signature,
                                        orderId: data.orderId
                                    })
                                });
                                const verifyData = await verifyResponse.json();
                                window.location.href = verifyData.redirectUrl || '/order-failed?message=Payment%20verification%20failed';
                            },
                            prefill: {
                                method: 'upi'
                            },
                            theme: { color: '#000000' }
                        };

                        const rzp = new Razorpay(options);
                        rzp.open();
                    } catch (err) {
                        Swal.fire('Error', 'Payment initialization failed', 'error');
                    }
                }
            </script>

</body>

</html>
