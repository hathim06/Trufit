<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <style>
        .failed-page {
            min-height: 80vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #F9FAFB;
            padding: 40px 20px;
        }
        .failed-card {
            background: #FFFFFF;
            max-width: 500px;
            width: 100%;
            padding: 60px 40px;
            border-radius: 20px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.05);
            text-align: center;
        }
        .failed-icon {
            width: 80px;
            height: 80px;
            background: #EF4444;
            color: #FFFFFF;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 30px;
            font-size: 40px;
        }
        .failed-card h1 {
            font-size: 32px;
            font-weight: 700;
            margin-bottom: 10px;
            color: #111827;
        }
        .failed-card p {
            color: #6B7280;
            font-size: 16px;
            margin-bottom: 40px;
        }
        .btn-retry {
            display: block;
            width: 100%;
            background: #000;
            color: #FFF;
            padding: 18px;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 700;
            text-transform: uppercase;
            text-decoration: none;
            transition: all 0.3s;
        }
        .btn-retry:hover {
            background: #374151;
        }
        .back-link {
            display: inline-block;
            margin-top: 20px;
            color: #6B7280;
            font-size: 14px;
            text-decoration: none;
        }
        .back-link:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <%- include('partials/header') %>
    <main class="failed-page">
        <div class="failed-card">
            <div class="failed-icon">
                <i data-lucide="x-circle"></i>
            </div>
            <h1>Order Failed!</h1>
            <p><%= typeof message !== 'undefined' ? message : 'Something went wrong while processing your order. Please try again or check your payment details.' %></p>
            
            <a href="/checkout" class="btn-retry">Retry Checkout</a>
            <a href="/cart" class="back-link">Return to Cart</a>
        </div>
    </main>
    <%- include('partials/footer') %>
    <script>lucide.createIcons();</script>
</body>
</html>
