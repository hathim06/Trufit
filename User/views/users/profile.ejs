<!DOCTYPE html>
<html lang="en">

<%- include('partials/head') %>
    <style>
        /* Profile Content */
        .profile-page {
            padding: 80px 20px;
            min-height: 100vh;
        }

        .profile-container {
            max-width: 1200px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 250px 1fr;
            gap: 40px;
        }

        /* Sidebar Styles */
        .profile-sidebar {
            background: #FFFFFF;
            border: 1px solid #E5E7EB;
            border-radius: 4px;
            padding: 0;
            height: fit-content;
            position: sticky;
            top: 100px;
        }

        .sidebar-header {
            background: #000;
            color: #FFF;
            padding: 20px;
            font-weight: 700;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-radius: 4px 4px 0 0;
        }

        .sidebar-menu {
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .sidebar-menu li {
            border-bottom: 1px solid #E5E7EB;
        }

        .sidebar-menu li:last-child {
            border-bottom: none;
        }

        .sidebar-menu a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 16px 20px;
            color: #374151;
            text-decoration: none;
            font-weight: 500;
            font-size: 14px;
            transition: var(--transition);
        }

        .sidebar-menu a:hover {
            background: #F3F4F6;
            color: #000;
            padding-left: 24px;
        }

        .sidebar-menu a i {
            width: 18px;
            height: 18px;
            flex-shrink: 0;
        }

        /* Main Content */
        .profile-main {
            background: #FFFFFF;
            border: 1px solid #E5E7EB;
            border-radius: 4px;
            padding: 60px;
        }

        .profile-main h1 {
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 40px;
        }

        .profile-avatar {
            display: flex;
            justify-content: center;
            margin-bottom: 40px;
            position: relative;
        }

        .avatar-container {
            position: relative;
            cursor: pointer;
            width: 100px;
            height: 100px;
            border-radius: 50%;
            overflow: hidden;
            transition: var(--transition);
        }

        .avatar-container:hover .avatar-overlay {
            opacity: 1;
        }

        .avatar-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.4);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: #FFF;
            opacity: 0;
            transition: var(--transition);
            z-index: 2;
        }

        .avatar-overlay i {
            width: 24px !important;
            height: 24px !important;
            color: #FFF !important;
            margin-bottom: 4px;
        }

        .avatar-overlay span {
            font-size: 10px;
            font-weight: 600;
            text-transform: uppercase;
        }

        .profile-avatar img {
            object-fit: cover;
        }

        .edit-button {
            position: absolute;
            top: -10px;
            right: -10px;
            background: #000;
            color: #FFF;
            border: none;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: var(--transition);
        }

        .edit-button:hover {
            background: #333;
        }

        .edit-button i {
            width: 16px !important;
            height: 16px !important;
        }

        .remove-picture-btn {
            margin-top: 15px;
            text-align: center;
        }

        .remove-picture-btn button {
            background: #EF4444;
            color: #FFF;
            border: none;
            padding: 10px 20px;
            border-radius: 4px;
            cursor: pointer;
            font-weight: 600;
            transition: var(--transition);
        }

        .remove-picture-btn button:hover {
            background: #DC2626;
        }

        .profile-details {
            max-width: 100%;
            margin-top: 30px;
        }

        .detail-row {
            display: grid;
            grid-template-columns: 150px 1fr;
            margin-bottom: 20px;
            padding-bottom: 15px;
            border-bottom: 1px solid #E5E7EB;
        }

        .detail-row:last-child {
            border-bottom: none;
        }

        .detail-row span:first-child {
            font-weight: 700;
            color: #000;
        }

        .detail-row span:last-child {
            font-weight: 500;
            color: #6B7280;
        }

        /* Modal Styling */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.8);
            z-index: 2000;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .modal-content {
            background: #FFF;
            padding: 30px;
            border-radius: 8px;
            max-width: 600px;
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #EEE;
            padding-bottom: 15px;
        }

        .modal-header h2 {
            font-size: 18px;
            font-weight: 700;
            margin: 0;
        }

        .cropper-container-wrapper {
            max-height: 400px;
            overflow: hidden;
            background: #F3F4F6;
            border-radius: 4px;
        }

        .modal-actions {
            display: flex;
            justify-content: flex-end;
            gap: 15px;
            border-top: 1px solid #EEE;
            padding-top: 15px;
        }

        .btn-modal {
            padding: 10px 25px;
            border-radius: 4px;
            font-weight: 600;
            cursor: pointer;
            border: none;
            font-size: 14px;
        }

        .btn-cancel {
            background: #F3F4F6;
            color: #4B5563;
        }

        .btn-crop {
            background: #000;
            color: #FFF;
        }

        /* Footer */
        

        

        

        

        .logo-box i {
            width: 40px;
            height: 40px;
        }

        .logo-box span {
            font-size: 14px;
            font-weight: 700;
            margin-top: 5px;
        }

        

        

        /* Responsive */
        @media (max-width: 768px) {
            .profile-container {
                grid-template-columns: 1fr;
            }

            .profile-sidebar {
                position: static;
            }

            .profile-main {
                padding: 30px;
            }

            .profile-main h1 {
                font-size: 22px;
            }

            .detail-row {
                grid-template-columns: 1fr;
                gap: 5px;
            }

            
        }
    </style>
</head>

<body>
    <%- include('partials/header') %>

    <main class="container">
        <section class="profile-page">
            <div class="profile-container">
                <%- include('partials/user-sidebar', { activePage: 'profile' }) %>

                <div class="profile-main-content">
                    <h1>My Profile</h1>

                    <%- include('partials/alerts') %>

                    <!-- Avatar Section -->
                    <div class="avatar-top-section">
                        <label for="fileInput">
                            <div class="profile-avatar">
                                <div class="avatar-container">
                                    <div class="avatar-overlay">
                                        <i data-lucide="camera"></i>
                                        <span>Change</span>
                                    </div>
                                    <% if (user.profilePicture) { %>
                                        <img src="<%= user.profilePicture %>" id="currentAvatar" width="100" height="100">
                                    <% } else { %>
                                        <div style="
                                            width: 100px;
                                            height: 100px;
                                            background: #000;
                                            color: #fff;
                                            display: flex;
                                            align-items: center;
                                            justify-content: center;
                                            font-size: 40px;
                                            font-weight: bold;
                                        ">
                                            <%= user.firstName.charAt(0).toUpperCase() %>
                                        </div>
                                    <% } %>
                                </div>
                                <a href="/edit-profile" class="edit-button">
                                    <i data-lucide="pencil"></i>
                                </a>
                            </div>
                        </label>
                        <input type="file" id="fileInput" name="profilePicture" accept="image/*" hidden>
                    </div>

                    <% if (user.profilePicture) { %>
                        <div class="remove-picture-btn">
                            <button type="button" onclick="confirmDeletePicture()">Remove Profile Picture</button>
                            <form id="deletePictureForm" action="/profile/delete-picture" method="POST" style="display:none;"></form>
                        </div>
                    <% } %>

                    <!-- Profile Details -->
                    <div class="profile-details">
                        <div class="detail-row">
                            <span>Full Name</span>
                            <span><%= user.firstName %> <%= user.lastName %></span>
                        </div>
                        <div class="detail-row">
                            <span>Email</span>
                            <span><%= user.email %></span>
                        </div>
                        <div class="detail-row">
                            <span>Phone Number</span>
                            <span><%= user.mobile || 'Not provided' %></span>
                        </div>
                        <div class="detail-row">
                            <span>Default Address</span>
                            <span><%= defaultAddress ? defaultAddress.addressLine + ', ' + defaultAddress.city : 'No address added' %></span>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- Cropping Modal -->
    <div id="cropModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2>CROP PROFILE PICTURE</h2>
                <i data-lucide="x" style="cursor: pointer;" onclick="closeModal()"></i>
            </div>
            <div class="cropper-container-wrapper">
                <img id="cropImage" src="" style="max-width: 100%;">
            </div>
            <div class="modal-actions">
                <button type="button" class="btn-modal btn-cancel" onclick="closeModal()">CANCEL</button>
                <button type="button" class="btn-modal btn-crop" onclick="processCrop()">CROP & UPLOAD</button>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>

    <script>
        lucide.createIcons();

        let cropper;
        const fileInput = document.getElementById('fileInput');
        const cropModal = document.getElementById('cropModal');
        const cropImage = document.getElementById('cropImage');

        fileInput.addEventListener('change', function(e) {
            const files = e.target.files;
            if (files && files.length > 0) {
                const file = files[0];
                
                // --- ADDED VALIDATION ---
                const allowedTypes = ['image/jpeg', 'image/png', 'image/jpg', 'image/webp'];
                const allowedExtensions = ['jpg', 'jpeg', 'png', 'webp'];
                const extension = file.name.split('.').pop().toLowerCase();

                if (!allowedTypes.includes(file.type) || !allowedExtensions.includes(extension)) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Invalid File Type',
                        text: 'Only image files (JPG, JPEG, PNG, WEBP) are allowed!',
                        confirmButtonColor: '#000'
                    });
                    fileInput.value = '';
                    return;
                }

                if (file.size > 5 * 1024 * 1024) {
                    Swal.fire({
                        icon: 'error',
                        title: 'File Too Large',
                        text: 'Maximum file size is 5MB!',
                        confirmButtonColor: '#000'
                    });
                    fileInput.value = '';
                    return;
                }
                // -------------------------

                const reader = new FileReader();
                reader.onload = function(e) {
                    cropImage.src = e.target.result;
                    cropModal.style.display = 'flex';
                    
                    if (cropper) {
                        cropper.destroy();
                    }
                    
                    cropper = new Cropper(cropImage, {
                        aspectRatio: 1,
                        viewMode: 2,
                        guides: true,
                        autoCropArea: 1,
                        movable: true,
                        zoomable: true,
                        rotatable: true,
                        scalable: true
                    });
                };
                reader.readAsDataURL(file);
            }
        });

        function closeModal() {
            cropModal.style.display = 'none';
            if (cropper) {
                cropper.destroy();
            }
            fileInput.value = '';
        }

        async function processCrop() {
            if (!cropper) return;

            const canvas = cropper.getCroppedCanvas({
                width: 400,
                height: 400
            });

            canvas.toBlob(async (blob) => {
                const formData = new FormData();
                formData.append('profilePicture', blob, 'profile.jpg');

                closeModal();

                Swal.fire({
                    title: 'Uploading...',
                    text: 'Please wait while we update your profile picture',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                try {
                    const response = await fetch('/profile/upload-picture', {
                        method: 'POST',
                        body: formData
                    });

                    if (response.ok) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Updated!',
                            text: 'Profile picture has been updated successfully.',
                            timer: 2000,
                            showConfirmButton: false
                        }).then(() => {
                            window.location.reload();
                        });
                    } else {
                        const errorData = await response.json().catch(() => ({}));
                        throw new Error(errorData.message || 'Upload failed');
                    }
                } catch (error) {
                    console.error('Upload error:', error);
                    Swal.fire({
                        icon: 'error',
                        title: 'Upload Failed',
                        text: error.message || 'Something went wrong while uploading.'
                    });
                }
            }, 'image/jpeg');
        }

        function confirmDeletePicture() {
            Swal.fire({
                title: 'Are you sure?',
                text: "You want to remove your profile picture?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#000',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, remove it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('deletePictureForm').submit();
                }
            })
        }
    </script>
</body>
</html>