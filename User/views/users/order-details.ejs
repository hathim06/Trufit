<!DOCTYPE html>
<html lang="en">

<%- include('partials/head') %>
    <style>
        /* Profile Content */
        .profile-page {
            padding: 80px 20px;
            min-height: 100vh;
        }

        .profile-container {
            max-width: 1200px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 250px 1fr;
            gap: 40px;
        }

        /* Sidebar Styles (Same as orders.ejs) */
        .profile-sidebar {
            background: #FFFFFF;
            border: 1px solid #E5E7EB;
            border-radius: 4px;
            padding: 0;
            height: fit-content;
            position: sticky;
            top: 100px;
        }

        .sidebar-header {
            background: #000;
            color: #FFF;
            padding: 20px;
            font-weight: 700;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-radius: 4px 4px 0 0;
        }

        .sidebar-menu {
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .sidebar-menu li {
            border-bottom: 1px solid #E5E7EB;
        }

        .sidebar-menu a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 16px 20px;
            color: #374151;
            text-decoration: none;
            font-weight: 500;
            font-size: 14px;
            transition: var(--transition);
        }

        .sidebar-menu a.active {
            background: #F3F4F6;
            color: #000;
            border-left: 3px solid #000;
        }

        /* Main Content */
        .profile-main-content {
            background: #FFFFFF;
            border: 1px solid #E5E7EB;
            border-radius: 4px;
            padding: 40px;
        }

        .order-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 40px;
            padding-bottom: 20px;
            border-bottom: 2px solid #F3F4F6;
        }

        .order-meta h1 {
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 8px;
            text-transform: uppercase;
        }

        .order-date {
            font-size: 14px;
            color: #6B7280;
        }

        .status-badge {
            padding: 6px 16px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
        }

        /* Info Grid */
        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
            margin-bottom: 40px;
        }

        .info-section h3 {
            font-size: 14px;
            font-weight: 700;
            margin-bottom: 15px;
            color: #000;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .info-box {
            background: #F9FAFB;
            padding: 20px;
            border-radius: 8px;
            border: 1px solid #E5E7EB;
        }

        .info-box p {
            font-size: 14px;
            color: #4B5563;
            line-height: 1.6;
            margin: 0;
        }

        /* Items List */
        .order-items-title {
            font-size: 14px;
            font-weight: 700;
            margin-bottom: 20px;
            text-transform: uppercase;
        }

        .items-list {
            border: 1px solid #E5E7EB;
            border-radius: 8px;
            overflow: hidden;
            margin-bottom: 40px;
        }

        .item-row {
            display: grid;
            grid-template-columns: 80px 1fr 100px;
            gap: 20px;
            padding: 20px;
            border-bottom: 1px solid #E5E7EB;
            align-items: center;
        }

        .item-row:last-child {
            border-bottom: none;
        }

        .item-img {
            width: 80px;
            height: 80px;
            background: #F9FAFB;
            border-radius: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .item-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .item-info .item-name {
            font-weight: 700;
            font-size: 15px;
            margin-bottom: 4px;
            color: #000;
        }

        .item-info .item-variant {
            font-size: 13px;
            color: #6B7280;
        }

        .item-total {
            text-align: right;
            font-weight: 700;
            font-size: 15px;
        }

        /* Order Totals */
        .totals-container {
            width: 350px;
            margin-left: auto;
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 12px;
            font-size: 14px;
            color: #6B7280;
        }

        .summary-row.grand-total {
            margin-top: 20px;
            padding-top: 20px;
            border-top: 2px solid #E5E7EB;
            font-size: 20px;
            font-weight: 700;
            color: #000;
        }

        .coupon-tag {
            color: #10B981;
            font-weight: 600;
        }

        .btn-back {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: #374151;
            text-decoration: none;
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 30px;
            transition: var(--transition);
        }

        .btn-back:hover {
            color: #000;
            transform: translateX(-5px);
        }

        @media (max-width: 768px) {
            .profile-container { grid-template-columns: 1fr; }
            .info-grid { grid-template-columns: 1fr; gap: 20px; }
            .order-header { flex-direction: column; gap: 15px; }
            .totals-container { width: 100%; }
        }
        
        .status-badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .status-placed { background: #DBEAFE; color: #1E40AF; }
        .status-processing { background: #FEF3C7; color: #92400E; }
        .status-shipped { background: #E0E7FF; color: #3730A3; }
        .status-delivered { background: #D1FAE5; color: #065F46; }
        .status-cancelled { background: #FEE2E2; color: #991B1B; }
    </style>
</head>

<body>
    <%- include('partials/header') %>

    <main class="container">
        <section class="profile-page">
            <div class="profile-container">
                <%- include('partials/user-sidebar', { activePage: 'orders' }) %>

                <div class="profile-main-content">
                    <a href="/profile/orders" class="btn-back">
                        <i data-lucide="arrow-left"></i> Back to Orders
                    </a>

                    <div class="order-header">
                        <div class="order-meta">
                            <h1>Order #<%= order.orderId %></h1>
                            <p class="order-date">Placed on <%= new Date(order.createdAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) %></p>
                        </div>
                        <span class="status-badge status-<%= order.orderStatus.toLowerCase() %>">
                            <%= order.orderStatus %>
                        </span>
                    </div>

                    <div class="info-grid">
                        <div class="info-section">
                            <h3>Shipping Address</h3>
                            <div class="info-box">
                                <p><strong><%= order.deliveryAddress.name %></strong></p>
                                <p><%= order.deliveryAddress.addressLine %></p>
                                <p><%= order.deliveryAddress.city %>, <%= order.deliveryAddress.district %></p>
                                <p><%= order.deliveryAddress.state %> - <%= order.deliveryAddress.pincode %></p>
                                <p style="margin-top: 10px;">Mobile: <%= order.deliveryAddress.mobile %></p>
                            </div>
                        </div>
                        <div class="info-section">
                            <h3>Payment Information</h3>
                            <div class="info-box">
                                <p><strong>Method:</strong> <%= order.paymentMethod === 'COD' ? 'Cash on Delivery' : 'Online Payment' %></p>
                                <p><strong>Status:</strong> <%= order.paymentStatus %></p>
                            </div>
                        </div>
                    </div>

                    <h3 class="order-items-title">Ordered Items</h3>
                    <div class="items-list">
                        <% order.items.forEach(item => { %>
                            <div class="item-row">
                                <div class="item-img">
                                    <i data-lucide="package" style="width: 24px; color: #D1D5DB;"></i>
                                </div>
                                <div class="item-info">
                                    <div class="item-name"><%= item.name %></div>
                                    <div class="item-variant">Quantity: <%= item.quantity %> | Price: ₹<%= item.price.toLocaleString() %></div>
                                </div>
                                <div class="item-total">₹<%= item.totalPrice.toLocaleString() %></div>
                            </div>
                        <% }) %>
                    </div>

                    <div class="totals-container">
                        <div class="summary-row">
                            <span>Subtotal</span>
                            <span>₹<%= order.subtotal.toLocaleString() %></span>
                        </div>
                        <% if (order.discountAmount > 0) { %>
                            <div class="summary-row">
                                <span>Coupon Discount</span>
                                <span class="coupon-tag">-₹<%= order.discountAmount.toLocaleString() %></span>
                            </div>
                        <% } %>
                        <div class="summary-row">
                            <span>Shipping</span>
                            <span style="color: #10B981; font-weight: 600;">FREE</span>
                        </div>
                        <div class="summary-row grand-total">
                            <span>Order Total</span>
                            <span>₹<%= order.grandTotal.toLocaleString() %></span>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>

    <script>
        lucide.createIcons();
    </script>
</body>
</html>
