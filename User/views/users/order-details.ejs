<!DOCTYPE html>
<html lang="en">

<%- include('partials/head') %>
    <style>
        .profile-page {
            padding: 80px 20px;
            min-height: 100vh;
        }

        .profile-container {
            max-width: 1200px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 250px 1fr;
            gap: 40px;
        }

        /* Sidebar Styles */
        .profile-sidebar {
            background: #FFFFFF;
            border: 1px solid #E5E7EB;
            border-radius: 4px;
            padding: 0;
            height: fit-content;
            position: sticky;
            top: 100px;
        }

        .sidebar-header {
            background: #000;
            color: #FFF;
            padding: 20px;
            font-weight: 700;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-radius: 4px 4px 0 0;
        }

        .sidebar-menu {
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .sidebar-menu li {
            border-bottom: 1px solid #E5E7EB;
        }

        .sidebar-menu a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 16px 20px;
            color: #374151;
            text-decoration: none;
            font-weight: 500;
            font-size: 14px;
            transition: var(--transition);
        }

        .sidebar-menu a.active {
            background: #F3F4F6;
            color: #000;
            border-left: 3px solid #000;
        }

        /* Main Content Layout */
        .order-details-wrapper {
            background: #FFF;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
        }

        .col-left,
        .col-right {
            display: flex;
            flex-direction: column;
            gap: 30px;
        }

        .section-title {
            font-size: 16px;
            font-weight: 700;
            color: #000;
            text-transform: uppercase;
            margin-bottom: 15px;
            letter-spacing: 0.5px;
        }

        /* Order Info */
        .order-meta-info {
            font-size: 13px;
            color: #6B7280;
            margin-bottom: 20px;
        }

        .order-meta-info span {
            color: #EF4444;
            /* red color for Order ID in design */
            font-weight: 600;
        }

        /* Delivery Address Box */
        .address-box {
            border: 1px solid #E5E7EB;
            padding: 20px;
            border-radius: 4px;
        }

        .address-name {
            font-size: 14px;
            font-weight: 700;
            color: #000;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .address-type {
            background: #E5E7EB;
            font-size: 10px;
            padding: 2px 8px;
            border-radius: 20px;
            text-transform: uppercase;
        }

        .address-details {
            font-size: 13px;
            color: #6B7280;
            line-height: 1.6;
        }

        .address-details strong {
            color: #000;
        }

        /* Timeline */
        .timeline {
            margin-top: 10px;
            position: relative;
            padding-left: 20px;
        }

        .timeline::before {
            content: '';
            position: absolute;
            left: 5px;
            top: 5px;
            bottom: 5px;
            width: 2px;
            background: #E5E7EB;
        }

        .timeline-item {
            position: relative;
            margin-bottom: 25px;
            font-size: 13px;
            color: #6B7280;
        }

        .timeline-item:last-child {
            margin-bottom: 0;
        }

        .timeline-item.active {
            color: #10B981;
            font-weight: 700;
        }

        .timeline-dot {
            position: absolute;
            left: -20px;
            top: 3px;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: #FFF;
            border: 2px solid #E5E7EB;
            z-index: 1;
        }

        .timeline-item.active .timeline-dot {
            background: #10B981;
            border-color: #10B981;
        }

        /* Right Column Items */
        .items-box {
            border: 1px solid #E5E7EB;
            border-radius: 4px;
            padding: 20px;
        }

        .item-row {
            display: flex;
            align-items: center;
            padding: 20px 0;
            border-bottom: 1px solid #F3F4F6;
        }

        .item-row:first-child {
            padding-top: 0;
        }

        .item-row:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

        .item-image {
            width: 60px;
            height: 60px;
            margin-right: 15px;
            flex-shrink: 0;
        }

        .item-image img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        .item-info {
            flex: 1;
        }

        .item-name {
            font-size: 14px;
            font-weight: 600;
            color: #000;
            margin-bottom: 4px;
        }

        .item-meta {
            font-size: 12px;
            color: #6B7280;
            margin-bottom: 8px;
        }

        .item-price {
            font-size: 13px;
            font-weight: 700;
        }

        .item-price strike {
            color: #9CA3AF;
            font-size: 11px;
            margin-left: 5px;
        }

        .item-actions {
            display: flex;
            gap: 10px;
        }

        .btn-action {
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            border: none;
            cursor: pointer;
            color: #FFF;
        }

        .btn-cancel {
            background: #EF4444;
        }

        .btn-return {
            background: #F59E0B;
        }

        /* Summary Box */
        .summary-box {
            background: #F9FAFB;
            padding: 30px;
            border-radius: 4px;
            display: flex;
            flex-direction: column;
            gap: 15px;
            font-size: 13px;
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            color: #374151;
            font-weight: 600;
        }

        .summary-row.green {
            color: #10B981;
        }

        .summary-row.total {
            margin-top: 10px;
            padding-top: 20px;
            border-top: 1px solid #E5E7EB;
            font-size: 16px;
            color: #000;
        }

        .btn-go-orders {
            display: block;
            width: 100%;
            padding: 16px;
            background: #A89595;
            color: #FFF;
            text-align: center;
            text-transform: uppercase;
            font-weight: 700;
            border-radius: 4px;
            text-decoration: none;
            transition: background 0.2s;
        }

        .btn-go-orders:hover {
            background: #8B7373;
        }

        .btn-invoice {
            display: block;
            width: 100%;
            padding: 16px;
            background: #F3F4F6;
            color: #374151;
            text-align: center;
            text-transform: uppercase;
            font-weight: 700;
            border-radius: 4px;
            text-decoration: none;
            transition: background 0.2s;
            margin-top: 15px;
            border: 1px solid #E5E7EB;
        }

        .btn-invoice:hover {
            background: #E5E7EB;
        }

        @media (max-width: 992px) {
            .order-details-wrapper {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 768px) {
            .profile-container {
                grid-template-columns: 1fr;
            }
        }
    </style>
    </head>

    <body>
        <%- include('partials/header') %>

            <main class="container">
                <section class="profile-page">
                    <div class="profile-container">
                        <%- include('partials/user-sidebar', { activePage: 'orders' }) %>

                            <div class="order-details-wrapper">
                                <!-- Left Column -->
                                <div class="col-left">
                                    <div>
                                        <div class="section-title">ORDER SUMMARY</div>
                                        <div class="order-meta-info">
                                            Order ID: <span>#<%= order.orderId %></span> | Placed on: <%= new
                                                Date(order.createdAt).toLocaleDateString('en-GB', { day: 'numeric' ,
                                                month: 'long' , year: 'numeric' }) %>
                                        </div>
                                    </div>

                                    <div>
                                        <div class="section-title">DELIVERY ADDRESS</div>
                                        <div class="address-box">
                                            <div class="address-name">
                                                <%= order.shippingAddress.name %> <span class="address-type">HOME</span>
                                            </div>
                                            <div class="address-details">
                                                <%= order.shippingAddress.addressLine %>, <br>
                                                    <%= order.shippingAddress.city %>, <%=
                                                            order.shippingAddress.district %>, <br>
                                                            <%= order.shippingAddress.state %> - <%=
                                                                    order.shippingAddress.pincode %> <br><br>
                                                                    <strong>Mobile:</strong>
                                                                    <%= order.shippingAddress.mobile %>
                                            </div>
                                        </div>
                                    </div>

                                    <div>
                                        <div class="section-title">ORDER STATUS</div>
                                        <% const steps=[ { key: 'Pending' , label: 'Order Placed' }, { key: 'Confirmed'
                                            , label: 'Order Confirmed' }, { key: 'Shipped' , label: 'Shipped' }, {
                                            key: 'Out for Delivery' , label: 'Out for Delivery' }, { key: 'Delivered' ,
                                            label: 'Delivered' } ]; const currentStatus=order.orderStatus; let
                                            activeIndex=steps.findIndex(s=> s.key === currentStatus);
                                            if (currentStatus === 'Placed') activeIndex = 0;
                                            if (currentStatus === 'Processing') activeIndex = 1;
                                            %>

                                            <div class="timeline">
                                                <% if (currentStatus==='Cancelled' ) { %>
                                                    <div class="timeline-item active" style="color: #EF4444;">
                                                        <div class="timeline-dot"
                                                            style="background: #EF4444; border-color: #EF4444;"></div>
                                                        Order Cancelled
                                                    </div>
                                                     <% } else if (currentStatus==='Return Pending' ) { %>
                                                         <div class="timeline-item active" style="color: #F59E0B;">
                                                             <div class="timeline-dot"
                                                                 style="background: #F59E0B; border-color: #F59E0B;">
                                                             </div>
                                                             Return Requested (Pending Approval)
                                                         </div>
                                                     <% } else if (currentStatus==='Returned' ) { %>
                                                         <div class="timeline-item active" style="color: #8B5CF6;">
                                                             <div class="timeline-dot"
                                                                 style="background: #8B5CF6; border-color: #8B5CF6;">
                                                             </div>
                                                             Order Returned
                                                         </div>
                                                        <% } else { %>
                                                            <% for(let i=0; i < steps.length; i++) { %>
                                                                <div
                                                                    class="timeline-item <%= i <= activeIndex ? 'active' : '' %>">
                                                                    <div class="timeline-dot"></div>
                                                                    <%= steps[i].label %>
                                                                </div>
                                                                <% } %>
                                                                    <% } %>
                                            </div>
                                    </div>
                                </div>

                                <!-- Right Column -->
                                <div class="col-right">
                                    <div class="items-box">
                                        <div class="section-title">ORDER DETAILS</div>
                                        <% order.items.forEach(item=> { %>
                                            <div class="item-row">
                                                <div class="item-image">
                                                    <% let itemImage='/public/placeholder.png' ; if (item.variantId &&
                                                        item.variantId.image && item.variantId.image.length> 0) {
                                                        itemImage = item.variantId.image[0].replace(/\\/g, '/');
                                                        if (!itemImage.startsWith('http') && !itemImage.startsWith('/'))
                                                        itemImage = '/' + itemImage;
                                                        } else if (item.productId && item.productId.image &&
                                                        item.productId.image.length > 0) {
                                                        itemImage = item.productId.image[0].replace(/\\/g, '/');
                                                        if (!itemImage.startsWith('http') && !itemImage.startsWith('/'))
                                                        itemImage = '/' + itemImage;
                                                        }
                                                        %>
                                                        <img src="<%= itemImage %>" alt="<%= item.name %>">
                                                </div>
                                                <div class="item-info">
                                                    <div class="item-name">
                                                        <%= item.name %>
                                                    </div>
                                                    <div class="item-meta">
                                                        Size : <%= item.variantId ? item.variantId.size : 'N/A' %> | Qty
                                                            : <%= item.quantity %>
                                                    </div>
                                                    <div
                                                        style="font-size: 13px; color: #374151; display: flex; gap: 20px; margin-top: 5px;">
                                                        <span>Price: ₹<%= item.price.toLocaleString() %></span>
                                                        <span>Tax: ₹0</span>
                                                        <span style="font-weight: 700;">Total: ₹<%= (item.price *
                                                                item.quantity).toLocaleString() %></span>
                                                    </div>
                                                </div>
                                                <div class="item-actions">
                                                     <% if (item.status === 'Cancelled') { %>
                                                         <span style="color: #EF4444; font-size: 11px; font-weight: 700; text-transform: uppercase;">Cancelled</span>
                                                     <% } else if (item.status === 'Return Pending') { %>
                                                         <span style="color: #F59E0B; font-size: 11px; font-weight: 700; text-transform: uppercase;">Return Pending</span>
                                                     <% } else if (item.status === 'Returned') { %>
                                                         <span style="color: #8B5CF6; font-size: 11px; font-weight: 700; text-transform: uppercase;">Returned</span>
                                                     <% } else if (order.orderStatus==='Placed' ||
                                                         order.orderStatus==='Processing' ||
                                                         order.orderStatus==='Pending' || order.orderStatus==='Confirmed'
                                                         ) { %>
                                                         <button class="btn-action btn-cancel"
                                                             onclick="cancelItem('<%= order._id %>', '<%= item._id %>')">Cancel
                                                             Product</button>
                                                         <% } else if (order.orderStatus==='Delivered' ) { %>
                                                             <button class="btn-action btn-return"
                                                                 onclick="returnOrderItem('<%= order._id %>', '<%= item._id %>')">Return
                                                                 This Item</button>
                                                             <% } %>
                                                 </div>
                                            </div>
                                            <% }) %>
                                    </div>

                                    <div class="summary-box">
                                        <div class="summary-row">
                                            <span>Subtotal</span>
                                            <span>₹<%= order.subtotal.toLocaleString() %></span>
                                        </div>
                                        <div class="summary-row green">
                                            <span>Discount</span>
                                            <span>-₹<%= order.discountAmount.toLocaleString() %></span>
                                        </div>
                                        <div class="summary-row green">
                                            <span>Shipping Charges</span>
                                            <span>Free</span>
                                        </div>
                                        <div class="summary-row total">
                                            <span>Total paid</span>
                                            <span>₹<%= order.totalAmount.toLocaleString() %></span>
                                        </div>
                                    </div>

                                    <a href="/profile/orders" class="btn-go-orders">Go to My Order</a>
                                    <a href="/profile/orders/<%= order._id %>/invoice" target="_blank"
                                        class="btn-invoice">Download Invoice <i data-lucide="download"
                                            style="width: 16px; height: 16px; display: inline-block; vertical-align: middle; margin-left: 5px;"></i></a>
                                     <% if (order.orderStatus==='Placed' ||
                                         order.orderStatus==='Processing' ||
                                         order.orderStatus==='Pending' || order.orderStatus==='Confirmed'
                                         ) { %>
                                         <button onclick="cancelOrder('<%= order._id %>')" 
                                             class="btn-action btn-cancel" 
                                             style="display: block; width: 100%; padding: 16px; margin-top: 15px; text-align: center; border-radius: 4px; font-size: 13px; font-weight: 700; text-transform: uppercase; border: none; cursor: pointer;">
                                             Cancel Entire Order
                                         </button>
                                     <% } %>
                                     <% if (order.orderStatus==='Delivered') { %>
                                         <button onclick="returnOrder('<%= order._id %>')" 
                                             class="btn-action btn-return" 
                                             style="display: block; width: 100%; padding: 16px; margin-top: 15px; text-align: center; border-radius: 4px; font-size: 13px; font-weight: 700; text-transform: uppercase; border: none; cursor: pointer;">
                                             Return Entire Order
                                         </button>
                                     <% } %>
                                 </div>
                             </div>
                    </div>
                </section>
            </main>

            <%- include('partials/footer') %>

                <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
                <script>
                    lucide.createIcons();

                    async function cancelOrder(orderId) {
                        const result = await Swal.fire({
                            title: 'Cancel Order?',
                            text: "Are you sure you want to cancel this order?",
                            icon: 'warning',
                            showCancelButton: true,
                            confirmButtonColor: '#EF4444',
                            cancelButtonColor: '#6B7280',
                            confirmButtonText: 'Yes, Cancel it!'
                        });

                        if (result.isConfirmed) {
                            try {
                                const response = await fetch(`/profile/orders/${orderId}/cancel`, {
                                    method: 'PATCH',
                                    headers: { 'Content-Type': 'application/json' }
                                });
                                const data = await response.json();
                                if (data.success) {
                                    await Swal.fire('Cancelled!', data.message, 'success');
                                    location.reload();
                                } else {
                                    Swal.fire('Error', data.message, 'error');
                                }
                            } catch (error) {
                                Swal.fire('Error', 'Something went wrong', 'error');
                            }
                        }
                    }

                    async function returnOrder(orderId) {
                        const { value: reason } = await Swal.fire({
                            title: 'Return Entire Order?',
                            input: 'textarea',
                            inputLabel: 'Reason for return',
                            inputPlaceholder: 'Please tell us why you are returning this order...',
                            inputAttributes: {
                                'aria-label': 'Type your reason here'
                            },
                            showCancelButton: true,
                            confirmButtonColor: '#F59E0B',
                            cancelButtonColor: '#6B7280',
                            confirmButtonText: 'Submit Return',
                            inputValidator: (value) => {
                                if (!value) {
                                    return 'You need to provide a reason!'
                                }
                            }
                        });

                        if (reason) {
                            try {
                                const response = await fetch(`/profile/orders/${orderId}/return`, {
                                    method: 'PATCH',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({ reason })
                                });
                                const data = await response.json();
                                if (data.success) {
                                    await Swal.fire('Return Initiated!', data.message, 'success');
                                    location.reload();
                                } else {
                                    Swal.fire('Error', data.message, 'error');
                                }
                            } catch (error) {
                                Swal.fire('Error', 'Something went wrong', 'error');
                            }
                        }
                    }

                    async function returnOrderItem(orderId, itemId) {
                        const { value: reason } = await Swal.fire({
                            title: 'Return This Item?',
                            input: 'textarea',
                            inputLabel: 'Reason for return',
                            inputPlaceholder: 'Please tell us why you are returning this item...',
                            inputAttributes: {
                                'aria-label': 'Type your reason here'
                            },
                            showCancelButton: true,
                            confirmButtonColor: '#F59E0B',
                            cancelButtonColor: '#6B7280',
                            confirmButtonText: 'Submit Return',
                            inputValidator: (value) => {
                                if (!value) {
                                    return 'You need to provide a reason!'
                                }
                            }
                        });

                        if (reason) {
                            try {
                                const response = await fetch(`/profile/orders/${orderId}/return-item`, {
                                    method: 'PATCH',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({ itemId, reason })
                                });
                                const data = await response.json();
                                if (data.success) {
                                    await Swal.fire('Return Initiated!', data.message, 'success');
                                    location.reload();
                                } else {
                                    Swal.fire('Error', data.message, 'error');
                                }
                            } catch (error) {
                                Swal.fire('Error', 'Something went wrong', 'error');
                            }
                        }
                    }

                    async function cancelItem(orderId, itemId) {
                        const { value: reason } = await Swal.fire({
                            title: 'Cancel Product?',
                            input: 'textarea',
                            inputLabel: 'Reason for cancellation',
                            inputPlaceholder: 'Please tell us why you are cancelling this product...',
                            inputAttributes: {
                                'aria-label': 'Type your reason here'
                            },
                            showCancelButton: true,
                            confirmButtonColor: '#EF4444',
                            cancelButtonColor: '#6B7280',
                            confirmButtonText: 'Yes, Cancel it!',
                            inputValidator: (value) => {
                                if (!value) {
                                    return 'You need to provide a reason!'
                                }
                            }
                        });

                        if (reason) {
                            try {
                                const response = await fetch(`/profile/orders/${orderId}/cancel-item`, {
                                    method: 'PATCH',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({ itemId, reason })
                                });
                                const data = await response.json();
                                if (data.success) {
                                    await Swal.fire('Cancelled!', data.message, 'success');
                                    location.reload();
                                } else {
                                    Swal.fire('Error', data.message, 'error');
                                }
                            } catch (error) {
                                Swal.fire('Error', 'Something went wrong', 'error');
                            }
                        }
                    }
                </script>
    </body>

</html>