<!DOCTYPE html>
<html lang="en">

<%- include('partials/head') %>
    <style>
        .profile-page {
            padding: 80px 20px;
            min-height: 100vh;
        }

        .profile-container {
            max-width: 1200px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 250px 1fr;
            gap: 40px;
        }

        /* Sidebar Styles */
        .profile-sidebar {
            background: #FFFFFF;
            border: 1px solid #E5E7EB;
            border-radius: 4px;
            padding: 0;
            height: fit-content;
            position: sticky;
            top: 100px;
        }

        .sidebar-header {
            background: #000;
            color: #FFF;
            padding: 20px;
            font-weight: 700;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-radius: 4px 4px 0 0;
        }

        .sidebar-menu {
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .sidebar-menu li {
            border-bottom: 1px solid #E5E7EB;
        }

        .sidebar-menu a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 16px 20px;
            color: #374151;
            text-decoration: none;
            font-weight: 500;
            font-size: 14px;
            transition: var(--transition);
        }

        .sidebar-menu a.active {
            background: #F3F4F6;
            color: #000;
            border-left: 3px solid #000;
        }

        /* Main Content Layout */
        .order-details-wrapper {
            background: #FFF;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
        }

        .col-left,
        .col-right {
            display: flex;
            flex-direction: column;
            gap: 30px;
        }

        .section-title {
            font-size: 16px;
            font-weight: 700;
            color: #000;
            text-transform: uppercase;
            margin-bottom: 15px;
            letter-spacing: 0.5px;
        }

        /* Order Info */
        .order-meta-info {
            font-size: 13px;
            color: #6B7280;
            margin-bottom: 20px;
        }

        .order-meta-info span {
            color: #EF4444;
            /* red color for Order ID in design */
            font-weight: 600;
        }

        /* Delivery Address Box */
        .address-box {
            border: 1px solid #E5E7EB;
            padding: 20px;
            border-radius: 4px;
        }

        .address-name {
            font-size: 14px;
            font-weight: 700;
            color: #000;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .address-type {
            background: #E5E7EB;
            font-size: 10px;
            padding: 2px 8px;
            border-radius: 20px;
            text-transform: uppercase;
        }

        .address-details {
            font-size: 13px;
            color: #6B7280;
            line-height: 1.6;
        }

        .address-details strong {
            color: #000;
        }

        /* Timeline */
        .timeline {
            margin-top: 10px;
            position: relative;
            padding-left: 20px;
        }

        .timeline::before {
            content: '';
            position: absolute;
            left: 5px;
            top: 5px;
            bottom: 5px;
            width: 2px;
            background: #E5E7EB;
        }

        .timeline-item {
            position: relative;
            margin-bottom: 25px;
            font-size: 13px;
            color: #6B7280;
        }

        .timeline-item:last-child {
            margin-bottom: 0;
        }

        .timeline-item.active {
            color: #10B981;
            font-weight: 700;
        }

        .timeline-dot {
            position: absolute;
            left: -20px;
            top: 3px;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: #FFF;
            border: 2px solid #E5E7EB;
            z-index: 1;
        }

        .timeline-item.active .timeline-dot {
            background: #10B981;
            border-color: #10B981;
        }

        /* Right Column Items */
        .items-box {
            border: 1px solid #E5E7EB;
            border-radius: 4px;
            padding: 20px;
        }

        .item-row {
            display: flex;
            align-items: center;
            padding: 20px 0;
            border-bottom: 1px solid #F3F4F6;
        }

        .item-row:first-child {
            padding-top: 0;
        }

        .item-row:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

        .item-image {
            width: 60px;
            height: 60px;
            margin-right: 15px;
            flex-shrink: 0;
        }

        .item-image img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        .item-info {
            flex: 1;
        }

        .item-name {
            font-size: 14px;
            font-weight: 600;
            color: #000;
            margin-bottom: 4px;
        }

        .item-meta {
            font-size: 12px;
            color: #6B7280;
            margin-bottom: 8px;
        }

        .item-price {
            font-size: 13px;
            font-weight: 700;
        }

        .item-price strike {
            color: #9CA3AF;
            font-size: 11px;
            margin-left: 5px;
        }

        .item-actions {
            display: flex;
            gap: 10px;
        }

        .btn-action {
            padding: 8px 16px;
            border-radius: 4px;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            border: none;
            cursor: pointer;
            color: #FFF;
            letter-spacing: 0.3px;
            transition: opacity 0.2s;
        }

        .btn-action:hover {
            opacity: 0.85;
        }

        .btn-cancel {
            background: #EF4444;
        }

        .btn-return {
            background: #F59E0B;
        }

        /* Summary Box */
        .summary-box {
            background: #F9FAFB;
            padding: 30px;
            border-radius: 4px;
            display: flex;
            flex-direction: column;
            gap: 15px;
            font-size: 13px;
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            color: #374151;
            font-weight: 600;
        }

        .summary-row.green {
            color: #10B981;
        }

        .summary-row.total {
            margin-top: 10px;
            padding-top: 20px;
            border-top: 1px solid #E5E7EB;
            font-size: 16px;
            color: #000;
        }

        .btn-go-orders {
            display: block;
            width: 100%;
            padding: 16px;
            background: #A89595;
            color: #FFF;
            text-align: center;
            text-transform: uppercase;
            font-weight: 700;
            border-radius: 4px;
            text-decoration: none;
            transition: background 0.2s;
        }

        .btn-go-orders:hover {
            background: #8B7373;
        }

        .btn-invoice {
            display: block;
            width: 100%;
            padding: 16px;
            background: #F3F4F6;
            color: #374151;
            text-align: center;
            text-transform: uppercase;
            font-weight: 700;
            border-radius: 4px;
            text-decoration: none;
            transition: background 0.2s;
            margin-top: 15px;
            border: 1px solid #E5E7EB;
        }

        .btn-invoice:hover {
            background: #E5E7EB;
        }

        @media (max-width: 992px) {
            .order-details-wrapper {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 768px) {
            .profile-container {
                grid-template-columns: 1fr;
            }
        }
    </style>
    </head>

    <body>
        <%- include('partials/header') %>

            <main class="container">
                <section class="profile-page">
                    <div class="profile-container">
                        <%- include('partials/user-sidebar', { activePage: 'orders' }) %>

                            <div class="order-details-wrapper">
                                <!-- Left Column -->
                                <div class="col-left">
                                    <div>
                                        <div class="section-title">ORDER SUMMARY</div>
                                        <div class="order-meta-info">
                                            Order ID: <span>#<%= order.orderId %></span> | Placed on: <%= new
                                                Date(order.createdAt).toLocaleDateString('en-GB', { day: 'numeric' ,
                                                month: 'long' , year: 'numeric' }) %>
                                        </div>
                                    </div>

                                    <div>
                                        <div class="section-title">DELIVERY ADDRESS</div>
                                        <div class="address-box">
                                            <div class="address-name">
                                                <%= order.shippingAddress.name %> <span class="address-type">HOME</span>
                                            </div>
                                            <div class="address-details">
                                                <%= order.shippingAddress.addressLine %>, <br>
                                                    <%= order.shippingAddress.city %>, <%=
                                                            order.shippingAddress.district %>, <br>
                                                            <%= order.shippingAddress.state %> - <%=
                                                                    order.shippingAddress.pincode %> <br><br>
                                                                    <strong>Mobile:</strong>
                                                                    <%= order.shippingAddress.mobile %>
                                            </div>
                                        </div>
                                    </div>

                                    <div>
                                        <div class="section-title">ORDER STATUS</div>
                                        <% const steps=[ { key: 'Pending' , label: 'Order Placed' }, { key: 'Confirmed'
                                            , label: 'Order Confirmed' }, { key: 'Shipped' , label: 'Shipped' }, {
                                            key: 'Out for Delivery' , label: 'Out for Delivery' }, { key: 'Delivered' ,
                                            label: 'Delivered' } ]; const currentStatus=order.orderStatus; let
                                            activeIndex=steps.findIndex(s=> s.key === currentStatus);
                                            if (currentStatus === 'Placed') activeIndex = 0;
                                            if (currentStatus === 'Processing') activeIndex = 1;
                                            %>

                                            <div class="timeline">
                                                <% if (currentStatus==='Cancelled' ) { %>
                                                    <div class="timeline-item active" style="color: #EF4444;">
                                                        <div class="timeline-dot"
                                                            style="background: #EF4444; border-color: #EF4444;"></div>
                                                        Order Cancelled
                                                    </div>
                                                     <% } else if (currentStatus==='Return Pending' ) { %>
                                                         <div class="timeline-item active" style="color: #F59E0B;">
                                                             <div class="timeline-dot"
                                                                 style="background: #F59E0B; border-color: #F59E0B;">
                                                             </div>
                                                             Return Requested (Pending Approval)
                                                         </div>
                                                     <% } else if (currentStatus==='Returned' ) { %>
                                                         <div class="timeline-item active" style="color: #8B5CF6;">
                                                             <div class="timeline-dot"
                                                                 style="background: #8B5CF6; border-color: #8B5CF6;">
                                                             </div>
                                                             Order Returned
                                                         </div>
                                                        <% } else { %>
                                                            <% for(let i=0; i < steps.length; i++) { %>
                                                                <div
                                                                    class="timeline-item <%= i <= activeIndex ? 'active' : '' %>">
                                                                    <div class="timeline-dot"></div>
                                                                    <%= steps[i].label %>
                                                                </div>
                                                                <% } %>
                                                                    <% } %>
                                            </div>
                                    </div>
                                </div>

                                <!-- Right Column -->
                                <div class="col-right">
                                    <div class="items-box">
                                        <div class="section-title">ORDER DETAILS</div>
                                        <% order.items.forEach(item=> { %>
                                            <% const itemIsDelivered = item.status === 'Delivered' || order.orderStatus === 'Delivered'; %>
                                            <div class="item-row">
                                                <div class="item-image">
                                                    <% let itemImage='/public/apple_smart_2.png' ; if (item.variantId &&
                                                        item.variantId.image && item.variantId.image.length> 0) {
                                                        itemImage = item.variantId.image[0].replace(/\\/g, '/');
                                                        if (!itemImage.startsWith('http') && !itemImage.startsWith('/'))
                                                        itemImage = '/' + itemImage;
                                                        } else if (item.productId && item.productId.image &&
                                                        item.productId.image.length > 0) {
                                                        itemImage = item.productId.image[0].replace(/\\/g, '/');
                                                        if (!itemImage.startsWith('http') && !itemImage.startsWith('/'))
                                                        itemImage = '/' + itemImage;
                                                        }
                                                        %>
                                                        <img src="<%= itemImage %>" alt="<%= item.name %>">
                                                </div>
                                                <div class="item-info">
                                                    <div class="item-name">
                                                        <%= item.name %>
                                                    </div>
                                                    <div class="item-meta">
                                                        Color : <%= item.variantId ? item.variantId.color : 'N/A' %> | Qty
                                                            : <%= item.quantity %>
                                                    </div>
                                                    <div
                                                        style="font-size: 13px; color: #374151; display: flex; gap: 20px; margin-top: 5px;">
                                                        <span>Price: ₹<%= item.price.toLocaleString() %></span>
                                                        <span>Tax: ₹0</span>
                                                        <span style="font-weight: 700;">Total: ₹<%= (item.price *
                                                                item.quantity).toLocaleString() %></span>
                                                    </div>
                                                </div>
                                                <div class="item-actions" style="display: flex; flex-direction: column; gap: 8px; align-items: flex-end;">
                                                    <%
                                                        const isCancelledItem = item.status === 'Cancelled';
                                                        const isReturnPendingItem = item.status === 'Return Pending';
                                                        const isReturnedItem = item.status === 'Returned';
                                                        const isActiveItem = !isCancelledItem && !isReturnPendingItem && !isReturnedItem;
                                                        const orderCancellable = ['Placed', 'Processing', 'Pending', 'Confirmed'].includes(order.orderStatus);
                                                        const itemCanReturn = typeof canReturnOrderItem === 'function' && canReturnOrderItem(order, item);
                                                    %>

                                                    <%# Show terminal status labels %>
                                                    <% if (isCancelledItem) { %>
                                                        <span style="color: #EF4444; font-size: 11px; font-weight: 700; text-transform: uppercase; padding: 4px 10px; background: #FEE2E2; border-radius: 20px;">✕ Cancelled</span>
                                                    <% } else if (isReturnPendingItem) { %>
                                                        <span style="color: #92400E; font-size: 11px; font-weight: 700; text-transform: uppercase; padding: 4px 10px; background: #FEF3C7; border-radius: 20px;">⏳ Return Pending</span>
                                                    <% } else if (isReturnedItem) { %>
                                                        <span style="color: #8B5CF6; font-size: 11px; font-weight: 700; text-transform: uppercase; padding: 4px 10px; background: #EDE9FE; border-radius: 20px;">✓ Returned</span>
                                                    <% } %>

                                                    <%# Show action buttons for active items %>
                                                    <% if (isActiveItem) { %>

                                                        <%# Cancel button: only if order is in a cancellable state %>
                                                        <% if (orderCancellable) { %>
                                                            <button class="btn-action btn-cancel"
                                                                onclick="cancelItem('<%= order._id %>', '<%= item._id %>')"
                                                                style="font-size: 11px; padding: 6px 14px;">
                                                                Cancel Product
                                                            </button>
                                                        <% } %>

                                                        <%# Return button: only if item is returnable %>
                                                        <% if (itemCanReturn) { %>
                                                            <button class="btn-action btn-return"
                                                                onclick="returnOrderItem('<%= order._id %>', '<%= item._id %>')"
                                                                style="font-size: 11px; padding: 6px 14px;">
                                                                Return This Item
                                                            </button>
                                                        <% } %>

                                                        <%# Rate product: only if delivered and no other action shown %>
                                                        <% if (itemIsDelivered && !orderCancellable && !itemCanReturn) { %>
                                                            <a class="btn-action" href="/product/<%= item.productId ? item.productId._id : '' %>#reviews" style="text-decoration:none; font-size: 11px; padding: 6px 14px;">Rate Product</a>
                                                        <% } %>

                                                    <% } %>
                                                </div>
                                            </div>
                                            <% }) %>
                                    </div>

                                    <div class="summary-box">
                                        <%
                                            const activeItems = (order.items || []).filter(item => !['Cancelled', 'Returned'].includes(item.status));
                                            const activeSubtotal = activeItems.reduce((sum, item) => sum + ((item.price || 0) * (item.quantity || 0)), 0);
                                            const safeOriginalSubtotal = Number(order.subtotal) || 0;
                                            const safeOriginalDiscount = Number(order.discountAmount) || 0;
                                            const displayDiscountAmount = safeOriginalSubtotal > 0 && safeOriginalDiscount > 0
                                                ? Math.max(0, Math.round((activeSubtotal / safeOriginalSubtotal) * safeOriginalDiscount))
                                                : 0;
                                            const displayOrderTotal = Math.max(0, activeSubtotal - displayDiscountAmount);
                                        %>
                                        <div class="summary-row">
                                            <span>Subtotal</span>
                                            <span>₹<%= activeSubtotal.toLocaleString() %></span>
                                        </div>
                                        <div class="summary-row green">
                                            <span>Discount</span>
                                            <span>-₹<%= displayDiscountAmount.toLocaleString() %></span>
                                        </div>
                                        <div class="summary-row green">
                                            <span>Shipping Charges</span>
                                            <span>Free</span>
                                        </div>
                                        <div class="summary-row total">
                                            <span>Total paid</span>
                                            <span>₹<%= displayOrderTotal.toLocaleString() %></span>
                                        </div>
                                    </div>

                                    <a href="/profile/orders" class="btn-go-orders">Go to My Order</a>
                                    <a href="/profile/orders/<%= order._id %>/invoice" target="_blank"
                                        class="btn-invoice">Download Invoice <i data-lucide="download"
                                            style="width: 16px; height: 16px; display: inline-block; vertical-align: middle; margin-left: 5px;"></i></a>
                                     <% if (order.orderStatus==='Placed' ||
                                         order.orderStatus==='Processing' ||
                                         order.orderStatus==='Pending' || order.orderStatus==='Confirmed'
                                         ) { %>
                                         <button onclick="cancelOrder('<%= order._id %>')" 
                                             class="btn-action btn-cancel" 
                                             style="display: block; width: 100%; padding: 16px; margin-top: 15px; text-align: center; border-radius: 4px; font-size: 13px; font-weight: 700; text-transform: uppercase; border: none; cursor: pointer;">
                                             Cancel Entire Order
                                         </button>
                                     <% } %>
                                     <% if (typeof canReturnOrder === 'function' && canReturnOrder(order)) { %>
                                         <button onclick="returnOrder('<%= order._id %>')" 
                                             class="btn-action btn-return" 
                                             style="display: block; width: 100%; padding: 16px; margin-top: 15px; text-align: center; border-radius: 4px; font-size: 13px; font-weight: 700; text-transform: uppercase; border: none; cursor: pointer;">
                                             Return Entire Order
                                         </button>
                                     <% } %>
                                     <% if (typeof canRetryFailedOrder === 'function' && canRetryFailedOrder(order)) { %>
                                         <button onclick="retryPayment('<%= order._id %>')" 
                                             class="btn-action btn-retry" 
                                             style="display: block; width: 100%; padding: 16px; margin-top: 15px; text-align: center; border-radius: 4px; font-size: 13px; font-weight: 700; text-transform: uppercase; border: none; cursor: pointer; background: #111827; color: #FFF;">
                                             Retry Payment
                                         </button>
                                     <% } %>
                                 </div>
                             </div>
                    </div>
                </section>
            </main>

            <%- include('partials/footer') %>

                <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
                <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
                <script>
                    lucide.createIcons();
                    const cancellationReasons = [
                        'Ordered by mistake',
                        'Need to change size or color',
                        'Found a better price elsewhere',
                        'Delivery will take too long',
                        'Payment or address issue',
                        'Others'
                    ];
                    const returnReasons = [
                        'Received damaged product',
                        'Wrong item delivered',
                        'Size or fit issue',
                        'Product is not as expected',
                        'Quality issue',
                        'Others'
                    ];

                    async function promptOrderReason(type, target) {
                        const reasons = type === 'return' ? returnReasons : cancellationReasons;
                        const title = (type === 'return' ? 'Return ' : 'Cancel ') + target + '?';
                        const label = type === 'return' ? 'Reason for return' : 'Reason for cancellation';
                        const confirmText = type === 'return' ? 'Submit Return' : 'Confirm Cancellation';
                        const options = reasons.map(reason => '<option value="' + reason + '">' + reason + '</option>').join('');

                        const result = await Swal.fire({
                            title,
                            html: '<label for="reasonSelect" style="display:block;text-align:left;font-size:13px;font-weight:700;margin-bottom:8px;">' + label + '</label>' +
                                '<select id="reasonSelect" class="swal2-input" style="width:100%;margin:0 0 12px 0;box-sizing:border-box;">' +
                                '<option value="">Select a reason</option>' + options + '</select>' +
                                '<textarea id="otherReason" class="swal2-textarea" placeholder="Type your reason" style="display:none;width:100%;margin:0;box-sizing:border-box;"></textarea>',
                            showCancelButton: true,
                            confirmButtonColor: type === 'return' ? '#F59E0B' : '#EF4444',
                            cancelButtonColor: '#6B7280',
                            confirmButtonText: confirmText,
                            didOpen: () => {
                                const select = document.getElementById('reasonSelect');
                                const other = document.getElementById('otherReason');
                                select.addEventListener('change', () => {
                                    other.style.display = select.value === 'Others' ? 'block' : 'none';
                                    if (select.value !== 'Others') other.value = '';
                                });
                            },
                            preConfirm: () => {
                                const selected = document.getElementById('reasonSelect').value;
                                const other = document.getElementById('otherReason').value.trim();
                                if (!selected) {
                                    Swal.showValidationMessage('Please select a reason');
                                    return false;
                                }
                                if (selected === 'Others' && !other) {
                                    Swal.showValidationMessage('Please type your reason');
                                    return false;
                                }
                                return selected === 'Others' ? other : selected;
                            }
                        });
                        return result.value;
                    }


                    async function cancelOrder(orderId) {
                        const reason = await promptOrderReason('cancel', 'Order');

                        if (reason) {
                            try {
                                const response = await fetch('/profile/orders/' + orderId + '/cancel', {
                                    method: 'PATCH',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({ reason })
                                });
                                const data = await response.json();
                                if (data.success) {
                                    await Swal.fire('Cancelled!', data.message, 'success');
                                    location.reload();
                                } else {
                                    Swal.fire('Error', data.message, 'error');
                                }
                            } catch (error) {
                                Swal.fire('Error', 'Something went wrong', 'error');
                            }
                        }
                    }

                    async function retryPayment(orderId) {
                        try {
                            const response = await fetch(`/profile/orders/${orderId}/retry-payment`, { method: 'POST' });
                            const data = await response.json();
                            if (!data.success) {
                                return Swal.fire('Error', data.message || 'Retry is no longer available', 'error');
                            }

                            const rzp = new Razorpay({
                                key: data.key,
                                amount: data.amount,
                                currency: 'INR',
                                name: 'Trufit Smartwatches',
                                description: 'Retry payment for your order',
                                order_id: data.rzpOrderId,
                                handler: async function (paymentResponse) {
                                    const verifyResponse = await fetch('/verify-payment', {
                                        method: 'POST',
                                        headers: { 'Content-Type': 'application/json' },
                                        body: JSON.stringify({
                                            razorpay_order_id: paymentResponse.razorpay_order_id,
                                            razorpay_payment_id: paymentResponse.razorpay_payment_id,
                                            razorpay_signature: paymentResponse.razorpay_signature,
                                            orderId: data.orderId
                                        })
                                    });
                                    const verifyData = await verifyResponse.json();
                                    window.location.href = verifyData.redirectUrl || '/profile/orders';
                                },
                                modal: {
                                    ondismiss: function () {
                                        Swal.fire('Payment Pending', 'You can retry this payment again while it is available.', 'info');
                                    }
                                },
                                theme: { color: '#000000' }
                            });
                            rzp.open();
                        } catch (error) {
                            Swal.fire('Error', 'Something went wrong', 'error');
                        }
                    }

                    async function returnOrder(orderId) {
                        const reason = await promptOrderReason('return', 'Entire Order');

                        if (reason) {
                            try {
                                const response = await fetch('/profile/orders/' + orderId + '/return', {
                                    method: 'PATCH',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({ reason })
                                });
                                const data = await response.json();
                                if (data.success) {
                                    await Swal.fire('Return Initiated!', data.message, 'success');
                                    location.reload();
