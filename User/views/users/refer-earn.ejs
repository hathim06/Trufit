<!DOCTYPE html>
<html lang="en">

<%- include('partials/head') %>
    <style>
        /* Refer Page Content */
        .page-title {
            margin: 60px 0 40px;
            font-size: 24px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .refer-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 80px;
            align-items: center;
            margin-bottom: 100px;
        }

        /* Referral Code Box */
        .referral-box {
            border: 1px solid #E5E7EB;
            overflow: hidden;
            width: 100%;
            max-width: 400px;
        }

        .referral-header {
            background: #DBE4F0;
            padding: 20px;
            text-align: center;
            font-weight: 700;
            font-size: 18px;
            text-transform: uppercase;
        }

        .referral-code {
            padding: 40px;
            text-align: center;
            font-size: 36px;
            font-weight: 700;
            letter-spacing: 2px;
        }

        /* How it Works */
        .how-it-works h2 {
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 40px;
            text-transform: uppercase;
            text-align: center;
        }

        .timeline {
            display: flex;
            flex-direction: column;
            gap: 40px;
            position: relative;
            padding-left: 20px;
        }

        .timeline::before {
            content: '';
            position: absolute;
            left: 39px;
            top: 20px;
            bottom: 20px;
            width: 1px;
            background: #E5E7EB;
            z-index: 1;
        }

        .step {
            display: flex;
            align-items: flex-start;
            gap: 30px;
            position: relative;
            z-index: 2;
        }

        .step-number {
            width: 40px;
            height: 40px;
            background: var(--crimson);
            color: #FFFFFF;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            flex-shrink: 0;
        }

        .step-content h3 {
            font-size: 16px;
            font-weight: 700;
            text-transform: uppercase;
            margin-bottom: 5px;
        }

        .step-content p {
            font-size: 13px;
            color: #6B7280;
            line-height: 1.5;
        }

        /* Footer Styling */
        

        

        

        

        

        

        

        

        @media (max-width: 992px) {
            .refer-grid {
                grid-template-columns: 1fr;
                gap: 50px;
                justify-items: center;
            }
            .referral-box {
                margin: 0 auto;
            }
        }
    </style>
</head>

<body>
<%- include('partials/header') %>

    <main class="container">
        <section class="profile-page">
            <div class="profile-container">
                <%- include('partials/user-sidebar', { activePage: 'refer' }) %>

                <div class="profile-main-content">
                    <h1>REFER AND EARN</h1>

        <div class="refer-grid">
            <div class="referral-box">
                <div class="referral-header">YOUR REFERAL CODE</div>
                <div class="referral-code">FEB-1234</div>
            </div>

            <div class="how-it-works">
                <h2>HOW IT WORK</h2>
                <div class="timeline">
                    <div class="step">
                        <div class="step-number">1</div>
                        <div class="step-content">
                            <h3>SHARE YOUR CODE</h3>
                            <p>Send Your Unique Link Or Code To Friends</p>
                        </div>
                    </div>
                    <div class="step">
                        <div class="step-number">2</div>
                        <div class="step-content">
                            <h3>FRIEND SIGN UP & SHOPS</h3>
                            <p>You Get An Amount And Will Be Stored To The Wallet</p>
                        </div>
                    </div>
                    <div class="step">
                        <div class="step-number">3</div>
                        <div class="step-content">
                            <h3>YOU GET THE REWARD</h3>
                            <p>You Get Reward To Your Wallet</p>
                        </div>
                    </div>
                </div>
            </div>
                </div> <!-- profile-main-content -->
            </div> <!-- profile-container -->
        </section>
    </main>

    <%- include('partials/footer') %>

    <script>
        lucide.createIcons();
    </script>
</body>

</html>
