                    async function retryPayment(event, orderId) {
                        event.stopPropagation();

                        try {
                            const response = await fetch(`/profile/orders/${orderId}/retry-payment`, { method: 'POST' });
                            const data = await response.json();
                            if (!data.success) {
                                return Swal.fire('Error', data.message || 'Retry is no longer available', 'error');
                            }

                            const rzp = new Razorpay({
                                key: data.key,
                                amount: data.amount,
                                currency: 'INR',
                                name: 'Trufit Smartwatches',
                                description: 'Retry payment for your order',
                                order_id: data.rzpOrderId,
                                handler: async function (paymentResponse) {
                                    const verifyResponse = await fetch('/verify-payment', {
                                        method: 'POST',
                                        headers: { 'Content-Type': 'application/json' },
                                        body: JSON.stringify({
                                            razorpay_order_id: paymentResponse.razorpay_order_id,
                                            razorpay_payment_id: paymentResponse.razorpay_payment_id,
                                            razorpay_signature: paymentResponse.razorpay_signature,
                                            orderId: data.orderId
                                        })
                                    });
                                    const verifyData = await verifyResponse.json();
                                    window.location.href = verifyData.redirectUrl || '/profile/orders';
                                },
                                modal: {
                                    ondismiss: function () {
                                        Swal.fire('Payment Pending', 'You can retry this payment again while it is available.', 'info');
                                    }
                                },
                                theme: { color: '#000000' }
                            });
                            rzp.open();
                        } catch (error) {
                            Swal.fire('Error', 'Something went wrong', 'error');
                        }
                    }
                </script>
    </body>

