<%- include('partials/head') %>
<body>
    <%- include('partials/sidebar', { activePage: 'coupons' }) %>

    <main class="main-content">
        <!-- Mock internal header from screenshot -->
        <div style="background: #FFF; padding: 20px; border-radius: 12px; margin-bottom: 30px; display: flex; justify-content: center; align-items: center; flex-direction: column; position: relative; border: 1px solid var(--border);">
            <div style="display: flex; align-items: center; gap: 10px;">
                <i data-lucide="watch" style="width: 24px;"></i>
                <div style="font-weight: 700;">Trufit</div>
            </div>
            <div style="font-size: 12px; letter-spacing: 2px;">SMART WATCH</div>
            <i data-lucide="log-out" style="position: absolute; right: 20px; top: 20px; width: 18px; color: #666; cursor: pointer;"></i>
        </div>

        <div style="text-align: center; margin-bottom: 40px;">
            <h1 class="page-title">ADD COUPONS</h1>
        </div>

        <div class="table-container" style="max-width: 800px; margin: 0 auto; padding: 40px;">
            <% if (typeof errors !== 'undefined' && errors && errors.length) { %>
                <div style="background: #FEE2E2; color: #991B1B; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; font-size: 13px; line-height: 1.6;">
                    <% errors.forEach(error => { %><div><%= error %></div><% }) %>
                </div>
            <% } else if (message) { %>
                <p style="background: #FEE2E2; color: #DC2626; padding: 10px; border-radius: 6px; text-align: center; margin-bottom: 20px;"><%= message %></p>
            <% } %>
            <form action="/admin/add-coupon" method="POST">
                <div class="form-group">
                    <label>COUPON CODE</label>
                    <input type="text" name="couponCode" placeholder="Enter coupon code" value="<%= formData.couponCode || '' %>" required minlength="3" maxlength="20" pattern="[A-Za-z0-9_-]+" title="Use letters, numbers, hyphen, or underscore only">
                </div>

                <div class="form-group">
                    <label>COUPON DESCRIPTION</label>
                    <textarea name="description" class="description-area" style="min-height: 100px;" required minlength="5" maxlength="200"><%= formData.description || '' %></textarea>
                </div>

                <div class="form-grid">
                    <div class="form-group">
                        <label>START DATE</label>
                        <input type="date" name="startDate" value="<%= formData.startDate || '' %>" required>
                    </div>
                    <div class="form-group">
                        <label>EXPIRY DATE</label>
                        <input type="date" name="expiryDate" value="<%= formData.expiryDate || '' %>" required>
                    </div>
                </div>

                <div class="form-grid">
                    <div class="form-group">
                        <label>MINIMUM PURCHASE AMOUNT</label>
                        <input type="number" name="minPurchase" placeholder="Enter amount" value="<%= formData.minPurchase || '' %>" required min="0" step="0.01">
                    </div>
                    <div class="form-group">
                        <label>STATUS</label>
                        <select name="status">
                            <option value="Active" <%= formData.status === 'Active' ? 'selected' : '' %>>Active</option>
                            <option value="Inactive" <%= formData.status === 'Inactive' ? 'selected' : '' %>>Inactive</option><option value="Expired" <%= formData.status === 'Expired' ? 'selected' : '' %>>Expired</option>
                        </select>
                    </div>
                </div>

                <div class="form-grid">
                    <div class="form-group">
                        <label>DISCOUNT TYPE</label>
                        <select name="discountType" id="discountType">
                            <option value="percentage" <%= (formData.discountType || 'percentage') === 'percentage' ? 'selected' : '' %>>Percentage</option>
                            <option value="flat" <%= (formData.discountType || 'percentage') === 'flat' ? 'selected' : '' %>>Flat Amount</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label id="discountLabel">DISCOUNT VALUE</label>
                        <input type="number" id="discountValue" name="discountValue" placeholder="Enter value" value="<%= formData.discountValue || formData.discount || '' %>" required min="1" step="0.01">
                    </div>
                </div>

                <div class="form-grid">
                    <div class="form-group">
                        <label>MAX DISCOUNT LIMIT</label>
                        <input type="number" name="maxDiscountAmount" placeholder="Enter max amount" value="<%= formData.maxDiscountAmount || '' %>" required min="0" step="0.01">
                    </div>
                </div>

                <div class="form-grid">
                    <div class="form-group">
                        <label>TOTAL COUPONS AVAILABLE</label>
                        <input type="number" name="maxUsage" value="<%= formData.maxUsage || 100 %>" required min="1">
                    </div>
                    <div class="form-group">
                        <label>PER USER LIMIT</label>
                        <input type="number" name="perUserLimit" value="<%= formData.perUserLimit || 1 %>" required min="1">
                    </div>
                </div>

                <div style="display: flex; justify-content: center; margin-top: 40px;">
                    <button type="submit" class="btn btn-primary" style="padding: 12px 60px;">SAVE COUPON</button>
                </div>
            </form>
        </div>
    </main>

    <script>
        lucide.createIcons();

        const discountType = document.getElementById('discountType');
        const discountLabel = document.getElementById('discountLabel');
        const discountValue = document.getElementById('discountValue');

        function syncDiscountLabel() {
            const isFlat = discountType.value === 'flat';
            discountLabel.textContent = isFlat ? 'DISCOUNT AMOUNT' : 'DISCOUNT VALUE';
            discountValue.placeholder = isFlat ? 'Enter flat amount' : 'Enter percentage';
            discountValue.setAttribute('max', isFlat ? '' : '90');
        }

        if (discountType) {
            discountType.addEventListener('change', syncDiscountLabel);
            syncDiscountLabel();
        }
    </script>
</body>
</html>


