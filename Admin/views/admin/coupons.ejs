<%- include('partials/head') %>
<body>
    <%- include('partials/sidebar', { activePage: 'coupons' }) %>

    <main class="main-content">
        <header class="page-header">
            <h1 class="page-title">COUPON MANAGEMENT</h1>
            <button class="btn btn-primary" onclick="location.href='/admin/add-coupon'">ADD COUPON</button>
        </header>

        <div class="filter-bar" style="display: flex; gap: 15px; align-items: center; margin-bottom: 30px;">
            <div style="position: relative; flex: 1; max-width: 500px;">
                <input type="text" class="search-input" placeholder="Search Coupons..." value="<%= typeof searchTerm !== 'undefined' ? searchTerm : (typeof searchItem !== 'undefined' ? searchItem : '') %>" style="width: 100%; padding-right: 36px;">
                <% if (typeof searchTerm !== 'undefined' && searchTerm) { %>
                    <button onclick="clearSearch()" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: #9CA3AF; display: block;">✕</button>
                <% } else { %>
                    <button onclick="clearSearch()" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: #9CA3AF; display: none;">✕</button>
                <% } %>
            </div>
            <select id="statusFilter" class="search-input" style="max-width: 200px;">
                <option value="">All Status</option>
                <option value="Active" <%= typeof status !== 'undefined' && status === 'Active' ? 'selected' : '' %>>Active</option>
                <option value="Expired" <%= typeof status !== 'undefined' && status === 'Expired' ? 'selected' : '' %>>Expired</option>
                <option value="Inactive" <%= typeof status !== 'undefined' && status === 'Inactive' ? 'selected' : '' %>>Inactive</option>
            </select>
        </div>

        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>COUPON NAME</th>
                        <th>OFFER UPTO</th>
                        <th>STARTING DATE</th>
                        <th>EXPIRY DATE</th>
                        <th>ACTION</th>
                        <th>USED</th>
                        <th>AVAILABLE</th>
                        <th>MAX DISCOUNT</th>
                        <th>MAX</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (typeof coupons !== 'undefined' && coupons && coupons.length > 0) { %>
                        <% coupons.forEach((coupon, index) => { %>
                            <tr>
                                <td><%= index + 1 + (currentPage - 1) * limit %></td>
                                <td><strong><%= coupon.couponCode %></strong><br><small><%= coupon.description %></small></td>
                                <td><%= coupon.discountType === 'flat' ? `Rs. ${Number(coupon.discountValue ?? coupon.discountPercentage ?? 0).toLocaleString()} Off` : `${coupon.discountPercentage ?? coupon.discountValue ?? 0}% Off` %> (Min: Rs. <%= coupon.minPurchase %>)</td>
                                <td><%= new Date(coupon.startDate).toLocaleDateString() %></td>
                                <td><%= new Date(coupon.expiryDate).toLocaleDateString() %></td>
                                <td>
                                    <div class="action-btns">
                                        <button class="action-btn" onclick="location.href='/admin/edit-coupon/<%= coupon._id %>'"><i data-lucide="edit-3"></i></button>
                                        <button class="action-btn" onclick="deleteCoupon('<%= coupon._id %>')"><i data-lucide="trash-2"></i></button>
                                    </div>
                                </td>
                                <td><%= coupon.usedCount ?? coupon.usageCount ?? 0 %></td>
                                <td><%= coupon.availableCount ?? Math.max((coupon.maxUsageCount ?? coupon.maxUsage ?? 0) - (coupon.usedCount ?? coupon.usageCount ?? 0), 0) %></td>
                                <td>Rs. <%= (coupon.maxDiscountAmount || 0).toLocaleString() %></td>
                                <td><%= coupon.maxUsageCount ?? coupon.maxUsage ?? 0 %></td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="10" style="text-align: center; padding: 40px; color: #6B7280;">No coupons found. Click "ADD COUPON" to create one.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>

            <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
                <div style="margin-top: 30px; display: flex; justify-content: center; align-items: center; gap: 10px; padding-bottom: 20px;">
                    <% if (currentPage > 1) { %>
                        <a href="/admin/coupons?page=<%= currentPage - 1 %>&search=<%= typeof searchTerm !== 'undefined' ? searchTerm : (typeof searchItem !== 'undefined' ? searchItem : '') %>&status=<%= typeof status !== 'undefined' ? status : '' %>" 
                           style="padding: 8px 16px; text-decoration: none; color: #374151; border: 1px solid #E5E7EB; border-radius: 8px; background: #FFF;">Previous</a>
                    <% } %>

                    <% for (let i = 1; i <= totalPages; i++) { %>
                        <% if (i === currentPage) { %>
                            <span style="padding: 8px 16px; background: #000; color: #FFF; border: 1px solid #000; border-radius: 8px; font-weight: 700;"><%= i %></span>
                        <% } else if (i === 1 || i === totalPages || (i >= currentPage - 2 && i <= currentPage + 2)) { %>
                            <a href="/admin/coupons?page=<%= i %>&search=<%= typeof searchTerm !== 'undefined' ? searchTerm : (typeof searchItem !== 'undefined' ? searchItem : '') %>&status=<%= typeof status !== 'undefined' ? status : '' %>" 
                               style="padding: 8px 16px; text-decoration: none; color: #374151; border: 1px solid #E5E7EB; border-radius: 8px; background: #FFF;"><%= i %></a>
                        <% } else if (i === currentPage - 3 || i === currentPage + 3) { %>
                            <span style="color: #9CA3AF;">...</span>
                        <% } %>
                    <% } %>

                    <% if (currentPage < totalPages) { %>
                        <a href="/admin/coupons?page=<%= currentPage + 1 %>&search=<%= typeof searchTerm !== 'undefined' ? searchTerm : (typeof searchItem !== 'undefined' ? searchItem : '') %>&status=<%= typeof status !== 'undefined' ? status : '' %>" 
                           style="padding: 8px 16px; text-decoration: none; color: #374151; border: 1px solid #E5E7EB; border-radius: 8px; background: #FFF;">Next</a>
                    <% } %>
                </div>
            <% } %>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        lucide.createIcons();

        async function deleteCoupon(id) {
            const result = await Swal.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#000',
                cancelButtonColor: '#6B7280',
                confirmButtonText: 'Yes, delete it!'
            });

            if (result.isConfirmed) {
                try {
                    const response = await fetch(`/admin/delete-coupon/${id}`, { method: 'DELETE' });
                    const data = await response.json();
                    if (data.success) {
                        Swal.fire('Deleted!', data.message, 'success').then(() => location.reload());
                    } else {
                        Swal.fire('Error!', data.message, 'error');
                    }
                } catch (error) {
                    Swal.fire('Error!', 'Something went wrong', 'error');
                }
            }
        }

        const searchInput = document.querySelector('.search-input');
        const statusFilter = document.getElementById('statusFilter');

        function updateFilters() {
            const search = searchInput.value;
            const status = statusFilter.value;
            location.href = `/admin/coupons?search=${search}&status=${status}`;
        }

        function clearSearch() {
            location.href = `/admin/coupons?status=${statusFilter.value}`;
        }

        if (searchInput) {
            let debounceTimer;
            searchInput.addEventListener('input', (e) => {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(updateFilters, 500);
            });
        }

        if (statusFilter) {
            statusFilter.addEventListener('change', updateFilters);
        }
    </script>
</body>
</html>


