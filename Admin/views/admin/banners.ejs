<%- include('partials/head') %>
<body>
    <%- include('partials/sidebar', { activePage: 'banners' }) %>

    <main class="main-content">
        <header class="page-header" style="display: flex; justify-content: space-between; align-items: center;">
            <h1 class="page-title">BANNER MANAGEMENT</h1>
            <a href="/admin/add-banner" class="btn btn-primary">ADD NEW BANNER</a>
        </header>

        <div class="table-container">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Image</th>
                        <th>Title</th>
                        <th>Order</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (banners && banners.length > 0) { %>
                        <% banners.forEach(banner => { %>
                            <tr>
                                <td>
                                    <img src="/<%= banner.image %>" alt="<%= banner.title %>" style="width: 120px; height: 50px; object-fit: cover; border-radius: 4px;">
                                </td>
                                <td><%= banner.title %></td>
                                <td><%= banner.order %></td>
                                <td>
                                    <span class="badge <%= banner.status === 'Active' ? 'badge-success' : 'badge-danger' %>" 
                                          style="cursor: pointer;" onclick="toggleStatus('<%= banner._id %>')">
                                        <%= banner.status %>
                                    </span>
                                </td>
                                <td>
                                    <div class="action-btns">
                                        <a href="/admin/edit-banner/<%= banner._id %>" class="action-btn edit" title="Edit">
                                            <i data-lucide="edit-3"></i>
                                        </a>
                                        <button onclick="deleteBanner('<%= banner._id %>')" class="action-btn delete" title="Delete">
                                            <i data-lucide="trash-2"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="5" style="text-align: center; padding: 40px;">No banners found.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        lucide.createIcons();

        async function toggleStatus(id) {
            try {
                const response = await fetch(`/admin/banner-status/${id}`, { method: 'PATCH' });
                const data = await response.json();
                if (data.success) {
                    location.reload();
                } else {
                    Swal.fire('Error', data.message, 'error');
                }
            } catch (error) {
                console.error(error);
            }
        }

        async function deleteBanner(id) {
            const result = await Swal.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, delete it!'
            });

            if (result.isConfirmed) {
                try {
                    const response = await fetch(`/admin/delete-banner/${id}`, { method: 'DELETE' });
                    const data = await response.json();
                    if (data.success) {
                        Swal.fire('Deleted!', 'Banner has been deleted.', 'success').then(() => {
                            location.reload();
                        });
                    } else {
                        Swal.fire('Error', data.message, 'error');
                    }
                } catch (error) {
                    console.error(error);
                }
            }
        }
    </script>
</body>
</html>
