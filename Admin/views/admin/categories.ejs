<%- include('partials/head') %>
<body>
    <%- include('partials/sidebar', { activePage: 'categories' }) %>

    <main class="main-content">
        <%- include('./partials/adminHeader', { title: 'CATEGORY MANAGEMENT' }) %>

        <style>
            .page-link {
                padding: 8px 16px;
                border: 1px solid #E5E7EB;
                border-radius: 8px;
                text-decoration: none;
                color: #374151;
                background: #FFF;
                transition: all 0.2s;
            }
            .page-link:hover {
                border-color: #000;
            }
            .page-link.active {
                border-color: #000;
                color: #FFF;
                background: #000;
            }
        </style>

        <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success" style="background:#D1FAE5;color:#065F46;padding:12px 20px;border-radius:8px;margin-bottom:20px;"><%= success %></div>
        <% } %>
        <% if (typeof message !== 'undefined' && message) { %>
            <div class="alert alert-error" style="background:#FEE2E2;color:#991B1B;padding:12px 20px;border-radius:8px;margin-bottom:20px;"><%= message %></div>
        <% } %>

        <div style="margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center; gap: 20px;">
            <form id="searchForm" action="/admin/categories" method="GET" style="display: flex; gap: 10px; flex: 1; max-width: 600px;">
                <div style="position: relative; flex: 1;">
                    <input type="text" id="searchInput" name="search" placeholder="Search categories..." value="<%= typeof search !== 'undefined' ? search : '' %>" 
                        style="width: 100%; padding: 10px 15px; border: 1px solid #E5E7EB; border-radius: 8px; outline: none;">
                    <% if (typeof search !== 'undefined' && search) { %>
                        <a href="/admin/categories<%= typeof status !== 'undefined' && status !== 'all' ? '?status=' + status : '' %>" style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); color: #9CA3AF; text-decoration: none;">✕</a>
                    <% } %>
                </div>
                <select id="statusFilter" name="status" style="padding: 10px 15px; border: 1px solid #E5E7EB; border-radius: 8px; outline: none; background: #FFF; cursor: pointer;">
                    <option value="all" <%= typeof status !== 'undefined' && status === 'all' ? 'selected' : '' %>>All Status</option>
                    <option value="listed" <%= typeof status !== 'undefined' && status === 'listed' ? 'selected' : '' %>>Listed</option>
                    <option value="unlisted" <%= typeof status !== 'undefined' && status === 'unlisted' ? 'selected' : '' %>>Unlisted</option>
                    <option value="deleted" <%= typeof status !== 'undefined' && status === 'deleted' ? 'selected' : '' %>>Soft Deleted</option>
                </select>
                <button type="submit" class="btn btn-primary" style="display: none;">FILTER</button>
            </form>
            <button class="btn btn-primary" onclick="location.href='/admin/add-category'">ADD CATEGORY</button>
        </div>

        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th style="width: 30%;">CATEGORY</th>
                        <th style="width: 25%;">DESCRIPTION</th>
                        <th style="width: 15%;">STATUS</th>
                        <th>ACTION</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
                        <% categories.forEach(cat => { %>
                            <tr id="category-row-<%= cat._id %>">
                                <td><strong><%= cat.name %></strong></td>
                                <td style="color:#6B7280;font-size:13px;"><%= cat.description || '-' %></td>
                                <td>
                                    <span id="status-badge-<%= cat._id %>" class="status-badge"
                                        <%- cat.isDeleted ? 'style="background: #F3F4F6; color: #4B5563;"' : (cat.isBlocked ? 'style="background: #FEE2E2; color: #991B1B;"' : (cat.isListed ? 'style="background: #D1FAE5; color: #065F46;"' : 'style="background: #FEF3C7; color: #92400E;"')) %>>
                                        <%= cat.isDeleted ? 'DELETED' : (cat.isBlocked ? 'BLOCKED' : (cat.isListed ? 'ACTIVE' : 'INACTIVE')) %>
                                    </span>
                                </td>
                                <td>
                                    <div class="action-btns" style="display: flex; gap: 8px; align-items: center;">
                                        <button class="action-btn" onclick="location.href='/admin/edit-category/<%= cat._id %>'" title="Edit Category">
                                            <i data-lucide="edit-3"></i>
                                        </button>
                                        
                                        <button class="action-btn" id="toggle-btn-<%= cat._id %>" onclick="toggleListing('<%= cat._id %>', '<%= cat.isListed %>')" title="<%= cat.isListed ? 'Deactivate/Unlist' : 'Activate/List' %>">
                                            <i data-lucide="<%= cat.isListed ? 'eye-off' : 'eye' %>"></i>
                                        </button>

                                        <% if (cat.isDeleted) { %>
                                            <button class="action-btn" onclick="restoreCategory('<%= cat._id %>')" title="Restore Category" style="color: #3B82F6;">
                                                <i data-lucide="rotate-ccw"></i>
                                            </button>
                                        <% } else { %>
                                            <button class="action-btn" onclick="softDeleteCategory('<%= cat._id %>')" title="Soft Delete Category" style="color: #6B7280;">
                                                <i data-lucide="archive"></i>
                                            </button>
                                        <% } %>

                                        <button class="action-btn" style="color:#EF4444;" onclick="hardDeleteCategory('<%= cat._id %>')" title="Permanently Delete">
                                            <i data-lucide="trash-2"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="4" style="text-align:center; padding: 40px; color: #6B7280;">
                                No categories found. <a href="/admin/add-category">Add one now.</a>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>

        <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
            <div class="pagination" style="display: flex; justify-content: center; gap: 10px; margin-top: 30px; align-items: center;">
                <% 
                    const statusParam = (typeof status !== 'undefined' && status !== 'all') ? '&status=' + status : '';
                    const searchParam = (typeof search !== 'undefined' && search) ? '&search=' + search : '';
                    const fullQuery = searchParam + statusParam;
                    const commonStyle = 'padding: 8px 16px; border: 1px solid #E5E7EB; border-radius: 8px; text-decoration: none; color: #374151; background: #FFF;';
                    let paginationHtml = '';

                    if (currentPage > 1) {
                        paginationHtml += '<a href="/admin/categories?page=' + (currentPage - 1) + fullQuery + '" class="page-link">Previous</a>';
                    }

                    for (let i = 1; i <= totalPages; i++) {
                        const isActive = (i === currentPage);
                        const activeClass = isActive ? ' active' : '';
                        paginationHtml += '<a href="/admin/categories?page=' + i + fullQuery + '" class="page-link' + activeClass + '">' + i + '</a>';
                    }

                    if (currentPage < totalPages) {
                        paginationHtml += '<a href="/admin/categories?page=' + (currentPage + 1) + fullQuery + '" class="page-link">Next</a>';
                    }
                %>
                <%- paginationHtml %>
            </div>
        <% } %>
    </main>

    <script>
        lucide.createIcons();

        async function toggleListing(id, isListed) {
            isListed = (isListed === 'true' || isListed === true);
            const action = isListed ? 'Unlist' : 'List';
            
            const result = await Swal.fire({
                title: `Confirm Action`,
                text: `Are you sure you want to ${action.toLowerCase()} this category?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: isListed ? '#EF4444' : '#10B981',
                cancelButtonColor: '#6B7280',
                confirmButtonText: `Yes, ${action} it!`
            });

            if (result.isConfirmed) {
                const res = await fetch(`/admin/categories/toggle/${id}`, { method: 'PATCH' });
                const data = await res.json();
                
                if (data.success) {
                    await Swal.fire('Success', `Category has been ${isListed ? 'unlisted' : 'listed'}.`, 'success');
                    location.reload();
                } else {
                    Swal.fire('Error', data.message || 'Failed', 'error');
                }
            }
        }


        async function softDeleteCategory(id) {
            const result = await Swal.fire({
                title: 'Confirm Soft Delete',
                text: 'Are you sure you want to soft delete this category? It will be hidden from the active category list.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#6B7280',
                confirmButtonText: 'Yes, soft delete'
            });
            if (result.isConfirmed) {
                const res = await fetch(`/admin/categories/soft-delete/${id}`, { method: 'PATCH' });
                const data = await res.json();
                if (data.success) {
                    await Swal.fire('Soft Deleted!', data.message || 'Category has been soft deleted.', 'success');
                    const row = document.getElementById(`category-row-${id}`);
                    if (row) row.remove();
                } else {
                    Swal.fire('Error', data.message || 'Failed to soft delete category.', 'error');
                }
            }
        }

        async function restoreCategory(id) {
            const result = await Swal.fire({
                title: 'Confirm Restore',
                text: 'Are you sure you want to restore this category?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#3B82F6',
                confirmButtonText: 'Yes, restore'
            });
            if (result.isConfirmed) {
                const res = await fetch(`/admin/categories/restore/${id}`, { method: 'PATCH' });
                const data = await res.json();
                if (data.success) {
                    await Swal.fire('Restored!', data.message || 'Category has been restored.', 'success');
                    const row = document.getElementById(`category-row-${id}`);
                    if (row) row.remove();
                } else {
                    Swal.fire('Error', data.message || 'Failed to restore category.', 'error');
                }
            }
        }

        async function hardDeleteCategory(id) {
            const result = await Swal.fire({
                title: 'Are you sure?',
                text: 'This action will permanently delete the category and all associated records! It cannot be undone.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#EF4444',
                confirmButtonText: 'Yes, permanently delete'
            });
            if (result.isConfirmed) {
                const res = await fetch(`/admin/categories/hard-delete/${id}`, { method: 'DELETE' });
                const data = await res.json();
                if (data.success) {
                    await Swal.fire('Permanently Deleted!', data.message || 'Category has been deleted.', 'success');
                    const row = document.getElementById(`category-row-${id}`);
                    if (row) row.remove();
                } else {
                    Swal.fire('Error', data.message || 'Failed to delete category.', 'error');
                }
            }
        }

        let searchTimeout;
        const searchInput = document.getElementById('searchInput');
        const statusFilter = document.getElementById('statusFilter');
        const searchForm = document.getElementById('searchForm');

        if (searchInput) {
            searchInput.addEventListener('input', () => {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(() => {
                    searchForm.submit();
                }, 500);
            });
        }

        if (statusFilter) {
            statusFilter.addEventListener('change', () => {
                searchForm.submit();
            });
        }
    </script>
</body>
</html>
