<%- include('partials/head') %>
<body>
    <%- include('partials/sidebar', { activePage: 'products' }) %>

    <main class="main-content">
        <%- include('./partials/adminHeader', { title: 'PRODUCT MANAGEMENT' }) %>

         <div class="stats-grid" style="margin-bottom: 30px;">
                    <div class="stat-card">
                        <div class="stat-info">
                            <h3>Total Products</h3>
                            <div class="value"><%= totalProducts %></div>
                        </div>
                        <div class="stat-icon" style="background: #E8F0FE; color: #1A73E8;">
                            <i data-lucide="package" style="color: #1A73E8;"></i>
                        </div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-info">
                            <h3>Active Products</h3>
                            <div class="value"><%= totalActiveProducts %></div>
                        </div>
                        <div class="stat-icon" style="background: #E6F4EA; color: #137333;">
                            <i data-lucide="package-check" style="color: #137333;"></i>
                        </div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-info">
                            <h3>Blocked Products</h3>
                            <div class="value"><%= typeof totalBlockedProducts !== 'undefined' ? totalBlockedProducts : 0 %></div>
                        </div>
                        <div class="stat-icon" style="background: #FCE8E6; color: #C5221F;">
                            <i data-lucide="shield-alert" style="color: #C5221F;"></i>
                        </div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-info">
                            <h3>Soft Deleted</h3>
                            <div class="value"><%= typeof totalDeletedProducts !== 'undefined' ? totalDeletedProducts : 0 %></div>
                        </div>
                        <div class="stat-icon" style="background: #F3F4F6; color: #4B5563;">
                            <i data-lucide="trash-2" style="color: #4B5563;"></i>
                        </div>
                    </div>
         </div>
        
        <div style="margin-bottom: 20px; display: flex; justify-content: flex-end;">
            <button class="btn btn-primary" onclick="location.href='/admin/add-product'">ADD PRODUCTS</button>
        </div>

        <div class="filter-bar" style="display: flex; gap: 15px; align-items: center; margin-bottom: 30px;">
            <div style="position: relative; flex: 1; max-width: 500px;">
                <input type="text" id="searchInput" class="search-input" placeholder="Search Product..." value="<%= typeof search !== 'undefined' ? search : '' %>" style="width: 100%; padding-right: 36px;">
                <% if (typeof search !== 'undefined' && search) { %>
                    <button id="clearSearchBtn" onclick="clearSearch()" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: #9CA3AF; display: block;">✕</button>
                <% } else { %>
                    <button id="clearSearchBtn" onclick="clearSearch()" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: #9CA3AF; display: none;">✕</button>
                <% } %>
            </div>
            
            <select id="categoryFilter" style="padding: 10px; border-radius: 8px; border: 1px solid #E5E7EB; background: #FFF; cursor: pointer;">
                <option value="">All Categories</option>
                <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
                    <% categories.forEach(cat => { %>
                        <option value="<%= cat._id %>" <%= (typeof selectedCategory !== 'undefined' && selectedCategory == cat._id.toString()) ? 'selected' : '' %>><%= cat.name %></option>
                    <% }) %>
                <% } %>
            </select>

            <select id="statusFilter" style="padding: 10px; border-radius: 8px; border: 1px solid #E5E7EB; background: #FFF; cursor: pointer;">
                <option value="all" <%= typeof status !== 'undefined' && status === 'all' ? 'selected' : '' %>>All Status</option>
                <option value="active" <%= typeof status !== 'undefined' && status === 'active' ? 'selected' : '' %>>Active</option>
                <option value="blocked" <%= typeof status !== 'undefined' && status === 'blocked' ? 'selected' : '' %>>Blocked</option>
                <option value="deleted" <%= typeof status !== 'undefined' && status === 'deleted' ? 'selected' : '' %>>Soft Deleted</option>
            </select>
        </div>

        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>PRODUCTS</th>
                        <th>CATEGORY</th>
                        <th>PRICE</th>
                        <th>OFFER</th>
                        <th>STATUS</th>
                        <th>STOCK</th>
                        <th>ACTION</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (typeof products !== 'undefined' && products.length > 0) { %>
                        <% products.forEach(product => { %>
                            <tr id="product-row-<%= product._id %>">
                                <td>
                                    <div style="display: flex; align-items: center; gap: 10px;">
                                        <% if (product.image && product.image.length > 0) { %>
                                            <img src="<%= product.image[0] %>" alt="<%= product.name %>" style="width: 40px; height: 40px; object-fit: cover; border-radius: 4px;">
                                        <% } %>
                                        <%= product.name %>
                                    </div>
                                </td>
                                <td><%= product.categoryId && product.categoryId.name ? product.categoryId.name : 'General' %></td>
                                <td>₹<%= product.price %></td>
                                <td><%= product.offer %>%</td>
                                <td>
                                    <span id="status-badge-<%= product._id %>" class="status-badge <%= product.isDeleted ? 'status-unlisted' : (product.status === 'Active' ? 'status-listed' : 'status-unlisted') %>"
                                        <% if (product.isDeleted) { %>style="background: #F3F4F6; color: #4B5563;"<% } %>>
                                        <%= product.isDeleted ? 'DELETED' : product.status.toUpperCase() %>
                                    </span>
                                </td>
                                <td>
                                    <% const stock = product.totalVariantStock || 0; %>
                                    <span class="status-badge <%= stock === 0 ? 'status-unlisted' : (stock < 10 ? 'status-pending' : 'status-listed') %>" style="font-size:11px;">
                                        <%= stock %> units
                                    </span>
                                </td>
                                <td>
                                    <div class="action-btns" id="action-btns-<%= product._id %>" style="display: flex; gap: 8px; align-items: center;">
                                        <% if (product.isDeleted) { %>
                                            <button class="action-btn" style="background: #3B82F6;" onclick="confirmRestore('<%= product._id %>')" title="Restore Product">
                                                <i data-lucide="rotate-ccw"></i>
                                            </button>
                                        <% } else { %>
                                            <button class="action-btn" onclick="location.href='/admin/edit-product/<%= product._id %>'" title="Edit Product">
                                                <i data-lucide="edit-3"></i>
                                            </button>
                                            
                                            <% if (product.status === 'Blocked') { %>
                                                <button class="action-btn" style="background: #10B981;" onclick="confirmUnblock('<%= product._id %>')" title="Unblock Product">
                                                    <i data-lucide="eye"></i>
                                                </button>
                                            <% } else { %>
                                                <button class="action-btn" style="background: #F59E0B;" onclick="confirmBlock('<%= product._id %>')" title="Block Product">
                                                    <i data-lucide="eye-off"></i>
                                                </button>
                                            <% } %>

                                            <button class="action-btn" style="background: #6B7280;" onclick="confirmSoftDelete('<%= product._id %>')" title="Soft Delete Product">
                                                <i data-lucide="archive"></i>
                                            </button>
                                        <% } %>

                                        <button class="action-btn" style="background: #DC2626;" onclick="confirmHardDelete('<%= product._id %>')" title="Permanently Delete">
                                            <i data-lucide="trash-2"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="7" style="text-align: center; padding: 40px; color: #6B7280;">No products found.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>

            <% if (typeof totalPages !== 'undefined' && totalPages > 1) { 
                let paginationHtml = '<div style="margin-top: 30px; display: flex; justify-content: center; align-items: center; gap: 10px;">';
                const searchParam = typeof search !== 'undefined' ? `&search=${search}` : '';
                const categoryParam = typeof selectedCategory !== 'undefined' && selectedCategory ? `&category=${selectedCategory}` : '';
                const statusParam = typeof status !== 'undefined' && status ? `&status=${status}` : '';
                const fullQuery = searchParam + categoryParam + statusParam;

                if (currentPage > 1) {
                    paginationHtml += `<a href="/admin/products?page=${currentPage - 1}${fullQuery}" style="padding: 5px 15px; text-decoration: none; color: #000; border: 1px solid #D1D5DB; border-radius: 4px;">&laquo; Previous</a>`;
                }

                for (let i = 1; i <= totalPages; i++) {
                    if (i === currentPage) {
                        paginationHtml += `<span style="font-weight: 700; background: #000; color: #fff; padding: 5px 12px; border-radius: 4px;">${i}</span>`;
                    } else if (i === 1 || i === totalPages || (i >= currentPage - 2 && i <= currentPage + 2)) {
                        paginationHtml += `<a href="/admin/products?page=${i}${fullQuery}" style="padding: 5px 12px; text-decoration: none; color: #6B7280; border: 1px solid #D1D5DB; border-radius: 4px;">${i}</a>`;
                    } else if (i === currentPage - 3 || i === currentPage + 3) {
                        paginationHtml += `<span style="color: #6B7280;">...</span>`;
                    }
                }

                if (currentPage < totalPages) {
                    paginationHtml += `<a href="/admin/products?page=${currentPage + 1}${fullQuery}" style="padding: 5px 15px; text-decoration: none; color: #000; border: 1px solid #D1D5DB; border-radius: 4px;">Next &raquo;</a>`;
                }

                paginationHtml += '</div>';
            %>
                <%- paginationHtml %>
            <% } %>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        lucide.createIcons();

        // Admin Action Handlers
        function confirmBlock(id) {
            Swal.fire({
                title: 'Block Product?',
                text: "The product will not be visible to users.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#000',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, block it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    updateStatus(id, 'block');
                }
            });
        }

        function confirmUnblock(id) {
            Swal.fire({
                title: 'Unblock Product?',
                text: "The product will become visible to users again.",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#10B981',
                cancelButtonColor: '#6B7280',
                confirmButtonText: 'Yes, unblock it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    updateStatus(id, 'unblock');
                }
            });
        }

        function updateStatus(id, action) {
            fetch(`/admin/${action}-product/${id}`, { method: 'PATCH' })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        Swal.fire('Updated!', `Product has been ${action}ed.`, 'success').then(() => location.reload());
                    } else {
                        Swal.fire('Error', data.message, 'error');
                    }
                });
        }

        function confirmSoftDelete(id) {
            Swal.fire({
                title: 'Soft Delete Product?',
                text: "The product will be hidden from the active store list.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#6B7280',
                cancelButtonColor: '#9CA3AF',
                confirmButtonText: 'Yes, soft delete'
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch(`/admin/products/soft-delete/${id}`, { method: 'PATCH' })
                        .then(res => res.json())
                        .then(data => {
                            if (data.success) {
                                Swal.fire('Soft Deleted!', data.message, 'success');
                                const row = document.getElementById(`product-row-${id}`);
                                if (row) row.remove();
                            } else {
                                Swal.fire('Error', data.message, 'error');
                            }
                        });
                }
            });
        }

        function confirmRestore(id) {
            Swal.fire({
                title: 'Restore Product?',
                text: "This product will become active again in the store.",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#3B82F6',
                cancelButtonColor: '#6B7280',
                confirmButtonText: 'Yes, restore'
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch(`/admin/products/restore/${id}`, { method: 'PATCH' })
                        .then(res => res.json())
                        .then(data => {
                            if (data.success) {
                                Swal.fire('Restored!', data.message, 'success');
                                const row = document.getElementById(`product-row-${id}`);
                                if (row) row.remove();
                            } else {
                                Swal.fire('Error', data.message, 'error');
                            }
                        });
                }
            });
        }

        function confirmHardDelete(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "This action will permanently delete this product and all of its variants from the database! It cannot be undone.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#DC2626',
                cancelButtonColor: '#6B7280',
                confirmButtonText: 'Yes, permanently delete!'
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch(`/admin/products/hard-delete/${id}`, { method: 'DELETE' })
                        .then(res => res.json())
                        .then(data => {
                            if (data.success) {
                                Swal.fire('Deleted!', 'Product has been permanently removed.', 'success');
                                const row = document.getElementById(`product-row-${id}`);
                                if (row) row.remove();
                            } else {
                                Swal.fire('Error', data.message, 'error');
                            }
                        });
                }
            });
        }

        // Search & Filter
        const searchInput = document.getElementById('searchInput');
        const categoryFilter = document.getElementById('categoryFilter');
        const statusFilter = document.getElementById('statusFilter');
        let searchTimeout;

        function triggerSearch() {
            const searchVal = searchInput.value;
            const catVal = categoryFilter.value;
            const statusVal = statusFilter.value;
            location.href = `/admin/products?search=${searchVal}&category=${catVal}&status=${statusVal}`;
        }

        searchInput.addEventListener('input', () => {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(triggerSearch, 600);
        });

        categoryFilter.addEventListener('change', triggerSearch);
        statusFilter.addEventListener('change', triggerSearch);

        function clearSearch() {
            location.href = '/admin/products';
        }
    </script>
</body>
</html>