<%- include('partials/head') %>
<body>
    <%- include('partials/sidebar', { activePage: 'orders' }) %>

    <main class="main-content">
        <header class="page-header">
            <h1 class="page-title">ORDER MANAGEMENT</h1>
        </header>

        <div class="filter-bar" style="display: flex; gap: 15px; align-items: center; margin-bottom: 30px;">
            <div style="position: relative; flex: 1; max-width: 500px;">
                <input type="text" id="orderSearch" class="search-input" placeholder="Search Order ID..." value="<%= search %>" style="width: 100%; padding-right: 36px;">
                <% if (search) { %>
                    <button onclick="clearSearch()" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: #9CA3AF; display: block;">✕</button>
                <% } else { %>
                    <button onclick="clearSearch()" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: #9CA3AF; display: none;">✕</button>
                <% } %>
            </div>
            <select id="statusFilter" class="search-input" style="max-width: 200px;">
                <option value="">All Status</option>
                <option value="Placed" <%= status === 'Placed' ? 'selected' : '' %>>Placed</option>
                <option value="Processing" <%= status === 'Processing' ? 'selected' : '' %>>Processing</option>
                <option value="Shipped" <%= status === 'Shipped' ? 'selected' : '' %>>Shipped</option>
                <option value="Delivered" <%= status === 'Delivered' ? 'selected' : '' %>>Delivered</option>
                <option value="Cancelled" <%= status === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
                <option value="Returned" <%= status === 'Returned' ? 'selected' : '' %>>Returned</option>
                <option value="Return Pending" <%= status === 'Return Pending' ? 'selected' : '' %>>Return Pending</option>
            </select>
        </div>

        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>ORDER ID</th>
                        <th>CUSTOMER</th>
                        <th>DATE</th>
                        <th>TOTAL</th>
                        <th>PAYMENT</th>
                        <th>STATUS</th>
                        <th>ACTION</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (orders && orders.length > 0) { %>
                        <% orders.forEach(order => { %>
                            <%
                                const hasPendingReturn = order.items && order.items.some(item => item.status === 'Return Pending');
                                const displayStatus = hasPendingReturn ? 'Return Pending' : order.orderStatus;
                            %>
                            <tr>
                                <td><strong><%= order.orderId %></strong></td>
                                <td>
                                    <% if (order.userId && typeof order.userId === 'object') { %>
                                        <%= order.userId.firstName %> <%= order.userId.lastName %><br>
                                        <small><%= order.userId.email %></small>
                                    <% } else { %>
                                        Unknown Customer
                                    <% } %>
                                </td>
                                <td><%= new Date(order.createdAt).toLocaleDateString() %></td>
                                <%
                                    const computedOrderTotal = order.items ? order.items.reduce((sum, item) => {
                                        const unitPrice = item.price || item.productId?.offerPrice || item.variantId?.price || item.productId?.price || 0;
                                        return sum + (unitPrice * (item.quantity || 0));
                                    }, 0) : 0;
                                    const subtotalOrderTotal = order.subtotal != null ? Math.max(0, order.subtotal - (order.discountAmount || 0)) : 0;
                                    const displayOrderTotal = subtotalOrderTotal || order.totalAmount || computedOrderTotal;
                                %>
                                <td>₹<%= displayOrderTotal.toLocaleString() %></td>
                                <td><%= order.paymentMethod %></td>
                                <td>
                                    <select class="status-select" onchange="updateStatus('<%= order._id %>', this.value)">
                                        <% if (displayStatus === 'Pending') { %>
                                            <option value="Pending" selected>Pending</option>
                                            <option value="Confirmed">Confirmed</option>
                                            <option value="Cancelled">Cancelled</option>
                                        <% } else if (displayStatus === 'Confirmed') { %>
                                            <option value="Confirmed" selected>Confirmed</option>
                                            <option value="Shipped">Shipped</option>
                                            <option value="Cancelled">Cancelled</option>
                                        <% } else if (displayStatus === 'Shipped') { %>
                                            <option value="Shipped" selected>Shipped</option>
                                            <option value="Out for Delivery">Out for Delivery</option>
                                        <% } else if (displayStatus === 'Out for Delivery') { %>
                                            <option value="Out for Delivery" selected>Out for Delivery</option>
                                            <option value="Delivered">Delivered</option>
                                        <% } else if (displayStatus === 'Delivered') { %>
                                            <option value="Delivered" selected>Delivered</option>
                                        <% } else if (displayStatus === 'Return Pending') { %>
                                            <option value="Return Pending" selected>Return Pending</option>
                                            <option value="Returned">Returned (Approve)</option>
                                            <option value="Delivered">Delivered (Reject)</option>
                                        <% } else if (displayStatus === 'Cancelled') { %>
                                            <option value="Cancelled" selected>Cancelled</option>
                                        <% } else if (displayStatus === 'Returned') { %>
                                            <option value="Returned" selected>Returned</option>
                                        <% } else { %>
                                            <option value="Pending" <%= displayStatus === 'Pending' ? 'selected' : '' %>>Pending</option>
                                            <option value="Confirmed" <%= displayStatus === 'Confirmed' ? 'selected' : '' %>>Confirmed</option>
                                            <option value="Shipped" <%= displayStatus === 'Shipped' ? 'selected' : '' %>>Shipped</option>
                                            <option value="Out for Delivery" <%= displayStatus === 'Out for Delivery' ? 'selected' : '' %>>Out for Delivery</option>
                                            <option value="Delivered" <%= displayStatus === 'Delivered' ? 'selected' : '' %>>Delivered</option>
                                            <option value="Cancelled" <%= displayStatus === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
                                            <option value="Returned" <%= displayStatus === 'Returned' ? 'selected' : '' %>>Returned</option>
                                        <% } %>
                                    </select>
                                </td>
                                <td>
                                    <a href="/admin/orders/<%= order._id %>" class="action-btn" title="View Details" style="display: inline-flex; align-items: center; justify-content: center; text-decoration: none;">
                                        <i data-lucide="eye"></i>
                                    </a>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="7" style="text-align: center; padding: 40px; color: #6B7280;">No orders found yet.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>

            <% if (typeof totalPages !== 'undefined' && totalPages > 1) { 
                let paginationHtml = '<div style="margin-top: 30px; display: flex; justify-content: center; align-items: center; gap: 10px; padding-bottom: 20px;">';
                
                if (currentPage > 1) {
                    paginationHtml += `<a href="/admin/orders?page=${currentPage - 1}&search=${search}&status=${status}" style="padding: 8px 16px; text-decoration: none; color: #374151; border: 1px solid #E5E7EB; border-radius: 8px; background: #FFF;">Previous</a>`;
                }

                for (let i = 1; i <= totalPages; i++) {
                    const activeStyles = i === currentPage ? 'background: #000; color: #FFF; border-color: #000;' : 'background: #FFF; color: #374151;';
                    paginationHtml += `<a href="/admin/orders?page=${i}&search=${search}&status=${status}" style="padding: 8px 16px; text-decoration: none; border: 1px solid #E5E7EB; border-radius: 8px; ${activeStyles}">${i}</a>`;
                }

                if (currentPage < totalPages) {
                    paginationHtml += `<a href="/admin/orders?page=${currentPage + 1}&search=${search}&status=${status}" style="padding: 8px 16px; text-decoration: none; color: #374151; border: 1px solid #E5E7EB; border-radius: 8px; background: #FFF;">Next</a>`;
                }

                paginationHtml += '</div>';
            %>
                <%- paginationHtml %>
            <% } %>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        lucide.createIcons();
        
        const orderSearch = document.getElementById('orderSearch');
        const statusFilter = document.getElementById('statusFilter');

        function updateOrders() {
            const search = orderSearch.value;
            const status = statusFilter.value;
            location.href = `/admin/orders?search=${search}&status=${status}`;
        }

        function clearSearch() {
            location.href = `/admin/orders?status=${statusFilter.value}`;
        }

        if (orderSearch) {
            let debounceTimer;
            orderSearch.addEventListener('input', () => {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(updateOrders, 500);
            });
        }

        if (statusFilter) {
            statusFilter.addEventListener('change', updateOrders);
        }

        async function updateStatus(orderId, newStatus) {
            const result = await Swal.fire({
                title: 'Update Order Status?',
                text: `Are you sure you want to change the status to "${newStatus}"?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#000',
                cancelButtonColor: '#6B7280',
                confirmButtonText: 'Yes, update it!'
            });

            if (!result.isConfirmed) {
                location.reload(); // Reset the select box
                return;
            }

            try {
                const response = await fetch(`/admin/orders/status/${orderId}`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ status: newStatus })
                });

                const data = await response.json();
                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Updated!',
                        text: 'Order status has been updated.',
                        timer: 1500,
                        showConfirmButton: false
                    }).then(() => {
                        location.reload();
                    });
                } else {
                    Swal.fire('Error', data.message || 'Failed to update status', 'error');
                }
            } catch (error) {
                Swal.fire('Error', 'Something went wrong', 'error');
            }
        }

        function viewOrderItems(orderId) {
            // Placeholder: In a real app we might show a modal or redirect
            Swal.fire({
                title: 'Order Details',
                text: 'Order ID: ' + orderId,
                icon: 'info'
            });
        }
    </script>
    
    <style>
        .status-select {
            padding: 5px 10px;
            border-radius: 4px;
            border: 1px solid #E5E7EB;
            font-size: 12px;
            font-weight: 600;
            background: #FFF;
            cursor: pointer;
            outline: none;
        }

        .status-select:focus {
            border-color: #000;
        }
    </style>
</body>
</html>
