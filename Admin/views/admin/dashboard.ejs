<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<style>
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 20px;
    }

    .table-container {
        width: 100%;
        overflow-x: auto;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
    }

    .filter-bar {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .search-input {
        flex: 1;
        min-width: 200px;
    }
</style>

<%- include('partials/head') %>

    <body>

        <%- include('./partials/sidebar', { activePage: 'dashboard' }) %>
            <main class="main-content">
                <%- include('./partials/adminHeader', { title: 'ADMIN DASHBOARD' }) %>

                    <div class="stats-grid">
                        <div class="stat-card">
                            <div class="stat-info">
                                <h3>Total Revenue</h3>
                                <div class="value">₹ 145,250</div>
                            </div>
                            <div class="stat-icon">
                                <i data-lucide="indian-rupee"></i>
                            </div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-info">
                                <h3>Orders</h3>
                                <div class="value">84</div>
                            </div>
                            <div class="stat-icon">
                                <i data-lucide="shopping-cart"></i>
                            </div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-info">
                                <h3>Products</h3>
                                <div class="value">24</div>
                            </div>
                            <div class="stat-icon">
                                <i data-lucide="package"></i>
                            </div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-info">
                                <h3>Customers</h3>
                                <div class="value">42</div>
                            </div>
                            <div class="stat-icon">
                                <i data-lucide="users"></i>
                            </div>
                        </div>
                    </div>

                    <div class="table-container" style="margin-top: 30px; margin-bottom: 30px;">
                        <div class="table-header">
                            <h2>Revenue Overview</h2>
                        </div>
                        <canvas id="revenueOverviewChart" height="100"></canvas>
                    </div>

                    <div class="table-container">
                        <div class="table-header">
                            <h2>Recent Orders</h2>
                            <a href="/admin/orders" class="btn-view-all">View All</a>
                        </div>
                        <table>
                            <thead>
                                <tr>
                                    <th>Order ID</th>
                                    <th>Customer</th>
                                    <th>Date</th>
                                    <th>Total</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>#TRU-9843</td>
                                    <td>Adarsh Sharma</td>
                                    <td>18/05/2026</td>
                                    <td>₹14,999</td>
                                    <td><span class="status-badge status-completed">Completed</span></td>
                                </tr>
                                <tr>
                                    <td>#TRU-9842</td>
                                    <td>Neha Patel</td>
                                    <td>17/05/2026</td>
                                    <td>₹8,499</td>
                                    <td><span class="status-badge status-pending">Pending</span></td>
                                </tr>
                                <tr>
                                    <td>#TRU-9841</td>
                                    <td>Rahul Verma</td>
                                    <td>16/05/2026</td>
                                    <td>₹19,999</td>
                                    <td><span class="status-badge status-completed">Completed</span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
            </main>

            <script>
                lucide.createIcons();

                // Static Revenue Overview Chart
                const revenueCtx = document.getElementById('revenueOverviewChart').getContext('2d');
                new Chart(revenueCtx, {
                    type: 'line',
                    data: {
                        labels: ['12 May', '13 May', '14 May', '15 May', '16 May', '17 May', '18 May'],
                        datasets: [{
                            label: 'Daily Revenue (Last 7 Days)',
                            data: [12000, 19000, 15000, 25000, 22000, 30000, 45000],
                            borderColor: '#000',
                            backgroundColor: 'rgba(0, 0, 0, 0.05)',
                            tension: 0.4,
                            fill: true,
                            pointRadius: 5,
                            pointBackgroundColor: '#000'
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            legend: { display: true, position: 'top' },
                            tooltip: {
                                callbacks: {
                                    label: function (context) {
                                        return '₹ ' + context.parsed.y.toLocaleString();
                                    }
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    callback: function (value) {
                                        return '₹' + value.toLocaleString();
                                    }
                                }
                            }
                        }
                    }
                });
            </script>

    </body>

</html>