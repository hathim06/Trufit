<%- include('partials/head') %>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        .status-badge {
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .status-active {
            background: #DCFCE7;
            color: #166534;
        }

        .status-blocked {
            background: #FEE2E2;
            color: #991B1B;
        }

        .btn-action {
            padding: 6px 12px;
            font-size: 11px;
            font-weight: 700;
            border-radius: 4px;
            border: none;
            cursor: pointer;
            transition: 0.3s;
        }

        .btn-delete {
            background: #000;
            color: #fff;
        }

        .btn-delete:hover {
            background: #ef4444;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
        }
    </style>

    <body>
        <%- include('partials/sidebar', { activePage: 'users' }) %>

            <main class="main-content">
                <%- include('./partials/adminHeader', { title: 'USER MANAGEMENT' }) %>

                <!-- Stats Grid -->
                <div class="stats-grid" style="margin-bottom: 30px;">
                    <!-- <div class="stat-card">
                        <div class="stat-info">
                            <h3>Total Customers</h3>
                            <div class="value"><%= totalAllUsers %></div>
                        </div>
                        <div class="stat-icon" style="background: #E8F0FE; color: #1A73E8;">
                            <i data-lucide="users" style="color: #1A73E8;"></i>
                        </div>
                    </div> -->
                    <!-- <div class="stat-card">
                        <div class="stat-info">
                            <h3>Active Customers</h3>
                            <div class="value"><%= activeUsersCount %></div>
                        </div>
                        <div class="stat-icon" style="background: #E6F4EA; color: #137333;">
                            <i data-lucide="user-check" style="color: #137333;"></i>
                        </div>
                    </div> -->
                    <!-- <div class="stat-card">
                        <div class="stat-info">
                            <h3>Blocked Customers</h3>
                            <div class="value"><%= blockedUsersCount %></div>
                        </div>
                        <div class="stat-icon" style="background: #FCE8E6; color: #C5221F;">
                            <i data-lucide="user-x" style="color: #C5221F;"></i>
                        </div>
                    </div> -->
                    <% if (search || status) { %>
                    <div class="stat-card">
                        <div class="stat-info">
                            <h3>Filtered Results</h3>
                            <div class="value"><%= totalUsers %></div>
                        </div>
                        <div class="stat-icon" style="background: #FEF7E0; color: #B06000;">
                            <i data-lucide="filter" style="color: #B06000;"></i>
                        </div>
                    </div>
                    <% } %>
                </div>

                <div class="filter-bar" style="display: flex; gap: 15px; align-items: center; margin-bottom: 30px;">
                    <div style="position: relative; flex: 1; max-width: 500px;">
                        <input type="text" id="searchInput" class="search-input" placeholder="Search users..." value="<%= search %>" style="width: 100%; padding-right: 36px;">
                        <% if (search) { %>
                            <button onclick="clearSearch()" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: #9CA3AF; display: block;">✕</button>
                        <% } else { %>
                            <button onclick="clearSearch()" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: #9CA3AF; display: none;">✕</button>
                        <% } %>
                    </div>
                    
                    <select id="statusFilter" class="search-input" style="max-width: 200px;">
                        <option value="">All Status</option>
                        <option value="active" <%= status === 'active' ? 'selected' : '' %>>Active</option>
                        <option value="blocked" <%= status === 'blocked' ? 'selected' : '' %>>Blocked</option>
                    </select>
                </div>

                <div class="table-container">
                    <table>
                        <thead>
                            <tr>
                                <th>USERS ID</th>
                                <th>USERS</th>
                                <th>EMAIL</th>
                                <th>STATUS</th>
                                <th>JOINED ON</th>
                                <th>ACTION</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% users.forEach(user=> { %>
                                <tr id="user-row-<%= user._id %>">
                                    <td>
                                        <%= user._id %>
                                    </td>
                                    <td>
                                        <%= user.firstName %>
                                            <%= user.lastName %>
                                    </td>
                                    <td>
                                        <%= user.email %>
                                    </td>
                                    <td>
                                        <span id="status-badge-<%= user._id %>"
                                            class="status-badge <%= user.isBlocked ? 'status-blocked' : 'status-active' %>">
                                            <%= user.isBlocked ? 'Blocked' : 'Active' %>
                                        </span>
                                    </td>
                                    <td>
                                        <%= user.createdAt ? user.createdAt.toDateString() : 'N/A' %>
                                    </td>

                                    <td style="display: flex; gap: 10px;">
                                        <a href="/admin/users/view/<%= user._id %>" class="btn-action" style="background: #10B981; color: #fff; text-decoration: none; display: flex; align-items: center; justify-content: center; padding: 8px;">
                                            <i data-lucide="eye" style="width: 16px; height: 16px;"></i>
                                        </a>

                                        <button id="block-btn-<%= user._id %>" onclick="toggleBlock('<%= user._id %>', '<%= user.isBlocked %>')"
                                            class="btn-action <%= user.isBlocked ? 'btn-success' : 'btn-danger' %>">
                                            <%= user.isBlocked ? 'UNBLOCK' : 'BLOCK' %>
                                        </button>

                                        <button onclick="deleteUser('<%= user._id %>')" class="btn-action btn-delete">
                                            DELETE
                                        </button>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>

                    <div class="pagination"
                        style="margin-top: 30px; display: flex; justify-content: center; gap: 10px;">
                        <% if (currentPage> 1) { %>
                            <a href="/admin/users?page=<%= currentPage - 1 %>&search=<%= search %>&status=<%= status %>"
                                style="padding: 5px 10px; text-decoration: none; color: #4F46E5; border: 1px solid #D1D5DB; border-radius: 4px;">&laquo;
                                Previous</a>
                            <% } %>

                                <% for(let i=1; i <=totalPages; i++) { %>
                                    <% if (i===currentPage) { %>
                                        <span
                                            style="font-weight: 700; border: 1px solid #000; padding: 5px 10px; background: #000; color: #fff; border-radius: 4px;">
                                            <%= i %>
                                        </span>
                                        <% } else if (i===1 || i===totalPages || (i>= currentPage - 2 && i <=
                                                currentPage + 2)) { %>
                                                <a href="/admin/users?page=<%= i %>&search=<%= search %>&status=<%= status %>"
                                                    style="padding: 5px 10px; text-decoration: none; color: #6B7280; border: 1px solid #D1D5DB; border-radius: 4px; margin: 0 2px;">
                                                    <%= i %>
                                                </a>
                                                <% } else if (i===currentPage - 3 || i===currentPage + 3) { %>
                                                    <span style="padding: 5px 10px; color: #6B7280;">...</span>
                                                    <% } %>
                                                        <% } %>

                                                            <% if (currentPage < totalPages) { %>
                                                                <a href="/admin/users?page=<%= currentPage + 1 %>&search=<%= search %>"
                                                                    style="padding: 5px 10px; text-decoration: none; color: #4F46E5; border: 1px solid #D1D5DB; border-radius: 4px;">Next
                                                                    &raquo;</a>
                                                                <% } %>
                    </div>
                </div>
            </main>

            <script>
                lucide.createIcons();

                async function toggleBlock(id, isBlocked) {
                    isBlocked = (isBlocked === "true");
                    const action = isBlocked ? 'unblock' : 'block';

                    const result = await Swal.fire({
                        title: `Confirm ${action.toUpperCase()}`,
                        text: `Are you sure you want to ${action} this user?`,
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: isBlocked ? '#16a34a' : '#d33',
                        cancelButtonColor: '#6B7280',
                        confirmButtonText: `Yes, ${action} them!`
                    });

                    if (result.isConfirmed) {
                        try {
                            const url = isBlocked ? `/admin/users/unblock/${id}` : `/admin/users/block/${id}`;
                            const res = await fetch(url, { method: "PATCH" });
                            const data = await res.json();

                            if (data.success) {
                                await Swal.fire('Updated!', `User has been ${isBlocked ? 'unblocked' : 'blocked'}.`, 'success');
                                
                                // Update DOM dynamically
                                const newIsBlocked = !isBlocked;
                                const badge = document.getElementById(`status-badge-${id}`);
                                const btn = document.getElementById(`block-btn-${id}`);
                                
                                if (badge) {
                                    badge.className = `status-badge ${newIsBlocked ? 'status-blocked' : 'status-active'}`;
                                    badge.textContent = newIsBlocked ? 'Blocked' : 'Active';
                                }
                                
                                if (btn) {
                                    btn.className = `btn-action ${newIsBlocked ? 'btn-success' : 'btn-danger'}`;
                                    btn.textContent = newIsBlocked ? 'UNBLOCK' : 'BLOCK';
                                    btn.setAttribute('onclick', `toggleBlock('${id}', '${newIsBlocked}')`);
                                }
                            } else {
                                Swal.fire('Error!', 'Failed to update user status.', 'error');
                            }
                        } catch (error) {
                            console.error("Toggle block error:", error);
                            Swal.fire('Error!', 'Something went wrong. Please try again.', 'error');
                        }
                    }
                }

                async function deleteUser(id) {
                    const result = await Swal.fire({
                        title: 'Are you sure?',
                        text: "This action cannot be undone!",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#000',
                        cancelButtonColor: '#6B7280',
                        confirmButtonText: 'Yes, delete it!'
                    });

                    if (result.isConfirmed) {
                        const res = await fetch(`/admin/users/delete/${id}`, {
                            method: "DELETE"
                        });
                        const data = await res.json();

                        if (data.success) {
                            await Swal.fire('Deleted!', data.message || 'User has been removed.', 'success');
                            
                            // Remove row from DOM
                            const row = document.getElementById(`user-row-${id}`);
                            if (row) {
                                row.remove();
                            }
                        } else {
                            Swal.fire('Error!', data.message || 'Failed to delete user.', 'error');
                        }
                    }
                }

                let searchTimeout;
                document.getElementById("searchInput").addEventListener("input", function () {
                    clearTimeout(searchTimeout);
                    const value = this.value;
                    const status = document.getElementById("statusFilter").value;
                    searchTimeout = setTimeout(() => {
                        window.location.href = `/admin/users?search=${value}&status=${status}&page=1`;
                    }, 500);
                });

                document.getElementById("statusFilter").addEventListener("change", function () {
                    const search = document.getElementById("searchInput").value;
                    const status = this.value;
                    window.location.href = `/admin/users?search=${search}&status=${status}&page=1`;
                });

                // Clear button
                function clearSearch() {
                    window.location.href = "/admin/users";
                }

            </script>
    </body>

    </html>