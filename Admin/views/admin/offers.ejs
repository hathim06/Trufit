<%- include('partials/head') %>
<body>
    <%- include('partials/sidebar', { activePage: 'offers' }) %>

    <main class="main-content">
        <header class="page-header">
            <h1 class="page-title">OFFER MANAGEMENT</h1>
            <button class="btn btn-primary" onclick="location.href='/admin/add-offer'">ADD OFFER</button>
        </header>

        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>OFFER NAME</th>
                        <th>DISCOUNT</th>
                        <th>VALID FROM</th>
                        <th>VALID TO</th>
                        <th>STATUS</th>
                        <th>ACTION</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (typeof offers !== 'undefined' && offers && offers.length > 0) { %>
                        <% offers.forEach((offer, index) => { %>
                            <% 
                                const now = new Date();
                                const validFrom = new Date(offer.validFrom);
                                const validTo = new Date(offer.validTo);
                                const isExpired = validTo < now;
                                const isUpcoming = validFrom > now;
                                const isLive = offer.isActive && !isExpired && !isUpcoming;
                                const statusText = !offer.isActive ? 'Inactive' : isExpired ? 'Expired' : isUpcoming ? 'Upcoming' : 'Active';
                                const statusClass = isLive ? 'status-listed' : isUpcoming ? 'status-pending' : 'status-unlisted';
                            %>
                            <tr>
                                <td><%= index + 1 %></td>
                                <td><strong><%= offer.name %></strong></td>
                                <td><%= offer.discountPercentage %>%</td>
                                <td><%= validFrom.toLocaleDateString() %></td>
                                <td><%= validTo.toLocaleDateString() %></td>
                                <td><span class="status-badge <%= statusClass %>"><%= statusText %></span></td>
                                <td>
                                    <div class="action-btns">
                                        <button class="action-btn" title="Edit offer" onclick="location.href='/admin/edit-offer/<%= offer._id %>'">
                                            <i data-lucide="edit-3"></i>
                                        </button>
                                        <button class="action-btn" title="Delete offer" onclick="deleteOffer('<%= offer._id %>')">
                                            <i data-lucide="trash-2"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="7" style="text-align: center; padding: 40px; color: #6B7280;">
                                No offers found. Click "ADD OFFER" to create one.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </main>

    <script>
        lucide.createIcons();

        async function deleteOffer(id) {
            const result = await Swal.fire({
                title: 'Delete offer?',
                text: 'This offer will be removed permanently.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#000',
                cancelButtonColor: '#6B7280',
                confirmButtonText: 'Delete'
            });

            if (!result.isConfirmed) return;

            try {
                const response = await fetch(`/admin/delete-offer/${id}`, { method: 'DELETE' });
                const data = await response.json();

                if (data.success) {
                    Swal.fire('Deleted!', 'Offer deleted successfully.', 'success').then(() => location.reload());
                } else {
                    Swal.fire('Error!', data.message || 'Failed to delete offer.', 'error');
                }
            } catch (error) {
                Swal.fire('Error!', 'Something went wrong.', 'error');
            }
        }
    </script>
</body>
</html>
