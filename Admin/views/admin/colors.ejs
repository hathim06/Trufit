<%- include('partials/head') %>
<body>
    <%- include('partials/sidebar', { activePage: 'colors' }) %>

    <main class="main-content">
        <%- include('./partials/adminHeader', { title: 'COLOR MANAGEMENT' }) %>

        <div style="display: grid; grid-template-columns: 1fr 350px; gap: 30px; margin-top: 30px;">
            <!-- Colors List -->
            <div class="table-container">
                <div class="table-header" style="display: flex; justify-content: space-between; align-items: center; width: 100%; padding-right: 15px;">
                    <h2>Available Colors</h2>
                    <select id="statusFilter" class="search-input" style="max-width: 180px; padding: 6px 12px; border: 1px solid #E5E7EB; border-radius: 6px; outline: none; background: #FFF; cursor: pointer; font-size: 13px;">
                        <option value="all" <%= typeof status !== 'undefined' && status === 'all' ? 'selected' : '' %>>All Status</option>
                        <option value="deleted" <%= typeof status !== 'undefined' && status === 'deleted' ? 'selected' : '' %>>Soft Deleted</option>
                    </select>
                </div>
                <table>
                    <thead>
                        <tr>
                            <th>Preview</th>
                            <th>Color Name</th>
                            <th>Hex Code</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="colorsTableBody">
                        <% if (colors && colors.length > 0) { %>
                            <% colors.forEach(color => { %>
                                <tr id="color-row-<%= color._id %>">
                                    <td>
                                        <div class="color-preview-circle" style="background-color: <%= color.hex %>"></div>
                                    </td>
                                    <td><strong><%= color.name %></strong></td>
                                    <td><code><%= color.hex %></code></td>
                                    <td>
                                        <div class="action-btns" style="display: flex; gap: 8px; align-items: center;">

                                            <!-- Soft Delete/Restore -->
                                            <% if (color.isDeleted) { %>
                                                <button class="action-btn" onclick="restoreColor('<%= color._id %>')" title="Restore Color" style="color: #3B82F6; background: none; border: none; cursor: pointer; padding: 0;">
                                                    <i data-lucide="rotate-ccw" style="width: 18px; height: 18px;"></i>
                                                </button>
                                            <% } else { %>
                                                <button class="action-btn" onclick="softDeleteColor('<%= color._id %>')" title="Soft Delete Color" style="color: #6B7280; background: none; border: none; cursor: pointer; padding: 0;">
                                                    <i data-lucide="archive" style="width: 18px; height: 18px;"></i>
                                                </button>
                                            <% } %>

                                            <!-- Hard Delete -->
                                            <button class="action-btn" onclick="hardDeleteColor('<%= color._id %>')" title="Permanently Delete Color" style="color: #EF4444; background: none; border: none; cursor: pointer; padding: 0;">
                                                <i data-lucide="trash-2" style="width: 18px; height: 18px;"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="4" style="text-align: center; padding: 40px; color: #6B7280;">No colors found.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>

                <% if (typeof totalPages !== 'undefined' && totalPages > 1) { 
                    const statusParam = (typeof status !== 'undefined' && status !== 'all') ? '&status=' + status : '';
                    let paginationHtml = '<div style="margin-top: 20px; display: flex; justify-content: center; align-items: center; gap: 10px; padding-bottom: 20px;">';
                    
                    if (currentPage > 1) {
                        paginationHtml += `<a href="/admin/colors?page=${currentPage - 1}${statusParam}" style="padding: 6px 12px; text-decoration: none; color: #374151; border: 1px solid #E5E7EB; border-radius: 6px; background: #FFF; font-size: 13px;">Previous</a>`;
                    }

                    for (let i = 1; i <= totalPages; i++) {
                        const activeStyles = i === currentPage ? 'background: #000; color: #FFF; border-color: #000;' : 'background: #FFF; color: #374151;';
                        paginationHtml += `<a href="/admin/colors?page=${i}${statusParam}" style="padding: 6px 12px; text-decoration: none; border: 1px solid #E5E7EB; border-radius: 6px; font-size: 13px; ${activeStyles}">${i}</a>`;
                    }

                    if (currentPage < totalPages) {
                        paginationHtml += `<a href="/admin/colors?page=${currentPage + 1}${statusParam}" style="padding: 6px 12px; text-decoration: none; color: #374151; border: 1px solid #E5E7EB; border-radius: 6px; background: #FFF; font-size: 13px;">Next</a>`;
                    }

                    paginationHtml += '</div>';
                %>
                    <%- paginationHtml %>
                <% } %>
            </div>

            <!-- Add Color Form -->
            <div class="table-container" style="height: fit-content;">
                <div class="table-header">
                    <h2>Add New Color</h2>
                </div>
                <form id="addColorForm" style="padding: 20px;">
                    <div class="form-group">
                        <label>Color Name</label>
                        <input type="text" id="colorName" placeholder="e.g. Midnight Blue" required style="width: 100%; padding: 12px; border: 1px solid #E5E7EB; border-radius: 8px;">
                    </div>
                    <div class="form-group" style="margin-top: 20px;">
                        <label>Hex Code</label>
                        <div style="display: flex; gap: 10px;">
                            <input type="color" id="colorHexPicker" value="#000000" style="width: 50px; height: 45px; border: 1px solid #E5E7EB; border-radius: 8px; cursor: pointer; padding: 5px;">
                            <input type="text" id="colorHexText" placeholder="#000000" required style="flex: 1; padding: 12px; border: 1px solid #E5E7EB; border-radius: 8px;">
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 30px; padding: 15px; font-weight: 700;">ADD COLOR</button>
                </form>
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        lucide.createIcons();

        // Sync color picker and text input
        const hexPicker = document.getElementById('colorHexPicker');
        const hexText = document.getElementById('colorHexText');

        hexPicker.addEventListener('input', (e) => {
            hexText.value = e.target.value.toUpperCase();
        });

        hexText.addEventListener('input', (e) => {
            if (/^#[0-9A-F]{6}$/i.test(e.target.value)) {
                hexPicker.value = e.target.value;
            }
        });

        document.getElementById('addColorForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const name = document.getElementById('colorName').value;
            const hex = hexText.value;

            try {
                const response = await fetch('/admin/colors/add', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name, hex })
                });

                const data = await response.json();
                if (data.success) {
                    Swal.fire('Success', data.message, 'success').then(() => location.reload());
                } else {
                    Swal.fire('Error', data.message, 'error');
                }
            } catch (error) {
                Swal.fire('Error', 'Something went wrong', 'error');
            }
        });



        async function softDeleteColor(id) {
            const result = await Swal.fire({
                title: 'Confirm Soft Delete',
                text: 'Are you sure you want to soft delete this color? It will be hidden from the active color options.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#6B7280',
                confirmButtonText: 'Yes, soft delete'
            });
            if (result.isConfirmed) {
                try {
                    const res = await fetch(`/admin/colors/soft-delete/${id}`, { method: 'PATCH' });
                    const data = await res.json();
                    if (data.success) {
                        await Swal.fire('Soft Deleted!', data.message, 'success');
                        location.reload();
                    } else {
                        Swal.fire('Error', data.message, 'error');
                    }
                } catch (error) {
                    Swal.fire('Error', 'Something went wrong', 'error');
                }
            }
        }

        async function restoreColor(id) {
            const result = await Swal.fire({
                title: 'Confirm Restore',
                text: 'Are you sure you want to restore this color?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#3B82F6',
                confirmButtonText: 'Yes, restore'
            });
            if (result.isConfirmed) {
                try {
                    const res = await fetch(`/admin/colors/restore/${id}`, { method: 'PATCH' });
                    const data = await res.json();
                    if (data.success) {
                        await Swal.fire('Restored!', data.message, 'success');
                        location.reload();
                    } else {
                        Swal.fire('Error', data.message, 'error');
                    }
                } catch (error) {
                    Swal.fire('Error', 'Something went wrong', 'error');
                }
            }
        }

        async function hardDeleteColor(id) {
            const result = await Swal.fire({
                title: 'Are you sure?',
                text: "This action will permanently delete this color from the database. It cannot be undone!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#EF4444',
                cancelButtonColor: '#6B7280',
                confirmButtonText: 'Yes, permanently delete!'
            });

            if (result.isConfirmed) {
                try {
                    const response = await fetch(`/admin/colors/hard-delete/${id}`, { method: 'DELETE' });
                    const data = await response.json();
                    if (data.success) {
                        Swal.fire('Permanently Deleted!', data.message, 'success').then(() => location.reload());
                    } else {
                        Swal.fire('Error', data.message, 'error');
                    }
                } catch (error) {
                    Swal.fire('Error', 'Something went wrong', 'error');
                }
            }
        }

        const statusFilter = document.getElementById('statusFilter');
        if (statusFilter) {
            statusFilter.addEventListener('change', function() {
                window.location.href = `/admin/colors?status=${this.value}`;
            });
        }
    </script>
</body>
</html>
