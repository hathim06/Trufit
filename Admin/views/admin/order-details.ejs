<%- include('partials/head') %>
<body>
    <%- include('partials/sidebar', { activePage: 'orders' }) %>

    <main class="main-content">
        <header class="page-header">
            <div class="header-left">
                <button class="toggle-btn" onclick="history.back()">
                    <i data-lucide="arrow-left"></i>
                </button>
                <h1 class="page-title">ORDER DETAILS - #<%= order.orderId %></h1>
            </div>
            <div class="header-right">
                <span class="status-badge <%= order.orderStatus === 'Delivered' ? 'status-listed' : (order.orderStatus === 'Cancelled' ? 'status-unlisted' : 'status-pending') %>">
                    <%= order.orderStatus.toUpperCase() %>
                </span>
            </div>
        </header>

        <div style="display: flex; flex-direction: column; gap: 30px;">
            <!-- Full-width Items Section -->
            <div style="display: flex; flex-direction: column; gap: 30px;">
                <!-- Items Table -->
                <div class="table-container" style="overflow-x: auto;">
                    <h2 style="font-size: 18px; margin-bottom: 20px;">Ordered Items</h2>
                    <table>
                        <thead>
                            <tr>
                                <th>PRODUCT</th>
                                <th>UNIT PRICE</th>
                                <th>QTY</th>
                                <th>TAX (0%)</th>
                                <th>DISCOUNT</th>
                                <th>TOTAL</th>
                                <th>STATUS</th>
                                <th>ACTION</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% order.items.forEach(item => { %>

                                <tr id="item-row-<%= item._id %>">
                                    <td>
                                        <div style="display: flex; align-items: center; gap: 15px;">
                                            <% 
                                                let itemImage = '/public/placeholder.png';
                                                if (item.variantId && item.variantId.image && item.variantId.image.length > 0) {
                                                    itemImage = item.variantId.image[0];
                                                } else if (item.productId && item.productId.image && item.productId.image.length > 0) {
                                                    itemImage = item.productId.image[0];
                                                }
                                            %>
                                            <img src="<%= itemImage %>" style="width: 50px; height: 50px; object-fit: cover; border-radius: 4px;">
                                            <div>
                                                <div style="font-weight: 600;"><%= item.name %></div>
                                                <div style="font-size: 12px; color: #6B7280;">
                                                    <%= item.variantId ? `Color: ${item.variantId.color}` : 'Standard' %>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>₹<%= (item.price || 0).toLocaleString() %></td>
                                    <td><%= item.quantity %></td>
                                    <td>₹0</td>
                                    <td>₹0</td>
                                    <td style="font-weight: 700;">₹<%= ((item.price || 0) * item.quantity).toLocaleString() %></td>
                                    <td>
                                        <span id="item-status-<%= item._id %>" class="status-badge <%= item.status === 'Delivered' ? 'status-listed' : (item.status === 'Cancelled' ? 'status-unlisted' : 'status-pending') %>" style="font-size: 11px;">
                                            <%= item.status %>
                                        </span>
                                    </td>
                                    <td>
                                        <% if (item.status === 'Return Pending') { %>
                                            <span style="color: #F59E0B; font-size: 12px; font-weight: 700;">Awaiting approval</span>
                                        <% } else if (item.status !== 'Cancelled' && item.status !== 'Returned') { %>
                                            <div style="display: flex; gap: 8px;">
                                                <select onchange="updateItemStatus('<%= order._id %>', '<%= item._id %>', this.value)" style="padding: 4px; border: 1px solid #D1D5DB; border-radius: 4px; font-size: 12px; background: white;">
                                                    <% if (item.status === 'Pending') { %>
                                                        <option value="Pending" selected>Pending</option>
                                                        <option value="Confirmed">Confirmed</option>
                                                    <% } else if (item.status === 'Confirmed') { %>
                                                        <option value="Confirmed" selected>Confirmed</option>
                                                        <option value="Shipped">Shipped</option>
                                                    <% } else if (item.status === 'Shipped') { %>
                                                        <option value="Shipped" selected>Shipped</option>
                                                        <option value="Out for Delivery">Out for Delivery</option>
                                                    <% } else if (item.status === 'Out for Delivery') { %>
                                                        <option value="Out for Delivery" selected>Out for Delivery</option>
                                                        <option value="Delivered">Delivered</option>
                                                    <% } else if (item.status === 'Delivered') { %>
                                                        <option value="Delivered" selected>Delivered</option>
                                                    <% } else { %>
                                                        <option value="<%= item.status %>" selected><%= item.status %></option>
                                                    <% } %>
                                                </select>
                                            </div>
                                        <% } else { %>
                                            <span style="color: #9CA3AF; font-size: 12px;">—</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>

                <!-- Order Summary -->
                <%
                    const computedSubtotal = order.items.reduce((sum, i) => {
                        const unitPrice = i.price || i.productId?.offerPrice || i.variantId?.price || i.productId?.price || 0;
                        return sum + (unitPrice * (i.quantity || 0));
                    }, 0);
                    const displaySubtotal  = (order.subtotal && order.subtotal > 0)       ? order.subtotal       : computedSubtotal;
                    const displayDiscount  = (order.discountAmount != null)               ? order.discountAmount  : 0;
                    const subtotalTotal    = Math.max(0, displaySubtotal - displayDiscount);
                    const displayTotal     = (order.totalAmount && order.totalAmount > 0) ? order.totalAmount     : subtotalTotal;
                %>
                <div class="table-container" style="max-width: 400px; align-self: flex-end;">
                    <div style="display: flex; flex-direction: column; gap: 10px; font-size: 14px;">
                        <div style="display: flex; justify-content: space-between;">
                            <span>Subtotal</span>
                            <span id="order-subtotal">₹<%= displaySubtotal.toLocaleString() %></span>
                        </div>
                        <div style="display: flex; justify-content: space-between; color: #10B981;">
                            <span>Discount</span>
                            <span>-₹<%= displayDiscount.toLocaleString() %></span>
                        </div>
                        <div style="display: flex; justify-content: space-between;">
                            <span>Payment Method</span>
                            <span style="font-weight: 600;"><%= order.paymentMethod %></span>
                        </div>
                        <div style="display: flex; justify-content: space-between; font-weight: 700; font-size: 18px; border-top: 1px solid #E5E7EB; margin-top: 10px; padding-top: 10px;">
                            <span>Grand Total</span>
                            <span id="order-total">₹<%= displayTotal.toLocaleString() %></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Info Cards Row -->
            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;">
                <!-- User Details -->
                <div class="table-container">
                    <h2 style="font-size: 16px; margin-bottom: 20px; display: flex; align-items: center; gap: 10px;">
                        <i data-lucide="user" style="width: 18px;"></i> CUSTOMER DETAILS
                    </h2>
                    <div style="font-size: 14px; line-height: 1.6;">
                        <strong><%= order.userId ? order.userId.firstName + ' ' + order.userId.lastName : 'Guest User' %></strong><br>
                        <span style="color: #6B7280;"><%= order.userId ? order.userId.email : 'N/A' %></span><br>
                        <span style="color: #6B7280;"><%= order.userId ? order.userId.mobile : 'N/A' %></span>
                    </div>
                </div>

                <!-- Shipping Address -->
                <div class="table-container">
                    <h2 style="font-size: 16px; margin-bottom: 20px; display: flex; align-items: center; gap: 10px;">
                        <i data-lucide="map-pin" style="width: 18px;"></i> SHIPPING ADDRESS
                    </h2>
                    <div style="font-size: 14px; line-height: 1.6; color: #4B5563;">
                        <strong><%= order.shippingAddress.name %></strong><br>
                        <%= order.shippingAddress.addressLine %><br>
                        <%= order.shippingAddress.city %>, <%= order.shippingAddress.district %><br>
                        <%= order.shippingAddress.state %> - <%= order.shippingAddress.pincode %><br>
                        <strong>Mobile: <%= order.shippingAddress.mobile %></strong>
                    </div>
                </div>

                <!-- Payment Info -->
                <div class="table-container">
                    <h2 style="font-size: 16px; margin-bottom: 20px; display: flex; align-items: center; gap: 10px;">
                        <i data-lucide="credit-card" style="width: 18px;"></i> PAYMENT INFO
                    </h2>
                    <div style="font-size: 14px;">
                        <div style="margin-bottom: 5px;">Method: <strong><%= order.paymentMethod %></strong></div>
                        <div>Status: <span class="status-badge <%= order.paymentStatus === 'Paid' ? 'status-listed' : 'status-unlisted' %>"><%= order.paymentStatus %></span></div>
                    </div>
                </div>

                <!-- Return Reason (If applicable) -->
                <% if ((order.orderStatus === 'Returned' || order.orderStatus === 'Return Pending') && order.returnReason) { %>
                <div class="table-container" style="border: 1px solid #F59E0B; background: #FFFBEB; margin-top: 20px;">
                    <h2 style="font-size: 16px; margin-bottom: 10px; display: flex; align-items: center; gap: 10px; color: #B45309;">
                        <i data-lucide="info" style="width: 18px;"></i> RETURN REASON
                    </h2>
                    <div style="font-size: 14px; color: #92400E; font-weight: 500; line-height: 1.5;">
                        "<%= order.returnReason %>"
                    </div>
                </div>
                <% } %>
            </div>
        </div>
    </main>

    <!-- Cancel Item Confirmation Modal -->
    <div id="cancelItemModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.5); z-index:1000; align-items:center; justify-content:center;">
        <div style="background:#fff; border-radius:12px; padding:32px; max-width:420px; width:90%; box-shadow: 0 20px 60px rgba(0,0,0,0.3);">
            <div style="display:flex; align-items:center; gap:12px; margin-bottom:16px;">
                <div style="background:#FEF2F2; border-radius:50%; width:44px; height:44px; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                    <i data-lucide="x-circle" style="width:22px; height:22px; color:#EF4444;"></i>
                </div>
                <h3 style="font-size:18px; font-weight:700; color:#111827; margin:0;">Cancel Item</h3>
            </div>
            <p id="cancelItemText" style="font-size:14px; color:#6B7280; margin-bottom:24px; line-height:1.6;"></p>
            <div style="display:flex; gap:12px; justify-content:flex-end;">
                <button onclick="closeCancelModal()" style="padding:10px 20px; border:1px solid #D1D5DB; border-radius:6px; background:#fff; font-weight:600; font-size:14px; cursor:pointer; color:#374151;">
                    Keep Item
                </button>
                <button id="confirmCancelBtn" onclick="confirmCancelItem()" style="padding:10px 20px; border:none; border-radius:6px; background:#EF4444; color:#fff; font-weight:700; font-size:14px; cursor:pointer;">
                    Cancel Item
                </button>
            </div>
        </div>
    </div>

    <script>
        lucide.createIcons();

        let pendingCancelData = null;

        async function updateItemStatus(orderId, itemId, status) {
            try {
                const response = await fetch(`/admin/orders/item-status/${orderId}`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ itemId, status })
                });
                const data = await response.json();
                if (data.success) {
                    showToast('Item status updated successfully', 'success');
                    setTimeout(() => window.location.reload(), 1000);
                } else {
                    showToast(data.message || 'Failed to update item status', 'error');
                }
            } catch (err) {
                showToast('Something went wrong', 'error');
            }
        }

        function cancelItem(orderId, itemId, itemName) {
            pendingCancelData = { orderId, itemId };
            document.getElementById('cancelItemText').textContent =
                `Are you sure you want to cancel "${itemName}"? The stock will be restored automatically.`;
            const modal = document.getElementById('cancelItemModal');
            modal.style.display = 'flex';
        }

        function closeCancelModal() {
            document.getElementById('cancelItemModal').style.display = 'none';
            pendingCancelData = null;
        }

        async function confirmCancelItem() {
            if (!pendingCancelData) return;

            const { orderId, itemId } = pendingCancelData;
            const confirmBtn = document.getElementById('confirmCancelBtn');
            confirmBtn.textContent = 'Cancelling...';
            confirmBtn.disabled = true;

            try {
                const response = await fetch(`/admin/orders/cancel-item/${orderId}`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ itemId })
                });

                const data = await response.json();

                if (data.success) {
                    closeCancelModal();
                    // Update item status badge in the table
                    const statusEl = document.getElementById(`item-status-${itemId}`);
                    if (statusEl) {
                        statusEl.textContent = 'Cancelled';
                        statusEl.className = 'status-badge status-unlisted';
                        statusEl.style.fontSize = '11px';
                    }
                    // Hide the cancel button for this item
                    const btn = document.getElementById(`cancel-btn-${itemId}`);
                    if (btn) {
                        btn.parentElement.innerHTML = '<span style="color:#9CA3AF; font-size:12px;">—</span>';
                    }
                    showToast(data.message, 'success');
                } else {
                    showToast(data.message || 'Failed to cancel item', 'error');
                }
            } catch (err) {
                showToast('Something went wrong. Please try again.', 'error');
            } finally {
                confirmBtn.textContent = 'Cancel Item';
                confirmBtn.disabled = false;
                closeCancelModal();
            }
        }

        // Close modal when clicking outside
        document.getElementById('cancelItemModal').addEventListener('click', function(e) {
            if (e.target === this) closeCancelModal();
        });

        function showToast(message, type) {
            const toast = document.createElement('div');
            toast.style.cssText = `
                position: fixed; bottom: 24px; right: 24px; z-index: 9999;
                background: ${type === 'success' ? '#10B981' : '#EF4444'};
                color: #fff; padding: 14px 20px; border-radius: 8px;
                font-size: 14px; font-weight: 600;
                box-shadow: 0 4px 20px rgba(0,0,0,0.2);
                animation: slideIn 0.3s ease;
            `;
            toast.textContent = message;
            document.body.appendChild(toast);
            setTimeout(() => toast.remove(), 3500);
        }
    </script>
</body>
</html>
