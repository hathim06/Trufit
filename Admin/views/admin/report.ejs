<%- include('partials/head') %>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<body>
    <%- include('partials/sidebar', { activePage: 'report' }) %>

    <main class="main-content">
        <!-- Mock internal header from screenshot -->
        <div style="background: #FFF; padding: 20px; border-radius: 12px; margin-bottom: 30px; display: flex; justify-content: center; align-items: center; flex-direction: column; position: relative;">
            <div style="display: flex; align-items: center; gap: 10px;">
                <i data-lucide="watch" style="width: 24px;"></i>
                <div style="font-weight: 700;">Trufit</div>
            </div>
            <div style="font-size: 12px; letter-spacing: 2px;">SMART WATCH</div>
            <i data-lucide="log-out" style="position: absolute; right: 20px; top: 20px; width: 18px; color: #666; cursor: pointer;"></i>
        </div>

        <div style="text-align: center; margin-bottom: 40px;">
            <h1 class="page-title">SALES REPORT</h1>
        </div>

        <div style="display: flex; justify-content: flex-end; gap: 15px; margin-bottom: 30px;">
            <select style="width: 200px;">
                <option>Last Month</option>
                <option>Last Week</option>
                <option>Last Year</option>
            </select>
            <button class="btn btn-primary">Download</button>
        </div>

        <div class="stats-grid">
            <div class="stat-card" style="background: #000; color: #FFF;">
                <div class="stat-info">
                    <h3 style="color: #AAA;">Total Revenue</h3>
                    <div class="value">₹ 1,45,551</div>
                    <div style="font-size: 10px; color: #059669; margin-top: 5px;">Last 30 Days Revenue</div>
                </div>
                <div class="stat-icon" style="background: rgba(255,255,255,0.1);">
                    <i data-lucide="indian-rupee" style="color: #059669;"></i>
                </div>
            </div>
            <div class="stat-card" style="background: #000; color: #FFF;">
                <div class="stat-info">
                    <h3 style="color: #AAA;">Orders</h3>
                    <div class="value">210</div>
                    <div style="font-size: 10px; color: #059669; margin-top: 5px;">Last 30 Days Orders</div>
                </div>
                <div class="stat-icon" style="background: rgba(255,255,255,0.1);">
                    <i data-lucide="shopping-cart" style="color: #059669;"></i>
                </div>
            </div>
            <div class="stat-card" style="background: #000; color: #FFF;">
                <div class="stat-info">
                    <h3 style="color: #AAA;">Products</h3>
                    <div class="value">1,524</div>
                    <div style="font-size: 10px; color: #059669; margin-top: 5px;">Last 30 Days Products</div>
                </div>
                <div class="stat-icon" style="background: rgba(255,255,255,0.1);">
                    <i data-lucide="package" style="color: #059669;"></i>
                </div>
            </div>
            <div class="stat-card" style="background: #000; color: #FFF;">
                <div class="stat-info">
                    <h3 style="color: #AAA;">Customers</h3>
                    <div class="value">922</div>
                    <div style="font-size: 10px; color: #059669; margin-top: 5px;">Last 30 Days Customers</div>
                </div>
                <div class="stat-icon" style="background: rgba(255,255,255,0.1);">
                    <i data-lucide="users" style="color: #059669;"></i>
                </div>
            </div>
        </div>

        <div class="chart-container" style="display: grid; gap: 30px;">
            <div class="table-container">
                <div class="table-header">
                    <h2>Order Summary</h2>
                </div>
                <canvas id="orderSummaryChart" height="100"></canvas>
            </div>
            <div class="table-container">
                <div class="table-header">
                    <h2>Revenue Overview</h2>
                </div>
                <canvas id="revenueOverviewChart" height="100"></canvas>
            </div>
        </div>
    </main>

    <script>
        lucide.createIcons();

        // Order Summary Chart
        const orderCtx = document.getElementById('orderSummaryChart').getContext('2d');
        new Chart(orderCtx, {
            type: 'bar',
            data: {
                labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
                datasets: [{
                    label: 'Orders',
                    data: [450, 210, 110, 80, 150, 380, 520, 320, 150, 580, 70, 240],
                    backgroundColor: '#B4A7FF',
                    borderRadius: 5
                }]
            },
            options: {
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true } }
            }
        });

        // Revenue Overview Chart
        const revenueCtx = document.getElementById('revenueOverviewChart').getContext('2d');
        new Chart(revenueCtx, {
            type: 'line',
            data: {
                labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
                datasets: [{
                    label: 'Revenue',
                    data: [20, 30, 45, 25, 60, 15, 40, 95, 20, 35, 10, 50],
                    borderColor: '#B4A7FF',
                    tension: 0.4,
                    fill: false
                }]
            },
            options: {
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true } }
            }
        });
    </script>
</body>
</html>
