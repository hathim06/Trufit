<%- include('partials/head') %>
<style>
    .banner-preview-box {
        width: 100%;
        height: 250px;
        border: 2px dashed #D1D5DB;
        border-radius: 12px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        overflow: hidden;
        position: relative;
        transition: all 0.3s ease;
        background: #F9FAFB;
    }
    .banner-preview-box:hover {
        border-color: #000;
        background: #F3F4F6;
    }
    .banner-preview-box img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .plus-icon {
        width: 48px;
        height: 48px;
        color: #9CA3AF;
        margin-bottom: 10px;
        display: none;
    }
    .banner-preview-box.no-image .plus-icon {
        display: block;
    }
    .banner-preview-box.no-image img {
        display: none;
    }

    /* Cropper Modal */
    .cropper-modal {
        position: fixed;
        top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(0,0,0,0.8);
        z-index: 9999;
        display: none;
        align-items: center;
        justify-content: center;
    }
    .cropper-modal.active {
        display: flex !important;
    }
    .cropper-container {
        background: #fff;
        width: 90%;
        max-width: 1000px;
        border-radius: 12px;
        overflow: hidden;
    }
    .cropper-header {
        padding: 15px 25px;
        border-bottom: 1px solid #E5E7EB;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .cropper-content {
        max-height: 60vh;
        overflow: hidden;
        background: #000;
    }
    .cropper-footer {
        padding: 15px 25px;
        border-top: 1px solid #E5E7EB;
        display: flex;
        justify-content: flex-end;
        gap: 15px;
    }
</style>

<body>
    <%- include('partials/sidebar', { activePage: 'banners' }) %>

    <main class="main-content">
        <header class="page-header">
            <h1 class="page-title">EDIT BANNER</h1>
        </header>

        <div class="table-container" style="max-width: 900px; margin: 0 auto; padding: 40px;">
            <form id="bannerForm" action="/admin/update-banner/<%= banner._id %>" method="POST" enctype="multipart/form-data">
                <div class="form-group" style="margin-bottom: 30px;">
                    <label style="display: block; margin-bottom: 15px; font-weight: 600;">Banner Image</label>
                    <div class="banner-preview-box <%= !banner.image ? 'no-image' : '' %>" id="bannerPreviewBox">
                        <input type="file" id="imageInput" style="display: none;" accept="image/*">
                        <input type="hidden" name="image" id="croppedImageData">
                        <i data-lucide="plus-circle" class="plus-icon"></i>
                        <img id="imagePreview" src="/<%= banner.image %>" alt="Preview">
                        <div style="position: absolute; bottom: 10px; right: 10px; background: rgba(0,0,0,0.6); color: #fff; padding: 5px 12px; border-radius: 20px; font-size: 12px;">Click to Change</div>
                    </div>
                </div>

                <div class="form-group" style="margin-bottom: 20px;">
                    <label style="display: block; margin-bottom: 8px; font-weight: 600;">Title</label>
                    <input type="text" name="title" value="<%= banner.title %>" placeholder="Enter banner title" required
                           style="width: 100%; padding: 12px; border: 1px solid #E5E7EB; border-radius: 8px;">
                </div>

                <div class="form-group" style="margin-bottom: 20px;">
                    <label style="display: block; margin-bottom: 8px; font-weight: 600;">Subtitle</label>
                    <input type="text" name="subtitle" value="<%= banner.subtitle %>" placeholder="Enter banner subtitle"
                           style="width: 100%; padding: 12px; border: 1px solid #E5E7EB; border-radius: 8px;">
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
                    <div class="form-group">
                        <label style="display: block; margin-bottom: 8px; font-weight: 600;">Link URL</label>
                        <input type="text" name="link" value="<%= banner.link %>" placeholder="/shop"
                               style="width: 100%; padding: 12px; border: 1px solid #E5E7EB; border-radius: 8px;">
                    </div>
                    <div class="form-group">
                        <label style="display: block; margin-bottom: 8px; font-weight: 600;">Display Order</label>
                        <input type="number" name="order" value="<%= banner.order %>" placeholder="0"
                               style="width: 100%; padding: 12px; border: 1px solid #E5E7EB; border-radius: 8px;">
                    </div>
                </div>

                <div class="form-group" style="margin-bottom: 20px;">
                    <label style="display: block; margin-bottom: 8px; font-weight: 600;">Status</label>
                    <select name="status" style="width: 100%; padding: 12px; border: 1px solid #E5E7EB; border-radius: 8px;">
                        <option value="Active" <%= banner.status === 'Active' ? 'selected' : '' %>>Active</option>
                        <option value="Inactive" <%= banner.status === 'Inactive' ? 'selected' : '' %>>Inactive</option>
                    </select>
                </div>

                <div style="display: flex; justify-content: flex-end; gap: 15px; margin-top: 40px;">
                    <a href="/admin/banners" class="btn" style="background: #E5E7EB; color: #000; text-decoration: none; display: flex; align-items: center; justify-content: center; padding: 10px 25px; border-radius: 8px; font-weight: 600;">CANCEL</a>
                    <button type="submit" class="btn btn-primary" style="padding: 10px 40px; border-radius: 8px; font-weight: 600;">SAVE CHANGES</button>
                </div>
            </form>
        </div>

        <!-- Cropper Modal -->
        <div id="cropperModal" class="cropper-modal">
            <div class="cropper-container">
                <div class="cropper-header">
                    <h2 style="font-size: 18px; font-weight: 700;">Crop Banner Image</h2>
                    <button type="button" onclick="closeCropper()" style="background: none; border: none; cursor: pointer;">
                        <i data-lucide="x"></i>
                    </button>
                </div>
                <div class="cropper-content">
                    <img id="cropperImage" style="max-width: 100%;">
                </div>
                <div class="cropper-footer">
                    <div style="flex-grow: 1; display: flex; gap: 10px;">
                        <button type="button" class="toolbar-btn" style="padding: 8px; background: #F3F4F6; border: none; border-radius: 6px; cursor: pointer;" onclick="cropper.rotate(-90)"><i data-lucide="rotate-ccw"></i></button>
                        <button type="button" class="toolbar-btn" style="padding: 8px; background: #F3F4F6; border: none; border-radius: 6px; cursor: pointer;" onclick="cropper.rotate(90)"><i data-lucide="rotate-cw"></i></button>
                        <button type="button" class="toolbar-btn" style="padding: 8px; background: #F3F4F6; border: none; border-radius: 6px; cursor: pointer;" onclick="cropper.zoom(0.1)"><i data-lucide="zoom-in"></i></button>
                        <button type="button" class="toolbar-btn" style="padding: 8px; background: #F3F4F6; border: none; border-radius: 6px; cursor: pointer;" onclick="cropper.zoom(-0.1)"><i data-lucide="zoom-out"></i></button>
                    </div>
                    <button type="button" class="btn" onclick="closeCropper()" style="background: #F3F4F6;">Cancel</button>
                    <button type="button" class="btn btn-primary" onclick="applyCrop()">Apply Crop</button>
                </div>
            </div>
        </div>
    </main>

    <script>
        lucide.createIcons();

        let cropper = null;
        const bannerPreviewBox = document.getElementById('bannerPreviewBox');
        const imageInput = document.getElementById('imageInput');
        const imagePreview = document.getElementById('imagePreview');
        const cropperModal = document.getElementById('cropperModal');
        const cropperImage = document.getElementById('cropperImage');
        const croppedImageData = document.getElementById('croppedImageData');

        bannerPreviewBox.addEventListener('click', () => imageInput.click());

        imageInput.addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                // --- ADDED VALIDATION ---
                const allowedTypes = ['image/jpeg', 'image/png', 'image/jpg', 'image/webp'];
                const allowedExtensions = ['jpg', 'jpeg', 'png', 'webp'];
                const extension = file.name.split('.').pop().toLowerCase();

                if (!allowedTypes.includes(file.type) || !allowedExtensions.includes(extension)) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Invalid File Type',
                        text: 'Only image files (JPG, JPEG, PNG, WEBP) are allowed!',
                        confirmButtonColor: '#000'
                    });
                    imageInput.value = '';
                    return;
                }

                if (file.size > 5 * 1024 * 1024) {
                    Swal.fire({
                        icon: 'error',
                        title: 'File Too Large',
                        text: 'Maximum file size is 5MB!',
                        confirmButtonColor: '#000'
                    });
                    imageInput.value = '';
                    return;
                }
                // -------------------------

                const reader = new FileReader();
                reader.onload = function(event) {
                    cropperImage.src = event.target.result;
                    cropperModal.classList.add('active');
                    
                    if (cropper) cropper.destroy();
                    cropper = new Cropper(cropperImage, {
                        aspectRatio: 1920 / 800,
                        viewMode: 1,
                        background: false
                    });
                };
                reader.readAsDataURL(file);
            }
        });

        function closeCropper() {
            cropperModal.classList.remove('active');
            imageInput.value = '';
        }

        function applyCrop() {
            const canvas = cropper.getCroppedCanvas({
                width: 1920,
                height: 800
            });
            
            imagePreview.src = canvas.toDataURL('image/jpeg', 0.9);
            bannerPreviewBox.classList.remove('no-image');
            croppedImageData.value = canvas.toDataURL('image/jpeg', 0.9);
            cropperModal.classList.remove('active');
        }
    </script>
</body>
</html>
