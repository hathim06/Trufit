<%- include('partials/head') %>
<body>
    <%- include('partials/sidebar', { activePage: 'report' }) %>
    <main class="main-content sales-report-page">
        <%- include('./partials/adminHeader', { title: 'SALES REPORT' }) %>

        <section class="report-toolbar">
            <form action="/admin/sales-report" method="GET" class="report-filter-form" novalidate>
                <select name="filterType" onchange="toggleCustomDates(this.value)" aria-label="Report filter">
                    <option value="" disabled <%= !locals.filterType ? 'selected' : '' %>>Select Filter</option>
                    <option value="daily" <%= locals.filterType === 'daily' ? 'selected' : '' %>>Daily</option>
                    <option value="weekly" <%= locals.filterType === 'weekly' ? 'selected' : '' %>>Weekly</option>
                    <option value="monthly" <%= locals.filterType === 'monthly' ? 'selected' : '' %>>Monthly</option>
                    <option value="yearly" <%= locals.filterType === 'yearly' ? 'selected' : '' %>>Yearly</option>
                    <option value="custom" <%= locals.filterType === 'custom' ? 'selected' : '' %>>Custom Range</option>
                </select>

                <div id="customDates" class="custom-dates-wrapper">
                    <input type="date" name="startDate" value="<%= locals.startDate || '' %>" aria-label="Start date">
                    <input type="date" name="endDate" value="<%= locals.endDate || '' %>" aria-label="End date">
                </div>

                <button type="submit" class="btn btn-primary">Filter</button>
            </form>

            <div class="report-actions">
                <a href="/admin/sales-report/download/pdf?filterType=<%= locals.filterType || '' %>&startDate=<%= locals.startDate || '' %>&endDate=<%= locals.endDate || '' %>" class="btn btn-primary">PDF</a>
                <a href="/admin/sales-report/download/excel?filterType=<%= locals.filterType || '' %>&startDate=<%= locals.startDate || '' %>&endDate=<%= locals.endDate || '' %>" class="btn btn-primary">Excel</a>
            </div>
        </section>

        <% if (typeof validationMessage !== 'undefined' && validationMessage) { %>
            <div class="validation-banner"><%= validationMessage %></div>
        <% } %>

        <section class="report-summary">
            <div class="summary-panel">
                <div>
                    <span>Total Order Amount</span>
                    <strong>Rs. <%= totalOrderAmount.toLocaleString() %></strong>
                </div>
                <i data-lucide="indian-rupee"></i>
            </div>
            <div class="summary-panel">
                <div>
                    <span>Total Sales Count</span>
                    <strong><%= totalSalesCount.toLocaleString() %></strong>
                </div>
                <i data-lucide="shopping-cart"></i>
            </div>
            <div class="summary-panel">
                <div>
                    <span>Total Discounts Applied</span>
                    <strong>Rs. <%= totalDiscount.toLocaleString() %></strong>
                </div>
                <i data-lucide="percent"></i>
            </div>
        </section>

        <section class="table-container report-table">
            <div class="table-header">
                <h2>Delivered Orders</h2>
                <span><%= totalSalesCount.toLocaleString() %> records</span>
            </div>
            <table>
                <thead>
                    <tr>
                        <th>Order ID</th>
                        <th>Customer</th>
                        <th>Date</th>
                        <th>Total</th>
                        <th>Discount</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (orders && orders.length > 0) { %>
                        <% orders.forEach(order => { %>
                            <tr>
                                <td><strong><%= order.orderId %></strong></td>
                                <td><%= order.customer %></td>
                                <td><%= new Date(order.date).toLocaleDateString('en-GB') %></td>
                                <td>Rs. <%= order.total.toLocaleString() %></td>
                                <td>Rs. <%= order.discount.toLocaleString() %></td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="5" class="empty-report">No delivered orders found for the selected period.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </section>
    </main>

    <style>
        .sales-report-page { background: #F6F7F9; }
        .report-toolbar {
            display: flex;
            justify-content: space-between;
            gap: 16px;
            align-items: center;
            margin: 24px 0;
            background: #FFF;
            border: 1px solid #E5E7EB;
            border-radius: 8px;
            padding: 16px;
        }
        .report-filter-form, .report-actions, .custom-dates-wrapper {
            display: flex;
            gap: 10px;
            align-items: center;
            flex-wrap: wrap;
        }
        .report-toolbar select, .report-toolbar input { min-height: 40px; }
        .report-actions .btn { text-decoration: none; min-width: 76px; text-align: center; }
        .custom-dates-wrapper { display: none; }
        .report-toolbar select:invalid { color: #9CA3AF; }
        .report-toolbar option[value=""] { display: none; }
        .custom-dates-wrapper.visible { display: flex; }
        .report-summary {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 16px;
            margin-bottom: 24px;
        }
        .summary-panel {
            background: #111827;
            color: #FFF;
            border-radius: 8px;
            padding: 22px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            min-height: 118px;
        }
        .summary-panel span {
            display: block;
            color: #A7F3D0;
            font-size: 12px;
            text-transform: uppercase;
            font-weight: 700;
            margin-bottom: 8px;
        }
        .summary-panel strong { font-size: 26px; }
        .summary-panel i { width: 34px; height: 34px; color: #34D399; }
        .validation-banner {
            margin: 0 0 16px;
            padding: 12px 16px;
            border-radius: 8px;
            background: #FEF2F2;
            color: #B91C1C;
            border: 1px solid #FECACA;
            font-weight: 600;
        }
        .report-table { border-radius: 8px; overflow-x: auto; }
        .report-table .table-header span { color: #6B7280; font-size: 13px; font-weight: 600; }
        .report-table th { background: #F9FAFB; text-transform: uppercase; font-size: 12px; }
        .report-table td, .report-table th { white-space: nowrap; }
        .empty-report { text-align: center; color: #6B7280; padding: 40px; }
        @media (max-width: 900px) {
            .report-toolbar { align-items: stretch; flex-direction: column; }
            .report-summary { grid-template-columns: 1fr; }
        }
    </style>

    <script>
        lucide.createIcons();

        (function () {
            const currentFilter = '<%= locals.filterType || "" %>';
            const customDatesDiv = document.getElementById('customDates');
            if (currentFilter === 'custom') customDatesDiv.classList.add('visible');
        })();

        function toggleCustomDates(value) {
            const customDatesDiv = document.getElementById('customDates');
            customDatesDiv.classList.toggle('visible', value === 'custom');
        }

        document.querySelector('.report-filter-form')?.addEventListener('submit', function (event) {
            const filterType = this.querySelector('select[name="filterType"]').value;
            const startDate = this.querySelector('input[name="startDate"]').value;
            const endDate = this.querySelector('input[name="endDate"]').value;

            if (filterType === 'custom') {
                if (!startDate || !endDate) {
                    event.preventDefault();
                    alert('Please choose both start and end dates for a custom range.');
                    return;
                }
                if (startDate > endDate) {
                    event.preventDefault();
                    alert('The start date cannot be after the end date.');
                    return;
                }
                
                const today = new Date().toISOString().split('T')[0];
                if (endDate > today) {
                    event.preventDefault();
                    alert('The end date cannot be in the future.');
                }
            }
        });
    </script>
</body>
</html>
