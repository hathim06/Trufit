<%- include('partials/head') %>
<body>
    <%- include('partials/sidebar', { activePage: 'categories' }) %>

    <main class="main-content">
        <%- include('./partials/adminHeader', { title: 'ADD CATEGORY' }) %>

        <div class="table-container" style="max-width: 600px; margin: 0 auto; padding: 40px;">
            <% if (typeof message !== 'undefined' && message) { %>
                <div style="background:#FEE2E2;color:#991B1B;padding:12px 20px;border-radius:8px;margin-bottom:20px;"><%= message %></div>
            <% } %>

            <form action="/admin/add-category" method="POST">
                <div class="form-group">
                    <label>Category Name <span style="color:red;">*</span></label>
                    <input type="text" name="name" placeholder="e.g. Smart Watch" required>
                </div>

                <div class="form-group">
                    <label>Description (optional)</label>
                    <textarea name="description" rows="3" placeholder="Brief description of this category..." style="width:100%; padding:10px; border:1px solid var(--border); border-radius:8px; resize:vertical;"></textarea>
                </div>

                <div style="margin-top: 30px; display: flex; gap: 15px;">
                    <button type="submit" class="btn btn-primary" style="width: 200px;">ADD CATEGORY</button>
                    <button type="button" class="btn" onclick="location.href='/admin/categories'" style="background:#F3F4F6; color:#374151; padding: 10px 24px; border-radius: 8px; border: none; cursor: pointer; font-weight: 600;">CANCEL</button>
                </div>
            </form>
        </div>
    </main>

    <script>lucide.createIcons();</script>
</body>
</html>
