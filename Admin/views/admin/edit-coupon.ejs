<%- include('partials/head') %>
<body>
    <%- include('partials/sidebar', { activePage: 'coupons' }) %>

    <main class="main-content">
        <!-- Mock internal header from screenshot -->
        <div style="background: #FFF; padding: 20px; border-radius: 12px; margin-bottom: 30px; display: flex; justify-content: center; align-items: center; flex-direction: column; position: relative; border: 1px solid var(--border);">
            <div style="display: flex; align-items: center; gap: 10px;">
                <i data-lucide="watch" style="width: 24px;"></i>
                <div style="font-weight: 700;">Trufit</div>
            </div>
            <div style="font-size: 12px; letter-spacing: 2px;">SMART WATCH</div>
            <i data-lucide="log-out" style="position: absolute; right: 20px; top: 20px; width: 18px; color: #666; cursor: pointer;"></i>
        </div>

        <div style="text-align: center; margin-bottom: 40px;">
            <h1 class="page-title">EDIT COUPON</h1>
        </div>

        <div class="table-container" style="max-width: 800px; margin: 0 auto; padding: 40px;">
            <% if (typeof errors !== 'undefined' && errors && errors.length) { %>
                <div style="background: #FEE2E2; color: #991B1B; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; font-size: 13px; line-height: 1.6;">
                    <% errors.forEach(error => { %><div><%= error %></div><% }) %>
                </div>
            <% } else if (message) { %>
                <p style="background: #FEE2E2; color: #DC2626; padding: 10px; border-radius: 6px; text-align: center; margin-bottom: 20px;"><%= message %></p>
            <% } %>
            <form action="/admin/edit-coupon/<%= coupon._id %>" method="POST">
                <div class="form-group">
                    <label>COUPON CODE</label>
                    <input type="text" name="couponCode" value="<%= formData.couponCode || coupon.couponCode %>" placeholder="Enter coupon code" required minlength="3" maxlength="20" pattern="[A-Za-z0-9_-]+" title="Use letters, numbers, hyphen, or underscore only">
                </div>

                <div class="form-group">
                    <label>COUPON DESCRIPTION</label>
                    <textarea name="description" class="description-area" style="min-height: 100px;" required minlength="5" maxlength="200"><%= formData.description || coupon.description %></textarea>
                </div>

                <div class="form-grid">
                    <div class="form-group">
                        <label>START DATE</label>
                        <input type="date" name="startDate" value="<%= formData.startDate || new Date(coupon.startDate).toISOString().split('T')[0] %>" required>
                    </div>
                    <div class="form-group">
                        <label>EXPIRY DATE</label>
                        <input type="date" name="expiryDate" value="<%= formData.expiryDate || new Date(coupon.expiryDate).toISOString().split('T')[0] %>" required>
                    </div>
                </div>

                <div class="form-grid">
                    <div class="form-group" style="flex: 1;">
                        <label>MINIMUM PURCHASE AMOUNT</label>
                        <input type="number" name="minPurchase" value="<%= formData.minPurchase || coupon.minPurchase %>" placeholder="Enter amount" required min="0" step="0.01">
                    </div>
                    <div class="form-group" style="flex: 1;">
                        <label>STATUS</label>
                        <select name="status">
                            <option value="Active" <%= coupon.status === 'Active' ? 'selected' : '' %>>Active</option>
                            <option value="Expired" <%= coupon.status === 'Expired' ? 'selected' : '' %>>Expired</option>
                            <option value="Inactive" <%= coupon.status === 'Inactive' ? 'selected' : '' %>>Inactive</option>
                        </select>
                    </div>
                </div>

                <div class="form-grid">
                    <div class="form-group">
                        <label>DISCOUNT PERCENTAGE</label>
                        <input type="number" name="discount" value="<%= formData.discount || coupon.discountPercentage %>" placeholder="Enter percentage" required min="1" max="100" step="0.01">
                    </div>
                    <div class="form-group">
                        <label>MAX DISCOUNT LIMIT</label>
                        <input type="number" name="maxDiscountAmount" value="<%= formData.maxDiscountAmount || coupon.maxDiscountAmount || '' %>" placeholder="Enter max amount" required min="1" step="0.01">
                    </div>
                </div>

                <div class="form-grid">
                    <div class="form-group" style="flex: 1;">
                        <label>TOTAL COUPONS AVAILABLE</label>
                        <input type="number" name="maxUsage" value="<%= formData.maxUsage || coupon.maxUsage || 100 %>" required min="1">
                    </div>
                    <div class="form-group" style="flex: 1;">
                        <label>PER USER LIMIT</label>
                        <input type="number" name="perUserLimit" value="<%= formData.perUserLimit || coupon.perUserLimit || 1 %>" required min="1">
                    </div>
                </div>

                <div style="display: flex; justify-content: center; margin-top: 40px;">
                    <button type="submit" class="btn btn-primary" style="padding: 12px 60px;">UPDATE COUPON</button>
                </div>
            </form>
        </div>
    </main>

    <script>
        lucide.createIcons();
    </script>
</body>
</html>


