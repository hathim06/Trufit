<!DOCTYPE html>
<html lang="en">

<%- include('partials/head') %>
    <style>
        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .auth-container {
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 80px 20px;
        }

        .auth-box {
            width: 100%;
            max-width: 500px;
            border: 1px solid #E5E7EB;
            padding: 40px;
            background: #FFFFFF;
            text-align: center;
        }

        .auth-box h1 {
            font-size: 24px;
            margin-bottom: 10px;
            font-weight: 700;
        }

        .success-msg {
            font-size: 10px;
            font-weight: 600;
            color: #4B5563;
            text-transform: uppercase;
            margin-bottom: 25px;
            letter-spacing: 0.5px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
            text-align: left;
            margin-bottom: 20px;
        }

        .form-group label {
            font-size: 11px;
            font-weight: 700;
            color: #000;
            text-transform: uppercase;
        }

        .form-group input {
            padding: 12px 20px;
            border: 1px solid #D1D5DB;
            border-radius: 4px;
            font-family: inherit;
            font-size: 14px;
            outline: none;
        }

        .submit-btn {
            width: 100%;
            background: #000;
            color: #FFF;
            padding: 12px;
            border: none;
            border-radius: 4px;
            font-weight: 700;
            font-size: 14px;
            cursor: pointer;
            margin-top: 10px;
            transition: var(--transition);
        }

        .submit-btn:hover {
            opacity: 0.9;
        }
    </style>
    </head>

    <body>

        <main class="auth-container">
            <div class="auth-box">
                <h1>Reset Password</h1>
                <p class="success-msg">Please enter the OTP sent to your email</p>

                <%- include('partials/alerts') %>
                <form action="/users/reset-password" method="post" id="resetForm">
                    <div class="form-group">
                        <label>Enter OTP</label>
                        <span id="otp-error" class="error-message"></span>
                        <input type="text" name="otp" id="otp" placeholder="XXXX" maxlength="4" required 
                               style="text-align: center; letter-spacing: 5px; font-weight: 700; font-size: 18px;">
                    </div>
                    <div class="form-group">
                        <label>NEW PASSWORD</label>
                        <span id="password-error" class="error-message"></span>
                        <div class="password-wrapper">
                            <input type="password" name="password" id="password" required>
                            <span class="toggle-password" onclick="togglePassword('password')">
                                <i data-lucide="eye"></i>
                            </span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>RE-ENTER PASSWORD</label>
                        <span id="confirmPassword-error" class="error-message"></span>
                        <div class="password-wrapper">
                            <input type="password" name="confirmPassword" id="confirmPassword" required>
                            <span class="toggle-password" onclick="togglePassword('confirmPassword')">
                                <i data-lucide="eye"></i>
                            </span>
                        </div>
                    </div>
                    <button type="submit" class="submit-btn" style="background: #4F46E5;">Reset Password</button>
                </form>

                <script>
                    lucide.createIcons();

                    function togglePassword(inputId) {
                        const input = document.getElementById(inputId);
                        const icon = input.nextElementSibling.querySelector('i');
                        
                        if (input.type === 'password') {
                            input.type = 'text';
                            icon.setAttribute('data-lucide', 'eye-off');
                        } else {
                            input.type = 'password';
                            icon.setAttribute('data-lucide', 'eye');
                        }
                        lucide.createIcons();
                    }

                    const form = document.getElementById('resetForm');
                    const inputs = {
                        otp: document.getElementById('otp'),
                        password: document.getElementById('password'),
                        confirmPassword: document.getElementById('confirmPassword')
                    };

                    const errors = {
                        otp: document.getElementById('otp-error'),
                        password: document.getElementById('password-error'),
                        confirmPassword: document.getElementById('confirmPassword-error')
                    };

                    function validateField(name, value) {
                        let isValid = true;
                        let message = '';

                        switch (name) {
                            case 'otp':
                                if (!/^\d{4}$/.test(value)) {
                                    isValid = false;
                                    message = 'OTP must be 4 digits';
                                }
                                break;
                            case 'password':
                                if (value.length < 8) {
                                    isValid = false;
                                    message = 'Password must be at least 8 characters';
                                }
                                break;
                            case 'confirmPassword':
                                const password = document.getElementById('password').value;
                                if (value !== password) {
                                    isValid = false;
                                    message = 'Passwords do not match';
                                }
                                break;
                        }

                        if (!isValid) {
                            errors[name].textContent = message;
                            errors[name].style.display = 'block';
                            inputs[name].style.borderColor = '#FF0000';
                        } else {
                            errors[name].style.display = 'none';
                            inputs[name].style.borderColor = '#D1D5DB';
                        }

                        return isValid;
                    }

                    Object.keys(inputs).forEach(key => {
                        inputs[key].addEventListener('input', () => {
                            validateField(key, inputs[key].value);
                        });
                    });

                    form.addEventListener('submit', (e) => {
                        let isFormValid = true;
                        Object.keys(inputs).forEach(key => {
                            if (!validateField(key, inputs[key].value)) {
                                isFormValid = false;
                            }
                        });

                        if (!isFormValid) {
                            e.preventDefault();
                        }
                    });
                </script>
            </div>
        </main>
        <%- include('partials/alerts') %>
    </body>

</html>
