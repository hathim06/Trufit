<!DOCTYPE html>
<html lang="en">

<%- include('partials/head') %>
    <style>
        /* Cart Content */
        .cart-page {
            padding: 60px 0;
        }

        .cart-title {
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 40px;
            text-transform: uppercase;
            text-decoration: underline;
            text-underline-offset: 8px;
            text-decoration-thickness: 3px;
        }

        .cart-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 40px;
        }

        .cart-table th {
            text-align: left;
            padding: 15px 10px;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
            border-bottom: 1px solid #EEE;
            color: #6B7280;
        }

        .cart-table td {
            padding: 30px 10px;
            border-bottom: 1px solid #F3F4F6;
            vertical-align: middle;
        }

        .product-cell {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .product-img {
            width: 100px;
            height: 100px;
            background: #F8F8F8;
            border-radius: 12px;
            padding: 10px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .product-img img {
            max-height: 100%;
            object-fit: contain;
        }

        .product-name {
            font-size: 16px;
            font-weight: 600;
        }

        .size-text {
            font-size: 14px;
            color: #4B5563;
        }

        .price-text,
        .total-text {
            font-size: 14px;
            font-weight: 600;
        }

        /* Quantity Selector */
        .qty-selector {
            display: flex;
            align-items: center;
            gap: 15px;
            background: #F9FAFB;
            padding: 5px 15px;
            border-radius: 4px;
            width: fit-content;
        }

        .qty-btn {
            background: none;
            border: none;
            font-size: 18px;
            cursor: pointer;
            color: #9CA3AF;
        }

        .qty-input {
            width: 30px;
            text-align: center;
            border: none;
            background: transparent;
            font-weight: 600;
            font-size: 14px;
        }

        .btn-remove {
            background: var(--remove-red);
            color: #FFF;
            padding: 8px 18px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 600;
            border: none;
            cursor: pointer;
            transition: var(--transition);
        }

        .cart-footer {
            display: flex;
            justify-content: flex-end;
            padding-top: 20px;
        }

        .btn-checkout {
            background: var(--checkout-btn);
            color: #FFF;
            padding: 18px 45px;
            border-radius: 15px;
            font-size: 18px;
            font-weight: 700;
            text-transform: capitalize;
            border: none;
            cursor: pointer;
            transition: var(--transition);
        }

        .btn:hover {
            transform: translateY(-2px);
            opacity: 0.95;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        }

        /* Footer */
        .footer {
            padding: 80px 0 40px;
            border-top: 1px solid #EEE;
            background: #FFFFFF;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr 1fr;
            gap: 40px;
            margin-bottom: 60px;
        }

        .footer-col-logo {
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .logo-box {
            background: #11362F;
            /* Dark green as in mockup */
            width: 100px;
            height: 100px;
            border-radius: 20px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            color: #FFFFFF;
        }

        .logo-box i {
            width: 40px;
            height: 40px;
        }

        .logo-box span {
            font-size: 14px;
            font-weight: 700;
            margin-top: 5px;
        }

        .footer-col ul li {
            margin-bottom: 15px;
        }

        .footer-col ul li a {
            color: #6B7280;
            font-size: 14px;
        }

        .footer-col ul li a:hover {
            color: #000;
        }

        .social-info {
            color: #6B7280;
            font-size: 14px;
        }

        .social-info p {
            margin-bottom: 12px;
        }

        .copyright {
            padding: 30px 0;
            background: #000;
            color: #FFF;
            text-align: center;
            font-size: 14px;
        }

        /* Responsive */
        @media (max-width: 900px) {
            .cart-table thead {
                display: none;
            }

            .cart-table tr {
                display: block;
                padding: 20px 0;
                border-bottom: 1px solid #EEE;
            }

            .cart-table td {
                display: flex;
                justify-content: space-between;
                padding: 10px 0;
                border: none;
            }

            .product-cell {
                justify-content: center;
                margin-bottom: 15px;
            }

            .header-left .search-bar {
                display: none;
            }

            .footer-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
    </head>

    <body>
        <%- include('partials/header') %>

            <main class="container">
                <!-- Cart Content -->
                <section class="cart-page">
                    <h1 class="cart-title">YOUR CART</h1>

                    <table class="cart-table">
                        <thead>
                            <tr>
                                <th style="width: 40%;">Product</th>
                                <th>Size</th>
                                <th>Price</th>
                                <th>Quantity</th>
                                <th>Total</th>
                                <th>ACTION</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Item 1 -->
                            <tr>
                                <td>
                                    <div class="product-cell">
                                        <div class="product-img">
                                            <img src="../../public/apple_smart_1.png" alt="Apple smart">
                                        </div>
                                        <span class="product-name">Apple smart</span>
                                    </div>
                                </td>
                                <td><span class="size-text">MED</span></td>
                                <td><span class="price-text">₹27.140</span></td>
                                <td>
                                    <div class="qty-selector">
                                        <button class="qty-btn">-</button>
                                        <input type="text" value="2" class="qty-input">
                                        <button class="qty-btn">+</button>
                                    </div>
                                </td>
                                <td><span class="total-text">₹2.100</span></td>
                                <td><button class="btn btn-remove">Remove</button></td>
                            </tr>

                            <!-- Item 2 -->
                            <tr>
                                <td>
                                    <div class="product-cell">
                                        <div class="product-img">
                                            <img src="../../public/samsung_watch_pro.png" alt="Samsung pro">
                                        </div>
                                        <span class="product-name">Samsung pro</span>
                                    </div>
                                </td>
                                <td><span class="size-text">LG</span></td>
                                <td><span class="price-text">₹1. 100</span></td>
                                <td>
                                    <div class="qty-selector">
                                        <button class="qty-btn">-</button>
                                        <input type="text" value="1" class="qty-input">
                                        <button class="qty-btn">+</button>
                                    </div>
                                </td>
                                <td><span class="total-text">₹1.100</span></td>
                                <td><button class="btn btn-remove">Remove</button></td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="cart-footer">
                        <a href="checkout.html" class="btn btn-checkout">Proceed to checkout</a>
                    </div>
                </section>
            </main>

            <div class="copyright">
                Copyright @ 2022 | Trufit
            </div>
            </footer>

            <script>
                lucide.createIcons();
            </script>
    </body>

</html>
