<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/head') %>
        <style>
            /* Auth Specific Styles */
            .auth-container {
                flex: 1;
                display: flex;
                justify-content: center;
                align-items: center;
                padding: 80px 20px;
                background-color: #f9f9f9;
            }

            .auth-box {
                width: 100%;
                max-width: 450px;
                padding: 40px;
                background: #FFFFFF;
                box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
                border-radius: 12px;
            }

            .auth-box h1 {
                text-align: center;
                font-size: 28px;
                margin-bottom: 30px;
                font-weight: 700;
            }

            .form-group {
                display: flex;
                flex-direction: column;
                gap: 8px;
                margin-bottom: 20px;
            }

            .form-group label {
                font-size: 14px;
                font-weight: 600;
            }

            .form-group input {
                padding: 12px;
                border: 1px solid #ddd;
                border-radius: 8px;
                font-size: 14px;
                outline: none;
                transition: border-color 0.3s;
            }

            .form-group input:focus {
                border-color: #000;
            }

            .forgot-link {
                text-align: right;
                margin-bottom: 20px;
            }

            .forgot-link a {
                font-size: 12px;
                color: #666;
                font-weight: 500;
            }

            .submit-btn {
                width: 100%;
                background: #000;
                color: #FFF;
                padding: 14px;
                border: none;
                border-radius: 8px;
                font-weight: 700;
                font-size: 16px;
                cursor: pointer;
                transition: opacity 0.3s;
            }

            .submit-btn:hover {
                opacity: 0.9;
            }

            .google-btn-wrapper {
                margin-top: 20px;
            }

            .google-btn {
                width: 100%;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 10px;
                background: #FFFFFF;
                border: 1px solid #ddd;
                padding: 12px;
                border-radius: 8px;
                cursor: pointer;
                text-decoration: none;
                color: #000;
                font-weight: 600;
                font-size: 14px;
                transition: background 0.3s;
            }

            .google-btn:hover {
                background: #f5f5f5;
            }

            .google-btn img {
                width: 20px;
            }

            .auth-footer-links {
                text-align: center;
                margin-top: 25px;
                font-size: 14px;
                color: #666;
            }

            .auth-footer-links a {
                color: #3B82F6;
                font-weight: 600;
            }
        </style>
</head>

<body>

    <main class="auth-container">
        <div class="auth-box">
            <h1>Sign In</h1>



            <form method="post" action="/users/login" id="loginForm">
                <div class="form-group">
                    <label>Email Address</label>
                    <span id="email-error" class="error-message"></span>
                    <input type="email" name="email" id="email" placeholder="Enter your email" required>
                    <% if (typeof message !=='undefined' && message && (message.toLowerCase().includes("email") ||
                        message.toLowerCase().includes("not found"))) { %>
                        <small style="color:red; font-size: 11px;">
                            <%= message %>
                        </small>
                        <% } %>
                </div>
                <div class="form-group">
                    <label>Password</label>
                    <span id="password-error" class="error-message"></span>
                    <div class="password-wrapper">
                        <input type="password" name="password" id="password" placeholder="Enter your password" required>
                        <span class="toggle-password" onclick="togglePassword('password')">
                            <i data-lucide="eye"></i>
                        </span>
                    </div>
                    <% if (typeof message !== 'undefined' && message && message.toLowerCase().includes("password")) { %>
                        <small style="color:red; font-size: 11px;">
                            <%= message %>
                        </small>
                        <% } %>
                </div>
                <div class="forgot-link">
                    <a href="/users/forgot-password">Forgot password?</a>
                </div>
                <button type="submit" class="submit-btn" id="submitBtn">Continue</button>
            </form>

            <div class="google-btn-wrapper">
                <a href="/users/auth/google" class="google-btn">
                    <img src="https://www.gstatic.com/images/branding/product/1x/gsa_512dp.png" alt="Google">
                    Continue with Google
                </a>
            </div>

            <div class="auth-footer-links">
                Don't have an account? <a href="/users/signup">Sign Up</a>
            </div>
        </div>
    </main>

    <!-- Navigation protection to prevent back-button access to cached pages -->
    <%- include('partials/alerts') %>
        <script>
            lucide.createIcons();

            function togglePassword(inputId) {
                const input = document.getElementById(inputId);
                const icon = input.nextElementSibling.querySelector('i');

                if (input.type === 'password') {
                    input.type = 'text';
                    icon.setAttribute('data-lucide', 'eye-off');
                } else {
                    input.type = 'password';
                    icon.setAttribute('data-lucide', 'eye');
                }
                lucide.createIcons();
            }

            const form = document.getElementById('loginForm');
            const inputs = {
                email: document.getElementById('email'),
                password: document.getElementById('password')
            };

            const errors = {
                email: document.getElementById('email-error'),
                password: document.getElementById('password-error')
            };

            function validateField(name, value) {
                let isValid = true;
                let message = '';

                switch (name) {
                    case 'email':
                        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                        if (!emailRegex.test(value)) {
                            isValid = false;
                            message = 'Enter a valid email address';
                        }
                        break;
                    case 'password':
                        if (value.length < 8) {
                            isValid = false;
                            message = 'Password must be at least 8 characters';
                        }
                        break;
                }

                if (!isValid) {
                    if (errors[name]) {
                        errors[name].textContent = message;
                        errors[name].style.display = 'block';
                    }
                    inputs[name].style.borderColor = '#FF0000';
                } else {
                    if (errors[name]) {
                        errors[name].style.display = 'none';
                    }
                    inputs[name].style.borderColor = '#ddd';
                }

                return isValid;
            }

            Object.keys(inputs).forEach(key => {
                inputs[key].addEventListener('input', () => {
                    validateField(key, inputs[key].value);
                });
            });

            form.addEventListener('submit', (e) => {
                let isFormValid = true;
                Object.keys(inputs).forEach(key => {
                    if (!validateField(key, inputs[key].value)) {
                        isFormValid = false;
                    }
                });

                if (!isFormValid) {
                    e.preventDefault();
                }
            });

            window.addEventListener("pageshow", function (event) {
                var historyTraversal = event.persisted ||
                    (typeof window.performance != "undefined" &&
                        window.performance.navigation.type === 2);
                if (historyTraversal) {
                    window.location.reload();
                }
            });
        </script>
</body>

</html>