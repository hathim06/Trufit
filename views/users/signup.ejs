<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/head') %>
        <style>
            /* Auth Specific Styles */
            .auth-container {
                flex: 1;
                display: flex;
                justify-content: center;
                align-items: center;
                padding: 80px 20px;
                background-color: #f9f9f9;
            }

            .auth-box {
                width: 100%;
                max-width: 500px;
                padding: 40px;
                background: #FFFFFF;
                box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
                border-radius: 12px;
            }

            .auth-box h1 {
                text-align: center;
                font-size: 28px;
                margin-bottom: 30px;
                font-weight: 700;
            }

            .form-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 20px;
            }

            .form-group {
                display: flex;
                flex-direction: column;
                gap: 8px;
                margin-bottom: 20px;
            }

            .form-group.full-width {
                grid-column: span 2;
            }

            .form-group label {
                font-size: 14px;
                font-weight: 600;
            }

            .form-group input {
                padding: 12px;
                border: 1px solid #ddd;
                border-radius: 8px;
                font-size: 14px;
                outline: none;
                transition: border-color 0.3s;
            }

            .form-group input:focus {
                border-color: #000;
            }

            .submit-btn {
                width: 100%;
                background: #000;
                color: #FFF;
                padding: 14px;
                border: none;
                border-radius: 8px;
                font-weight: 700;
                font-size: 16px;
                cursor: pointer;
                transition: opacity 0.3s;
                margin-top: 10px;
            }

            .submit-btn:hover {
                opacity: 0.9;
            }

            .google-btn-wrapper {
                margin-top: 20px;
            }

            .google-btn {
                width: 100%;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 10px;
                background: #FFFFFF;
                border: 1px solid #ddd;
                padding: 12px;
                border-radius: 8px;
                cursor: pointer;
                text-decoration: none;
                color: #000;
                font-weight: 600;
                font-size: 14px;
                transition: background 0.3s;
            }

            .google-btn:hover {
                background: #f5f5f5;
            }

            .google-btn img {
                width: 20px;
            }

            .auth-footer-links {
                text-align: center;
                margin-top: 25px;
                font-size: 14px;
                color: #666;
            }

            .auth-footer-links a {
                color: #3B82F6;
                font-weight: 600;
            }

            @media (max-width: 480px) {
                .form-grid {
                    grid-template-columns: 1fr;
                }

                .form-group.full-width {
                    grid-column: span 1;
                }
            }
        </style>
</head>

<body>

    <main class="auth-container">
        <div class="auth-box">
            <h1>Sign Up</h1>
            <form method="post" action="/users/signup">
                <div class="form-grid">
                    <div class="form-group">
                        <label>First Name</label>
                        <input type="text" name="firstName" placeholder="First Name" required>
                        <% if (message && message.toLowerCase().includes('first name')) { %>
                            <small style="color:red; font-size: 11px;">
                                <%= message %>
                            </small>
                            <% } %>
                    </div>
                    <div class="form-group">
                        <label>Last Name</label>
                        <input type="text" name="lastName" placeholder="Last Name" required>
                        <% if (message && message.toLowerCase().includes('last name')) { %>
                            <small style="color:red; font-size: 11px;">
                                <%= message %>
                            </small>
                            <% } %>
                    </div>
                    <div class="form-group full-width">
                        <label>Email Address</label>
                        <input type="email" name="email" placeholder="Enter your email" required>
                        <% if (message && message.toLowerCase().includes('email')) { %>
                            <small style="color:red; font-size: 11px;">
                                <%= message %>
                            </small>
                            <% } %>
                    </div>
                    <div class="form-group full-width">
                        <label>Password</label>
                        <input type="password" name="password" placeholder="Create a password" required>
                        <% if (message && message.toLowerCase().includes('password')) { %>
                            <small style="color:red; font-size: 11px;">
                                <%= message %>
                            </small>
                            <% } %>
                    </div>
                    <div class="form-group full-width">
                        <label>Confirm Password</label>
                        <input type="password" name="confirmPassword" placeholder="Confirm password" required>
                        <% if (message && message.toLowerCase().includes('match')) { %>
                            <small style="color:red; font-size: 11px;">
                                <%= message %>
                            </small>
                            <% } %>
                    </div>
                    <div class="form-group full-width">
                        <label>Referral Code (Optional)</label>
                        <input type="text" name="referalCode" placeholder="Enter referral code">
                    </div>
                </div>
                <button type="submit" class="submit-btn">Create Account</button>
            </form>

            <div class="google-btn-wrapper">
                <a href="/users/auth/google" class="google-btn">
                    <img src="https://www.gstatic.com/images/branding/product/1x/gsa_512dp.png" alt="Google">
                    Continue with Google
                </a>
            </div>

            <div class="auth-footer-links">
                Already have an account? <a href="/users/login">Login</a>
            </div>
        </div>
    </main>

</body>

</html>