<!DOCTYPE html>
<html lang="en">

<%- include('partials/head') %>
    <style>
        /* Coupons Page Content */
        .page-title {
            margin: 40px 0;
            font-size: 24px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .coupons-table-container {
            margin-bottom: 80px;
            overflow-x: auto;
        }

        .coupons-table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
        }

        .coupons-table th {
            padding: 20px 30px;
            border-bottom: 1px solid #E5E7EB;
            font-size: 14px;
            font-weight: 700;
            color: #000;
            text-transform: uppercase;
        }

        .coupons-table td {
            padding: 40px 30px;
            border-bottom: 1px solid #E5E7EB;
            font-size: 14px;
            vertical-align: middle;
        }

        .coupon-code {
            color: var(--coupon-green);
            font-weight: 700;
            font-size: 16px;
        }

        .coupon-details {
            color: #6B7280;
        }

        .coupon-expires {
            color: #6B7280;
        }

        .copy-code {
            color: #000;
            font-weight: 700;
            text-decoration: none;
            cursor: pointer;
            text-transform: uppercase;
            border-bottom: 1px solid transparent;
            transition: var(--transition);
        }

        .copy-code:hover {
            border-bottom-color: #000;
        }

        /* Footer Styling */
        .footer {
            border-top: 1px solid #E5E7EB;
            padding: 60px 0 0;
            margin-top: 80px;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: 200px 1fr 1fr 1fr;
            gap: 40px;
            margin-bottom: 60px;
        }

        .footer-logo {
            text-align: center;
        }

        .footer-col h3 {
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 25px;
        }

        .footer-col ul {
            list-style: none;
        }

        .footer-col li {
            margin-bottom: 15px;
        }

        .footer-col a {
            color: #6B7280;
            text-decoration: none;
            font-size: 14px;
        }

        .copyright-bar {
            background: #000;
            color: #FFF;
            padding: 20px 0;
            text-align: center;
            font-size: 14px;
        }

        @media (max-width: 768px) {
            .coupons-table td, .coupons-table th {
                padding: 15px;
            }
        }
    </style>
</head>

<body>
<%- include('partials/header') %>

    <main class="container">
        <h1 class="page-title">MY COUPONS</h1>

        <div class="coupons-table-container">
            <table class="coupons-table">
                <thead>
                    <tr>
                        <th>COUPON</th>
                        <th>DETAILS</th>
                        <th>EXPIRES</th>
                        <th>-</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="coupon-code">WEL20</td>
                        <td class="coupon-details">20% Off on First order</td>
                        <td class="coupon-expires">14 FEB 2026</td>
                        <td><a href="#" class="copy-code">COPY CODE</a></td>
                    </tr>
                    <!-- Additional Row for Demo -->
                    <tr>
                        <td class="coupon-code">SMART10</td>
                        <td class="coupon-details">10% Off on Smart Watches</td>
                        <td class="coupon-expires">20 MAR 2026</td>
                        <td><a href="#" class="copy-code">COPY CODE</a></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </main>

    <%- include('partials/footer') %>

    <script>
        lucide.createIcons();
    </script>
</body>

</html>
