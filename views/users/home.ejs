<!DOCTYPE html>
<html lang="en">

<%- include('partials/head') %>
    <style>
        /* 4. Hero Section */
        .hero {
            background-color: var(--bg-dark);
            padding: 100px 0;
            color: var(--text-white);
            overflow: hidden;
        }

        .hero .container {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .hero-content {
            flex: 1;
            max-width: 550px;
        }

        .hero h1 {
            font-size: 64px;
            line-height: 1.1;
            font-weight: 700;
            margin-bottom: 24px;
        }

        .hero p {
            font-size: 18px;
            color: #9CA3AF;
            margin-bottom: 40px;
            max-width: 500px;
        }

        .hero-image {
            flex: 1;
            display: flex;
            justify-content: flex-end;
            position: relative;
        }

        .hero-image img {
            width: 500px;
            filter: drop-shadow(0 20px 50px rgba(0, 0, 0, 0.8));
            animation: floating 3s ease-in-out infinite;
        }

        @keyframes floating {
            0% {
                transform: translateY(0px);
            }

            50% {
                transform: translateY(-20px);
            }

            100% {
                transform: translateY(0px);
            }
        }

        /* 5. Categories Section */
        .category-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 30px;
        }

        .category-card {
            background: #F9FAFB;
            border-radius: 20px;
            padding: 30px;
            display: flex;
            align-items: center;
            gap: 20px;
            transition: var(--transition);
        }

        .category-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
        }

        .category-card .card-image {
            width: 100px;
            height: 100px;
            background: #FFFFFF;
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 15px;
        }

        .category-card .card-content h3 {
            font-size: 20px;
            margin-bottom: 8px;
        }

        .category-card .card-content p {
            font-size: 14px;
            color: #6B7280;
            line-height: 1.4;
        }

        /* 6. Product Grid */
        .product-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 40px;
        }

        .product-card {
            background: #FFFFFF;
            border-radius: 20px;
            overflow: hidden;
            transition: var(--transition);
            position: relative;
        }

        .product-card:hover {
            transform: translateY(-8px);
        }

        .product-image {
            background: #F9FAFB;
            padding: 40px;
            position: relative;
            display: flex;
            justify-content: center;
        }

        .product-image img {
            height: 220px;
            object-fit: contain;
        }

        .card-actions {
            position: absolute;
            top: 20px;
            right: 20px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .action-btn {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #FFFFFF;
            border: 1px solid #E5E7EB;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: var(--transition);
        }

        .heart-btn.active,
        .heart-btn:hover {
            background: #ef4444;
            color: #FFFFFF;
            border-color: #ef4444;
        }

        .cart-btn:hover {
            background: #000000;
            color: #FFFFFF;
        }

        .product-info {
            padding: 20px;
            text-align: center;
        }

        .product-info h3 {
            font-size: 20px;
            margin-bottom: 10px;
        }

        .rating {
            margin-bottom: 10px;
            display: flex;
            justify-content: center;
            gap: 2px;
        }

        .rating i {
            width: 16px;
            color: #D1D5DB;
        }

        .rating i.filled {
            color: #FBBF24;
            fill: #FBBF24;
        }

        .price {
            display: flex;
            justify-content: center;
            gap: 15px;
            align-items: center;
            font-weight: 700;
        }

        .old-price {
            text-decoration: line-through;
            color: #9CA3AF;
            font-weight: 400;
        }

        .new-price {
            color: #000000;
            font-size: 20px;
        }

        .view-more {
            text-align: center;
            margin-top: 50px;
        }

        /* 7. Testimonials */
        .testimonial-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 30px;
        }

        .testimonial-card {
            background: #F9FAFB;
            border-radius: 20px;
            padding: 30px;
            display: flex;
            gap: 25px;
        }

        .user-img {
            width: 80px;
            height: 80px;
            border-radius: 20px;
            overflow: hidden;
            flex-shrink: 0;
        }

        .user-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .testimonial-content h3 {
            font-size: 20px;
            margin-bottom: 8px;
        }

        .testimonial-content p {
            color: #6B7280;
            margin-bottom: 15px;
            font-style: italic;
        }

        .carousel-dots {
            display: flex;
            justify-content: center;
            gap: 12px;
            margin-top: 40px;
        }

        .dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: #D1D5DB;
            cursor: pointer;
        }

        .dot.active {
            background: #3B82F6;
            width: 25px;
            border-radius: 10px;
        }

        /* 8. Services */
        .services-title {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 20px;
            margin-bottom: 50px;
        }

        .services-title .line {
            height: 1px;
            background: #E5E7EB;
            flex: 1;
        }

        .services-title h2 {
            font-size: 14px;
            letter-spacing: 2px;
            color: #9CA3AF;
            white-space: nowrap;
        }

        .services-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 30px;
        }

        .service-item {
            text-align: center;
        }

        .service-icon {
            width: 70px;
            height: 70px;
            background: #F3F4F6;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
        }

        .service-icon i {
            width: 30px;
            color: #000000;
        }

        .service-item h3 {
            font-size: 16px;
            margin-bottom: 10px;
            text-transform: uppercase;
        }

        .service-item p {
            font-size: 14px;
            color: #6B7280;
        }

        /* 9. Footer */
        .footer {
            background: #FFFFFF;
            padding-top: 80px;
            border-top: 1px solid #F3F4F6;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 50px;
            margin-bottom: 60px;
        }

        .footer-col h3 {
            font-size: 18px;
            margin-bottom: 25px;
        }

        .footer-col ul {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .footer-col ul li a {
            color: #6B7280;
        }

        .footer-col ul li a:hover {
            color: #000000;
            padding-left: 5px;
        }

        .social-col ul li {
            display: flex;
            align-items: center;
            gap: 12px;
            color: #6B7280;
        }

        .social-col i {
            width: 18px;
        }

        .copyright {
            padding: 30px 0;
            background: #000000;
            color: #FFFFFF;
            text-align: center;
            font-size: 14px;
        }

        /* 10. Responsive */
        @media (max-width: 1100px) {
            .hero h1 {
                font-size: 48px;
            }

            .hero-image img {
                width: 400px;
            }
        }

        @media (max-width: 992px) {
            .header-left .search-bar {
                display: none;
            }

            .category-grid,
            .product-grid,
            .services-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .footer-grid {
                grid-template-columns: 1fr 1fr;
            }
        }

        @media (max-width: 768px) {
            .container {
                padding: 0 15px;
            }

            .hero .container {
                flex-direction: column;
                text-align: center;
            }

            .hero-content {
                max-width: 100%;
                margin-bottom: 50px;
            }

            .hero-image {
                justify-content: center;
            }

            .hero h1 {
                font-size: 36px;
            }

            .nav {
                display: none;
            }

            .testimonial-grid {
                grid-template-columns: 1fr;
            }

            .footer-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 480px) {

            .category-grid,
            .product-grid,
            .services-grid {
                grid-template-columns: 1fr;
            }

            .hero h1 {
                font-size: 32px;
            }

            .section-spacing {
                padding: 50px 0;
            }
        }
    </style>
</head>

