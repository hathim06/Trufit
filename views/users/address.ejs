<!DOCTYPE html>
<html lang="en">

<%- include('partials/head') %>
    <style>
        /* Address Page Content */
        .page-title {
            margin: 40px 0;
            font-size: 24px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .address-section {
            margin-bottom: 60px;
        }

        .add-new-btn {
            width: 100%;
            padding: 30px;
            border: 1px solid #E5E7EB;
            background: #FFFFFF;
            text-align: center;
            font-weight: 600;
            font-size: 18px;
            cursor: pointer;
            margin-bottom: 30px;
            transition: var(--transition);
        }

        .add-new-btn:hover {
            background: #F9FAFB;
            transform: translateY(-2px);
        }

        .address-card {
            border: 1px solid #E5E7EB;
            padding: 30px;
            margin-bottom: 20px;
            position: relative;
        }

        .address-type {
            font-weight: 700;
            margin-bottom: 15px;
            font-size: 18px;
        }

        .address-details {
            color: #4B5563;
            line-height: 1.8;
        }

        .delete-btn {
            position: absolute;
            bottom: 30px;
            right: 30px;
            background: #FF0000;
            color: #FFFFFF;
            padding: 12px 40px;
            border-radius: 30px;
            border: none;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
        }

        .delete-btn:hover {
            box-shadow: 0 4px 15px rgba(255, 0, 0, 0.3);
            transform: translateY(-2px);
        }

        /* Footer Styling */
        .footer {
            border-top: 1px solid #E5E7EB;
            padding: 60px 0 0;
            margin-top: 80px;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: 200px 1fr 1fr 1fr;
            gap: 40px;
            margin-bottom: 60px;
        }

        .footer-logo {
            text-align: center;
        }

        .footer-logo img {
            width: 80px;
            margin-bottom: 10px;
        }

        .footer-logo div {
            font-weight: 700;
            font-size: 18px;
        }

        .footer-col h3 {
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 25px;
        }

        .footer-col ul {
            list-style: none;
        }

        .footer-col li {
            margin-bottom: 15px;
        }

        .footer-col a {
            color: #6B7280;
            text-decoration: none;
            font-size: 14px;
        }

        .social-link {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #000;
            font-size: 14px;
            text-decoration: none;
        }

        .copyright-bar {
            background: #000000;
            color: #FFFFFF;
            padding: 20px 0;
            text-align: center;
            font-size: 14px;
        }

        @media (max-width: 768px) {

            .header-left .search-bar,
            .nav {
                display: none;
            }

            .footer-grid {
                grid-template-columns: 1fr;
                text-align: center;
            }
        }
    </style>
    </head>

    <body>
        <%- include('partials/header') %>

            <main class="container">
                <h1 class="page-title">ADDRESS</h1>


                <!-- Sample Address Card -->
                <section class="address-section">

                    <div class="add-new-btn-container" style="margin-bottom: 30px;">
                        <a href="/users/address/add" class="add-new-btn"
                            style="text-decoration: none; display: inline-block; background: #000; color: #fff; padding: 12px 25px; border-radius: 4px; font-weight: 600;">
                            ADD NEW ADDRESS
                        </a>
                    </div>

                    <% if (addresses && addresses.length> 0) { %>
                        <% addresses.forEach(address=> { %>
                            <div class="address-card"
                                style="border: 1px solid #E5E7EB; padding: 25px; margin-bottom: 20px; position: relative;">
                                <div class="address-type"
                                    style="font-weight: 700; font-size: 12px; color: #6B7280; margin-bottom: 10px;">
                                    <%= address.isDefault ? '(DEFAULT)' : '(ADDRESS)' %>
                                </div>

                                <div class="address-details"
                                    style="font-size: 14px; line-height: 1.6; color: #374151; margin-bottom: 20px;">
                                    <strong>
                                        <%= address.name %>
                                    </strong><br>
                                    <%= address.addressLine %>, <%= address.district %><br>
                                            <%= address.state %> - <%= address.pincode %><br>
                                                    <%= address.city %><br>
                                                        Mobile: <%= address.mobile %>
                                </div>

                                <div class="address-actions" style="display: flex; gap: 15px; align-items: center;">
                                    <a href="/users/address/edit/<%= address._id %>" class="edit-link"
                                        style="color: #3B82F6; text-decoration: none; font-size: 14px; font-weight: 600;">Edit</a>

                                    <form action="/users/address/delete/<%= address._id %>" method="POST"
                                        style="margin: 0;">
                                        <button type="submit" class="delete-btn"
                                            style="background: none; border: none; color: #EF4444; font-size: 14px; font-weight: 600; cursor: pointer; padding: 0;">Delete</button>
                                    </form>

                                    <% if (!address.isDefault) { %>
                                        <form action="/users/address/default/<%= address._id %>" method="POST"
                                            style="margin: 0;">
                                            <button type="submit" class="default-btn"
                                                style="background: none; border: none; color: #059669; font-size: 14px; font-weight: 600; cursor: pointer; padding: 0;">Set
                                                as Default</button>
                                        </form>
                                        <% } %>
                                </div>
                            </div>
                            <% }) %>
                                <% } else { %>
                                    <div class="no-address"
                                        style="text-align: center; padding: 40px; background: #F9FAFB; border-radius: 8px;">
                                        <p style="color: #6B7280;">No addresses found. Add a new one to get started!</p>
                                    </div>
                                    <% } %>

                </section>
            </main>

            <%- include('partials/footer') %>

                <script>
                    lucide.createIcons();
                </script>
    </body>

</html>