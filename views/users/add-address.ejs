<!DOCTYPE html>
<html lang="en">

<%- include('partials/head') %>
    <style>
        /* Form Page Content */
        .page-title {
            margin: 40px 0;
            font-size: 24px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .form-card {
            border: 1px solid #E5E7EB;
            padding: 50px;
            margin-bottom: 60px;
        }

        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 25px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .form-group.full-width {
            grid-column: span 2;
        }

        .form-group label {
            font-size: 14px;
            font-weight: 500;
            color: #4B5563;
        }

        .form-group label span {
            color: #FF0000;
        }

        .form-group input {
            padding: 12px 15px;
            border: 1px solid #D1D5DB;
            border-radius: 4px;
            font-family: inherit;
            font-size: 14px;
            outline: none;
            transition: var(--transition);
        }

        .form-group input:focus {
            border-color: #000;
            box-shadow: 0 0 0 2px rgba(0, 0, 0, 0.05);
        }

        .submit-btn-container {
            grid-column: span 2;
            text-align: center;
            margin-top: 40px;
        }

        .submit-btn {
            background: #FF8C00;
            color: #FFFFFF;
            padding: 15px 60px;
            border-radius: 4px;
            border: none;
            font-weight: 700;
            font-size: 16px;
            cursor: pointer;
            text-transform: uppercase;
            transition: var(--transition);
        }

        .submit-btn:hover {
            background: #FF7F00;
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(255, 140, 0, 0.4);
        }

        /* Footer Styling */
        .footer {
            border-top: 1px solid #E5E7EB;
            padding: 60px 0 0;
            margin-top: 80px;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: 200px 1fr 1fr 1fr;
            gap: 40px;
            margin-bottom: 60px;
        }

        .footer-logo {
            text-align: center;
        }

        .footer-logo img {
            width: 80px;
            margin-bottom: 10px;
        }

        .footer-logo div {
            font-weight: 700;
            font-size: 18px;
        }

        .footer-col h3 {
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 25px;
        }

        .footer-col ul {
            list-style: none;
        }

        .footer-col li {
            margin-bottom: 15px;
        }

        .footer-col a {
            color: #6B7280;
            text-decoration: none;
            font-size: 14px;
        }

        .social-link {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #000;
            font-size: 14px;
            text-decoration: none;
        }

        .copyright-bar {
            background: #000000;
            color: #FFFFFF;
            padding: 20px 0;
            text-align: center;
            font-size: 14px;
        }

        @media (max-width: 600px) {
            .form-grid {
                grid-template-columns: 1fr;
            }

            .form-group.full-width {
                grid-column: span 1;
            }

            .submit-btn-container {
                grid-column: span 1;
            }
        }
    </style>
    </head>

    <body>
        <%- include('partials/header') %>

            <main class="container">
                <h1 class="page-title">ADD ADDRESS</h1>

                <div class="form-card">
                    <form action="/users/address/add" method="POST" class="form-grid">
                        <div class="form-group full-width">
                            <label>Full Name <span>*</span></label>
                            <input type="text" name="name" required>
                        </div>
                        <div class="form-group">
                            <label>Mobile Number <span>*</span></label>
                            <input type="tel" name="mobile" required>
                        </div>
                        <div class="form-group">
                            <label>Pincode <span>*</span></label>
                            <input type="text" id="pincode" name="pincode" required>
                        </div>
                        <div class="form-group full-width">
                            <label>House No., Building Name <span>*</span></label>
                            <input type="text" id="addressLine" name="addressLine" required>
                        </div>
                        <div class="form-group">
                            <label>State <span>*</span></label>
                            <input type="text" id="state" name="state" required>
                        </div>
                        <div class="form-group">
                            <label>District <span>*</span></label>
                            <input type="text" id="district" name="district" required>
                        </div>
                        <div class="form-group full-width">
                            <label>City <span>*</span></label>
                            <input type="text" id="city" name="city" required>
                        </div>

                        <div class="form-group full-width" style="flex-direction: row; align-items: center; gap: 10px;">
                            <input type="checkbox" name="isDefault" value="true" id="isDefault" style="width: auto;">
                            <label for="isDefault" style="margin: 0;">Set as Default Address</label>
                        </div>

                        <div class="submit-btn-container">
                            <button type="submit" class="submit-btn">ADD ADDRESS</button>
                        </div>
                    </form>
                </div>
            </main>

            <%- include('partials/footer') %>

                <script>
                    lucide.createIcons();

                    document.getElementById("pincode").addEventListener("input", async function () {
                        const pincode = this.value;

                        if (pincode.length === 6) {
                            try {
                                const response = await fetch(`https://api.postalpincode.in/pincode/${pincode}`);
                                const data = await response.json();

                                if (data[0].Status === "Success") {
                                    const postOffice = data[0].PostOffice[0];

                                    document.getElementById("district").value = postOffice.District;
                                    document.getElementById("state").value = postOffice.State;

                                } else {
                                    alert("Invalid Pincode");
                                }
                            } catch (error) {
                                console.error("Error fetching pincode data:", error);
                            }
                        }
                    });

                </script>
    </body>

</html>