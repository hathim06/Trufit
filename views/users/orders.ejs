<!DOCTYPE html>
<html lang="en">

<%- include('partials/head') %>
    <style>
        /* Orders Page Content */
        .page-title {
            margin: 40px 0;
            font-size: 24px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .order-card {
            border: 1px solid #E5E7EB;
            margin-bottom: 30px;
            border-radius: 4px;
            overflow: hidden;
        }

        .order-header {
            background: #E5E7EB;
            padding: 15px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 14px;
            font-weight: 600;
        }

        .order-header-info {
            display: flex;
            gap: 40px;
        }

        .invoice-link {
            color: #3B82F6;
            text-decoration: underline;
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            text-transform: uppercase;
        }

        .order-body {
            padding: 30px;
            display: flex;
            gap: 40px;
            align-items: center;
        }

        .product-img {
            width: 120px;
            height: 120px;
            background: #F9FAFB;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 10px;
            border-radius: 10px;
        }

        .product-img img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
        }

        .order-details {
            flex: 1;
        }

        .product-name {
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .product-meta {
            color: #6B7280;
            font-size: 14px;
            margin-bottom: 12px;
        }

        .status {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 14px;
            margin-bottom: 20px;
        }

        .status-dot {
            width: 10px;
            height: 10px;
            background: var(--green);
            border-radius: 50%;
        }

        .rating-section {
            display: flex;
            align-items: center;
            gap: 15px;
            font-size: 14px;
            font-weight: 600;
        }

        .stars {
            display: flex;
            gap: 5px;
            color: #D1D5DB;
        }

        .stars i {
            width: 18px;
            cursor: pointer;
        }

        .stars i.active {
            color: #FBBF24;
            fill: #FBBF24;
        }

        /* Footer Styling */
        .footer {
            border-top: 1px solid #E5E7EB;
            padding: 60px 0 0;
            margin-top: 80px;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: 200px 1fr 1fr 1fr;
            gap: 40px;
            margin-bottom: 60px;
        }

        .footer-logo {
            text-align: center;
        }

        .footer-col h3 {
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 25px;
        }

        .footer-col ul {
            list-style: none;
        }

        .footer-col li {
            margin-bottom: 15px;
        }

        .footer-col a {
            color: #6B7280;
            text-decoration: none;
            font-size: 14px;
        }

        .copyright-bar {
            background: #000;
            color: #FFF;
            padding: 20px 0;
            text-align: center;
            font-size: 14px;
        }

        @media (max-width: 768px) {
            .order-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 10px;
            }
            .order-body {
                flex-direction: column;
                text-align: center;
            }
            .rating-section {
                justify-content: center;
            }
        }
    </style>
</head>

<body>
<%- include('partials/header') %>

    <main class="container">
        <h1 class="page-title">MY ORDERS</h1>

        <!-- Order 1 -->
        <div class="order-card">
            <div class="order-header">
                <div class="order-header-info">
                    <span>ORDER ID : 13143418</span>
                    <span>16 OCT, 2024</span>
                </div>
                <div class="invoice-link">
                    INVOICE <i data-lucide="download"></i>
                </div>
            </div>
            <div class="order-body">
                <div class="product-img">
                    <img src="../../public/apple_smart_1.png" alt="Apple smart">
                </div>
                <div class="order-details">
                    <div class="product-name">Apple smart</div>
                    <div class="product-meta">Size : Mnd | Qty : 1</div>
                    <div class="status">
                        <span class="status-dot"></span>
                        <span>Status : Delivered</span>
                    </div>
                    <div class="rating-section">
                        <span>RATE THIS PRODUCT</span>
                        <div class="stars">
                            <i data-lucide="star"></i>
                            <i data-lucide="star"></i>
                            <i data-lucide="star"></i>
                            <i data-lucide="star"></i>
                            <i data-lucide="star"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Order 2 -->
        <div class="order-card">
            <div class="order-header">
                <div class="order-header-info">
                    <span>ORDER ID : 13149535</span>
                    <span>10 NOV, 2024</span>
                </div>
                <div class="invoice-link">
                    INVOICE <i data-lucide="download"></i>
                </div>
            </div>
            <div class="order-body">
                <div class="product-img">
                    <img src="../../public/samsung_watch_pro.png" alt="Samsung pro">
                </div>
                <div class="order-details">
                    <div class="product-name">Samsung pro</div>
                    <div class="product-meta">Size : Lrg | Qty : 1</div>
                    <div class="status">
                        <span class="status-dot"></span>
                        <span>Status : Delivered</span>
                    </div>
                    <div class="rating-section">
                        <span>RATE THIS PRODUCT</span>
                        <div class="stars">
                            <i data-lucide="star"></i>
                            <i data-lucide="star"></i>
                            <i data-lucide="star"></i>
                            <i data-lucide="star"></i>
                            <i data-lucide="star"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>

    <script>
        lucide.createIcons();
    </script>
</body>

</html>
