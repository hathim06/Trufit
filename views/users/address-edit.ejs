<!DOCTYPE html>
<html lang="en">

<%- include('partials/head') %>
    <style>
        /* Form Page Content */
        .page-title {
            margin: 40px 0;
            font-size: 24px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .form-card {
            border: 1px solid #E5E7EB;
            padding: 50px;
            margin-bottom: 60px;
        }

        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 25px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .form-group.full-width {
            grid-column: span 2;
        }

        .form-group label {
            font-size: 14px;
            font-weight: 500;
            color: #4B5563;
        }

        .form-group label span {
            color: #FF0000;
        }

        .form-group input {
            padding: 12px 15px;
            border: 1px solid #D1D5DB;
            border-radius: 4px;
            font-family: inherit;
            font-size: 14px;
            outline: none;
            transition: var(--transition);
        }

        .form-group input:focus {
            border-color: #000;
            box-shadow: 0 0 0 2px rgba(0, 0, 0, 0.05);
        }

        .submit-btn-container {
            grid-column: span 2;
            text-align: center;
            margin-top: 40px;
        }

        .submit-btn {
            background: #FF8C00;
            color: #FFFFFF;
            padding: 15px 60px;
            border-radius: 4px;
            border: none;
            font-weight: 700;
            font-size: 16px;
            cursor: pointer;
            text-transform: uppercase;
            transition: var(--transition);
        }

        .submit-btn:hover {
            background: #FF7F00;
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(255, 140, 0, 0.4);
        }

        @media (max-width: 600px) {
            .form-grid {
                grid-template-columns: 1fr;
            }

            .form-group.full-width {
                grid-column: span 1;
            }

            .submit-btn-container {
                grid-column: span 1;
            }
        }
    </style>
    </head>

    <body>
        <%- include('partials/header') %>

            <main class="container">
                <h1 class="page-title">EDIT ADDRESS</h1>

                <div class="form-card">
                    <form action="/users/address/edit/<%= address._id %>" method="POST" class="form-grid">
                        <div class="form-group full-width">
                            <label>Full Name <span>*</span></label>
                            <span id="name-error" class="error-message"></span>
                            <input type="text" name="name" id="name" value="<%= address.name %>" required>
                        </div>
                        <div class="form-group">
                            <label>Mobile Number <span>*</span></label>
                            <span id="mobile-error" class="error-message"></span>
                            <input type="tel" name="mobile" id="mobile" value="<%= address.mobile %>" required>
                        </div>
                        <div class="form-group">
                            <label>Pincode <span>*</span></label>
                            <span id="pincode-error" class="error-message"></span>
                            <input type="text" id="pincode" name="pincode" value="<%= address.pincode %>" required>
                        </div>
                        <div class="form-group full-width">
                            <label>House No., Building Name <span>*</span></label>
                            <span id="addressLine-error" class="error-message"></span>
                            <input type="text" id="addressLine" name="addressLine" value="<%= address.addressLine %>" required>
                        </div>
                        <div class="form-group">
                            <label>State <span>*</span></label>
                            <span id="state-error" class="error-message"></span>
                            <input type="text" id="state" name="state" value="<%= address.state %>" required>
                        </div>
                        <div class="form-group">
                            <label>District <span>*</span></label>
                            <span id="district-error" class="error-message"></span>
                            <input type="text" id="district" name="district" value="<%= address.district %>" required>
                        </div>
                        <div class="form-group full-width">
                            <label>City <span>*</span></label>
                            <span id="city-error" class="error-message"></span>
                            <input type="text" id="city" name="city" value="<%= address.city %>" required>
                        </div>

                        <div class="form-group full-width" style="flex-direction: row; align-items: center; gap: 10px;">
                            <input type="checkbox" name="isDefault" value="true" id="isDefault" <%=address.isDefault ? 'checked' : '' %> style="width: auto;">
                            <label for="isDefault" style="margin: 0;">Set as Default Address</label>
                        </div>

                        <div class="submit-btn-container">
                            <button type="submit" class="submit-btn">SAVE CHANGES</button>
                            <a href="/users/address" style="margin-left: 20px; color: #6B7280; text-decoration: none; font-size: 14px;">Cancel</a>
                        </div>
                    </form>
                </div>
            </main>

            <%- include('partials/footer') %>

            <script>
                lucide.createIcons();

                const form = document.querySelector('form');
                const inputs = {
                    name: document.getElementById('name'),
                    mobile: document.getElementById('mobile'),
                    pincode: document.getElementById('pincode'),
                    addressLine: document.getElementById('addressLine'),
                    state: document.getElementById('state'),
                    district: document.getElementById('district'),
                    city: document.getElementById('city')
                };

                const errors = {
                    name: document.getElementById('name-error'),
                    mobile: document.getElementById('mobile-error'),
                    pincode: document.getElementById('pincode-error'),
                    addressLine: document.getElementById('addressLine-error'),
                    state: document.getElementById('state-error'),
                    district: document.getElementById('district-error'),
                    city: document.getElementById('city-error')
                };

                function validateField(name, value) {
                    let isValid = true;
                    let message = '';

                    switch (name) {
                        case 'name':
                            if (value.trim().length < 3) {
                                isValid = false;
                                message = 'Name must be at least 3 characters long';
                            }
                            break;
                        case 'mobile':
                            if (!/^[6-9]\d{9}$/.test(value)) {
                                isValid = false;
                                message = 'Please enter a valid 10-digit mobile number';
                            }
                            break;
                        case 'pincode':
                            if (!/^\d{6}$/.test(value)) {
                                isValid = false;
                                message = 'Pincode must be exactly 6 digits';
                            }
                            break;
                        default:
                            if (value.trim() === '') {
                                isValid = false;
                                message = 'This field is required';
                            }
                    }

                    if (!isValid) {
                        errors[name].textContent = message;
                        errors[name].style.display = 'block';
                        inputs[name].style.borderColor = '#FF0000';
                    } else {
                        errors[name].style.display = 'none';
                        inputs[name].style.borderColor = '#D1D5DB';
                    }

                    return isValid;
                }

                // Add real-time validation
                Object.keys(inputs).forEach(key => {
                    inputs[key].addEventListener('input', () => {
                        validateField(key, inputs[key].value);
                    });
                });

                form.addEventListener('submit', function (e) {
                    let isFormValid = true;
                    Object.keys(inputs).forEach(key => {
                        if (!validateField(key, inputs[key].value)) {
                            isFormValid = false;
                        }
                    });

                    if (!isFormValid) {
                        e.preventDefault();
                    }
                });

                document.getElementById("pincode").addEventListener("input", async function () {
                    const pincode = this.value;

                    if (pincode.length === 6) {
                        try {
                            const response = await fetch(`https://api.postalpincode.in/pincode/${pincode}`);
                            const data = await response.json();

                            if (data[0].Status === "Success") {
                                const postOffice = data[0].PostOffice[0];

                                document.getElementById("district").value = postOffice.District;
                                document.getElementById("state").value = postOffice.State;
                                
                                // Trigger validation for auto-filled fields
                                validateField('district', postOffice.District);
                                validateField('state', postOffice.State);

                            } else {
                                errors.pincode.textContent = 'Invalid Pincode';
                                errors.pincode.style.display = 'block';
                            }
                        } catch (error) {
                            console.error("Error fetching pincode data:", error);
                        }
                    }
                });
            </script>

    </body>

</html>
