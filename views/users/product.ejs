<!DOCTYPE html>
<html lang="en">

<%- include('partials/head') %>
    <style>
        /* Main Product Section */
        .product-section {
            padding: 60px 0;
            display: grid;
            grid-template-columns: 1.2fr 1fr;
            gap: 100px;
            align-items: start;
        }

        .product-gallery {
            display: flex;
            flex-direction: column;
            gap: 40px;
        }

        .main-image {
            background: #F8F8F8;
            border-radius: 20px;
            padding: 60px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .main-image img {
            max-height: 480px;
            object-fit: contain;
        }

        .product-info h1 {
            font-size: 36px;
            font-weight: 700;
            margin-bottom: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .wishlist-heart {
            color: #DDD;
            cursor: pointer;
        }

        .price-row {
            display: flex;
            align-items: baseline;
            gap: 15px;
            margin-bottom: 20px;
        }

        .current-price {
            font-size: 28px;
            font-weight: 700;
        }

        .old-price {
            text-decoration: line-through;
            color: #9CA3AF;
            font-size: 18px;
        }

        .discount {
            color: var(--price-red);
            font-size: 16px;
            font-weight: 600;
        }

        .stock-status {
            color: #10B981;
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 30px;
        }

        .option-group {
            margin-bottom: 30px;
        }

        .option-label {
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .size-grid {
            display: flex;
            gap: 10px;
        }

        .size-item {
            border: 1px solid #E5E7EB;
            padding: 8px 15px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 14px;
            transition: var(--transition);
            display: inline-block;
        }

        .size-item:hover,
        .size-item.active {
            border-color: #000;
            background-color: #000;
            color: #FFF;
        }

        .color-item:hover,
        .color-item.active {
            border-color: #000;
            transform: scale(1.1);
        }

        .color-item {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            border: 1px solid #E5E7EB;
            cursor: pointer;
            transition: var(--transition);
        }

        .thumbnail-list {
            display: flex;
            gap: 10px;
            margin-top: 20px;
        }

        .thumb-item {
            width: 80px;
            height: 80px;
            border: 2px solid #F3F4F6;
            border-radius: 8px;
            cursor: pointer;
            overflow: hidden;
            transition: var(--transition);
        }

        .thumb-item:hover, .thumb-item.active {
            border-color: #000;
        }

        .thumb-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .color-grid {
            display: flex;
            gap: 15px;
        }

        .color-item {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            cursor: pointer;
            border: 2px solid transparent;
            transition: var(--transition);
        }

        .color-item:hover,
        .color-item.active {
            border-color: #000;
            transform: scale(1.1);
        }

        .quantity-row {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-bottom: 40px;
        }

        .quantity-selector {
            display: flex;
            align-items: center;
            border: 1px solid #E5E7EB;
            border-radius: 4px;
            overflow: hidden;
        }

        .qty-btn {
            background: #F9FAFB;
            border: none;
            padding: 10px 15px;
            cursor: pointer;
            font-size: 18px;
        }

        .qty-input {
            width: 50px;
            text-align: center;
            border: none;
            outline: none;
            font-weight: 600;
        }

        .action-btns {
            display: flex;
            gap: 20px;
        }

        .btn {
            flex: 1;
            padding: 18px;
            border-radius: 50px;
            font-weight: 700;
            text-transform: uppercase;
            border: none;
            cursor: pointer;
            transition: var(--transition);
        }

        .btn-buy {
            background: #000000;
            color: #FFF;
        }

        .btn-cart {
            background: #E5E7EB;
            color: #000;
        }

        .btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
        }

        /* Information Section */
        .info-section {
            padding: 80px 0;
            border-top: 1px solid #F3F4F6;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 80px;
        }

        .info-left h2,
        .info-right h2 {
            font-size: 16px;
            font-weight: 700;
            text-transform: uppercase;
            margin-bottom: 30px;
            letter-spacing: 1px;
        }

        .feature-thumbnails {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
        }

        .thumbnail-card {
            background: #F9FAFB;
            padding: 20px;
            border-radius: 12px;
            text-align: center;
        }

        .thumbnail-card img {
            width: 100px;
            margin: 0 auto 10px;
        }

        .thumbnail-card p {
            font-size: 12px;
            font-weight: 600;
            color: #6B7280;
        }

        .description-text p {
            color: #6B7280;
            line-height: 1.8;
            margin-bottom: 20px;
        }

        /* Reviews Section */
        .reviews-section {
            padding: 80px 0;
            background: #FAFAFA;
        }

        .section-header {
            text-align: center;
            margin-bottom: 50px;
        }

        .section-header h2 {
            font-size: 32px;
            font-weight: 700;
        }

        .reviews-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 30px;
        }

        .review-card {
            background: #FFF;
            padding: 40px;
            border-radius: 20px;
            display: flex;
            gap: 25px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
        }

        .reviewer-img {
            width: 80px;
            height: 80px;
            border-radius: 15px;
            overflow: hidden;
            flex-shrink: 0;
        }

        .reviewer-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .review-content h3 {
            font-size: 20px;
            margin-bottom: 10px;
        }

        .review-content p {
            color: #6B7280;
            font-style: italic;
            margin-bottom: 15px;
            font-size: 14px;
        }

        .stars {
            display: flex;
            gap: 2px;
            color: #FBBF24;
        }

        /* Related Products */
        .related-section {
            padding: 80px 0;
        }

        .product-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 30px;
        }

        .related-card {
            background: #F9FAFB;
            border-radius: 12px;
            overflow: hidden;
            text-align: center;
            padding: 30px;
            position: relative;
        }

        .related-card img {
            height: 200px;
            margin: 0 auto 20px;
            object-fit: contain;
        }

        .related-card h3 {
            font-size: 18px;
            margin-bottom: 10px;
        }

        .related-price {
            font-weight: 700;
            display: flex;
            justify-content: center;
            gap: 10px;
        }

        .related-old-price {
            text-decoration: line-through;
            color: #9CA3AF;
            font-weight: 400;
        }

        .card-icons {
            position: absolute;
            top: 20px;
            right: 20px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .icon-circ {
            width: 35px;
            height: 35px;
            background: #FFF;
            border-radius: 50%;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: var(--transition);
        }

        .heart-icon {
            color: #ef4444;
        }

        .cart-icon-black {
            position: absolute;
            bottom: 20px;
            right: 20px;
            background: #000;
            color: #FFF;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }

        /* Footer */
        .footer {
            padding: 80px 0 40px;
            border-top: 1px solid #EEE;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: 0.5fr 1fr 1fr 1fr;
            gap: 40px;
            margin-bottom: 60px;
        }

        .footer-logo {
            font-size: 24px;
            font-weight: 700;
        }

        .footer-col h4 {
            font-size: 14px;
            margin-bottom: 20px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #9CA3AF;
        }

        .footer-col ul li {
            margin-bottom: 12px;
        }

        .footer-col ul li a {
            color: #6B7280;
            font-size: 14px;
        }

        .footer-col ul li a:hover {
            color: #000;
        }

        .copyright {
            padding: 30px 0;
            background: #000;
            color: #FFF;
            text-align: center;
            font-size: 14px;
        }

        /* Responsive */
        @media (max-width: 992px) {

            .product-section,
            .info-section,
            .reviews-grid,
            .product-grid {
                grid-template-columns: 1fr;
            }

            .header .search-bar {
                width: 250px;
            }
        }
    </style>
    </head>

    <body>
        <%- include('partials/header') %>

            <main class="container">
                <!-- Main Product Section -->
                <div id="variantData" data-variants='<%- JSON.stringify(variants) %>'></div>
                <section class="product-section">
                    <div class="product-gallery">
                        <div class="main-image">
                            <% if (product.image && product.image.length > 0) { %>
                                <img src="<%= product.image[0] %>" alt="<%= product.name %>" id="mainProductImage">
                            <% } else { %>
                                <img src="../../public/placeholder.png" alt="No Image" id="mainProductImage">
                            <% } %>
                        </div>
                        <div class="thumbnail-list">
                            <% if (product.image && product.image.length > 0) { %>
                                <% product.image.slice(0, 3).forEach((img, index) => { %>
                                    <div class="thumb-item <%= index === 0 ? 'active' : '' %>" onclick="updateMainImage('<%= img %>', this)">
                                        <img src="<%= img %>" alt="Thumbnail <%= index + 1 %>">
                                    </div>
                                <% }) %>
                            <% } %>
                        </div>
                    </div>

                    <div class="product-info">
                        <h1>
                            <%= product.name %> <i data-lucide="heart" class="wishlist-heart"></i>
                        </h1>
                        <div class="price-row">
                            <% if (product.offerPrice && product.offerPrice < product.price) { %>
                                <span class="current-price">₹<%= product.offerPrice %></span>
                                <span class="old-price">₹<%= product.price %></span>
                                <span class="discount">
                                    <%= Math.round((1 - product.offerPrice/product.price) * 100) %>% off
                                </span>
                                <% } else { %>
                                    <span class="current-price">₹<%= product.price %></span>
                                    <% } %>
                        </div>
                        <p class="stock-status">
                            <%= product.quantity> 0 ? 'In Stock' : 'Out of Stock' %>
                        </p>

                        <% if (variants && variants.length > 0) { %>
                            <div class="option-group">
                                <p class="option-label">Size</p>
                                <div class="size-grid">
                                    <% [...new Set(variants.map(v => v.size))].forEach(size => { %>
                                        <div class="size-item" onclick="selectVariantBySize('<%= size %>', this)">
                                            <%= size %>
                                        </div>
                                    <% }) %>
                                </div>
                            </div>
                        <% } else if (product.size && Array.isArray(product.size)) { %>
                            <div class="option-group">
                                <p class="option-label">Size</p>
                                <div class="size-grid">
                                    <% product.size.forEach(size => { %>
                                        <div class="size-item" onclick="selectManualAttribute('size', '<%= size %>', this)">
                                            <%= size %>
                                        </div>
                                    <% }) %>
                                </div>
                            </div>
                        <% } %>

                        <% if (variants && variants.length > 0) { %>
                            <div class="option-group">
                                <p class="option-label">Colors</p>
                                <div class="color-grid">
                                    <% variants.forEach(variant => { %>
                                        <div class="color-item" 
                                             data-color="<%- variant.color %>"
                                             onclick="switchVariant('<%= JSON.stringify(variant) %>', this)"
                                             title="<%= variant.color %>">
                                        </div>
                                    <% }) %>
                                </div>
                            </div>
                        <% } else if (product.color && Array.isArray(product.color)) { %>
                            <div class="option-group">
                                <p class="option-label">Colors</p>
                                <div class="color-grid">
                                    <% product.color.forEach(color => { %>
                                        <div class="color-item" 
                                             data-color="<%- color %>" 
                                             onclick="selectManualAttribute('color', '<%= color %>', this)"
                                             title="<%= color %>"></div>
                                    <% }) %>
                                </div>
                            </div>
                        <% } %>

                        <input type="hidden" id="selectedSize" name="selectedSize">
                        <input type="hidden" id="selectedColor" name="selectedColor">

                                        <div class="quantity-row">
                                            <div class="quantity-selector">
                                                <button class="qty-btn" onclick="decrementQty()">-</button>
                                                <input type="text" value="1" id="productQty" class="qty-input"
                                                    data-stock="<%= product.quantity %>" readonly>
                                                <button class="qty-btn" onclick="incrementQty()">+</button>
                                            </div>
                                            <span style="font-size: 14px; color: #6B7280;">Only <%= product.quantity %>
                                                    items left!</span>
                                        </div>

                                        <div class="action-btns">
                                            <button class="btn btn-buy btn-primary">Buy Now</button>
                                            <button class="btn btn-cart btn-secondary">Add to Cart</button>
                                        </div>
                    </div>
                </section>

                <!-- Information Section -->
                <section class="info-section">
                    <div class="info-left">
                        <h2>Information</h2>
                        <div class="feature-thumbnails">
                            <% if (product.image && product.image.length> 1) { %>
                                <% for(let i=1; i < product.image.length; i++) { %>
                                    <div class="thumbnail-card">
                                        <img src="<%= product.image[i] %>" alt="Detail <%= i %>">
                                    </div>
                                    <% } %>
                                        <% } else { %>
                                            <p style="color: #6B7280; font-size: 14px;">No additional detail images
                                                available.</p>
                                            <% } %>
                        </div>
                    </div>

                    <div class="info-right">
                        <h2>Description</h2>
                        <div class="description-text">
                            <p>
                                <%= product.description %>
                            </p>
                        </div>
                    </div>
                </section>

                <!-- Reviews Section -->
                <section class="reviews-section">
                    <div class="section-header">
                        <h2>Reviews</h2>
                    </div>
                    <div class="reviews-grid">
                        <!-- Review 1 -->
                        <div class="review-card">
                            <div class="reviewer-img">
                                <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=200&h=200&fit=crop"
                                    alt="Hamza Faizi">
                            </div>
                            <div class="review-content">
                                <h3>Hamza Faizi</h3>
                                <p>Don’t waste time, just order! This is the best website to purchase smart watches.</p>
                                <div class="stars">
                                    <i data-lucide="star" style="fill: #FBBF24;"></i>
                                    <i data-lucide="star" style="fill: #FBBF24;"></i>
                                    <i data-lucide="star" style="fill: #FBBF24;"></i>
                                    <i data-lucide="star" style="fill: #FBBF24;"></i>
                                    <i data-lucide="star" style="fill: #FBBF24;"></i>
                                </div>
                            </div>
                        </div>
                        <!-- Review 2 -->
                        <div class="review-card">
                            <div class="reviewer-img">
                                <img src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=200&h=200&fit=crop"
                                    alt="Hamza Faizi">
                            </div>
                            <div class="review-content">
                                <h3>Hamza Faizi</h3>
                                <p>Don’t waste time, just order! This is the best website to purchase smart watches.</p>
                                <div class="stars">
                                    <i data-lucide="star" style="fill: #FBBF24;"></i>
                                    <i data-lucide="star" style="fill: #FBBF24;"></i>
                                    <i data-lucide="star" style="fill: #FBBF24;"></i>
                                    <i data-lucide="star" style="fill: #FBBF24;"></i>
                                    <i data-lucide="star" style="fill: #FBBF24;"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Related Products Section -->
                <section class="related-section">
                    <div class="section-header" style="margin-bottom: 40px;">
                        <h2>Related products</h2>
                    </div>
                    <div class="product-grid">
                        <!-- Related 1 -->
                        <div class="related-card">
                            <div class="card-icons">
                                <div class="icon-circ"><i data-lucide="heart" class="heart-icon"></i></div>
                            </div>
                            <img src="../../public/apple_smart_1.png" alt="Apple smart I">
                            <h3>Apple smart I</h3>
                            <div class="related-price">
                                <span class="related-old-price">$300.00</span>
                                <span>$255.00</span>
                            </div>
                            <div class="cart-icon-black"><i data-lucide="shopping-cart"></i></div>
                        </div>
                        <!-- Related 2 -->
                        <div class="related-card">
                            <div class="card-icons">
                                <div class="icon-circ"><i data-lucide="heart" class="heart-icon"></i></div>
                            </div>
                            <img src="../../public/apple_smart_2.png" alt="Apple smart II">
                            <h3>Apple smart II</h3>
                            <div class="related-price">
                                <span class="related-old-price">$300.00</span>
                                <span>$255.00</span>
                            </div>
                            <div class="cart-icon-black"><i data-lucide="shopping-cart"></i></div>
                        </div>
                        <!-- Related 3 -->
                        <div class="related-card">
                            <div class="card-icons">
                                <div class="icon-circ"><i data-lucide="heart" class="heart-icon"></i></div>
                            </div>
                            <img src="../../public/apple_smart_3.png" alt="Apple smart III">
                            <h3>Apple smart III</h3>
                            <div class="related-price">
                                <span class="related-old-price">$300.00</span>
                                <span>$255.00</span>
                            </div>
                            <div class="cart-icon-black"><i data-lucide="shopping-cart"></i></div>
                        </div>
                    </div>
                </section>
            </main>

            <footer>
                <div class="copyright">
                    Copyright @ 2022 | Trufit
                </div>
            </footer>

            <script>
                // Apply colors from data attributes on load
                document.querySelectorAll('.color-item').forEach(item => {
                    if (item.dataset.color) {
                        item.style.backgroundColor = item.dataset.color;
                    }
                });

                lucide.createIcons();

                function updateMainImage(src, element) {
                    document.getElementById('mainProductImage').src = src;
                    document.querySelectorAll('.thumb-item').forEach(item => item.classList.remove('active'));
                    element.classList.add('active');
                }

                function switchVariant(variantStr, element) {
                    const variant = JSON.parse(variantStr);
                    
                    // Update Image
                    if (variant.image && variant.image.length > 0) {
                        document.getElementById('mainProductImage').src = variant.image[0];
                        
                        // Update thumbnails for the new variant
                        const thumbList = document.querySelector('.thumbnail-list');
                        thumbList.innerHTML = '';
                        variant.image.slice(0, 3).forEach((img, index) => {
                            const thumb = document.createElement('div');
                            thumb.className = `thumb-item ${index === 0 ? 'active' : ''}`;
                            thumb.onclick = () => updateMainImage(img, thumb);
                            thumb.innerHTML = `<img src="${img}" alt="Thumbnail ${index + 1}">`;
                            thumbList.appendChild(thumb);
                        });
                    }

                    // Update Stock
                    const stockStatus = document.querySelector('.stock-status');
                    const qtyLabel = document.querySelector('.quantity-row span');
                    const qtyInput = document.getElementById('productQty');
                    
                    stockStatus.innerText = variant.quantity > 0 ? 'In Stock' : 'Out of Stock';
                    qtyLabel.innerText = `Only ${variant.quantity} items left!`;
                    qtyInput.dataset.stock = variant.quantity;
                    qtyInput.value = 1;

                    // Highlight active color
                    document.querySelectorAll('.color-item').forEach(item => item.classList.remove('active'));
                    element.classList.add('active');

                    // Also highlight the corresponding size if it matches
                    document.querySelectorAll('.size-item').forEach(item => {
                        if (item.innerText.trim() === variant.size) {
                            item.classList.add('active');
                        } else {
                            item.classList.remove('active');
                        }
                    });
                }

                function selectVariantBySize(size, element) {
                    // Find the first variant with this size
                    const variantsData = document.getElementById('variantData').dataset.variants;
                    const variants = JSON.parse(variantsData);
                    const match = variants.find(v => v.size === size);
                    if (match) {
                        switchVariant(JSON.stringify(match), document.querySelector(`.color-item[title="${match.color}"]`) || element);
                    }
                }

                function decrementQty() {
                    const qtyInput = document.getElementById('productQty');
                    let currentQty = parseInt(qtyInput.value);
                    if (currentQty > 1) {
                        qtyInput.value = currentQty - 1;
                    }
                }

                function incrementQty() {
                    const qtyInput = document.getElementById('productQty');
                    const stockLimit = parseInt(qtyInput.dataset.stock);
                    let currentQty = parseInt(qtyInput.value);
                    if (currentQty < stockLimit) {
                        qtyInput.value = currentQty + 1;
                    } else {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Stock Limit Reached',
                            text: `Only ${stockLimit} items available in stock.`
                        });
                    }
                }

                function selectManualAttribute(type, value, element) {
                    if (type === 'size') {
                        document.getElementById('selectedSize').value = value;
                        document.querySelectorAll('.size-item').forEach(item => item.classList.remove('active'));
                        element.classList.add('active');
                    } else if (type === 'color') {
                        document.getElementById('selectedColor').value = value;
                        document.querySelectorAll('.color-item').forEach(item => item.classList.remove('active'));
                        element.classList.add('active');
                    }
                }
            </script>
    </body>

</html>