<!DOCTYPE html>
<html lang="en">

<%- include('partials/head') %>
    <style>
        /* Main Product Section */
        .product-section {
            padding: 60px 0;
            display: grid;
            grid-template-columns: 1.2fr 1fr;
            gap: 100px;
            align-items: start;
        }

        .product-gallery {
            display: flex;
            flex-direction: column;
            gap: 40px;
        }

        .main-image {
            background: #F8F8F8;
            border-radius: 20px;
            padding: 60px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .main-image img {
            max-height: 480px;
            object-fit: contain;
        }

        .product-info h1 {
            font-size: 36px;
            font-weight: 700;
            margin-bottom: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .wishlist-heart {
            color: #DDD;
            cursor: pointer;
        }

        .price-row {
            display: flex;
            align-items: baseline;
            gap: 15px;
            margin-bottom: 20px;
        }

        .current-price {
            font-size: 28px;
            font-weight: 700;
        }

        .old-price {
            text-decoration: line-through;
            color: #9CA3AF;
            font-size: 18px;
        }

        .discount {
            color: var(--price-red);
            font-size: 16px;
            font-weight: 600;
        }

        .stock-status {
            color: #10B981;
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 30px;
        }

        .option-group {
            margin-bottom: 30px;
        }

        .option-label {
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .size-grid {
            display: flex;
            gap: 10px;
        }

        .size-item {
            border: 1px solid #E5E7EB;
            padding: 8px 15px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 14px;
            transition: var(--transition);
        }

        .size-item:hover, .size-item.active {
            border-color: #000;
            background: #F3F4F6;
        }

        .color-grid {
            display: flex;
            gap: 15px;
        }

        .color-item {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            cursor: pointer;
            border: 2px solid transparent;
            transition: var(--transition);
        }

        .color-item:hover, .color-item.active {
            border-color: #000;
            transform: scale(1.1);
        }

        .quantity-row {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-bottom: 40px;
        }

        .quantity-selector {
            display: flex;
            align-items: center;
            border: 1px solid #E5E7EB;
            border-radius: 4px;
            overflow: hidden;
        }

        .qty-btn {
            background: #F9FAFB;
            border: none;
            padding: 10px 15px;
            cursor: pointer;
            font-size: 18px;
        }

        .qty-input {
            width: 50px;
            text-align: center;
            border: none;
            outline: none;
            font-weight: 600;
        }

        .action-btns {
            display: flex;
            gap: 20px;
        }

        .btn {
            flex: 1;
            padding: 18px;
            border-radius: 50px;
            font-weight: 700;
            text-transform: uppercase;
            border: none;
            cursor: pointer;
            transition: var(--transition);
        }

        .btn-buy {
            background: var(--buy-now);
            color: #FFF;
        }

        .btn-cart {
            background: var(--add-to-cart);
            color: #000;
        }

        .btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
        }

        /* Information Section */
        .info-section {
            padding: 80px 0;
            border-top: 1px solid #F3F4F6;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 80px;
        }

        .info-left h2, .info-right h2 {
            font-size: 16px;
            font-weight: 700;
            text-transform: uppercase;
            margin-bottom: 30px;
            letter-spacing: 1px;
        }

        .feature-thumbnails {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
        }

        .thumbnail-card {
            background: #F9FAFB;
            padding: 20px;
            border-radius: 12px;
            text-align: center;
        }

        .thumbnail-card img {
            width: 100px;
            margin: 0 auto 10px;
        }

        .thumbnail-card p {
            font-size: 12px;
            font-weight: 600;
            color: #6B7280;
        }

        .description-text p {
            color: #6B7280;
            line-height: 1.8;
            margin-bottom: 20px;
        }

        /* Reviews Section */
        .reviews-section {
            padding: 80px 0;
            background: #FAFAFA;
        }

        .section-header {
            text-align: center;
            margin-bottom: 50px;
        }

        .section-header h2 {
            font-size: 32px;
            font-weight: 700;
        }

        .reviews-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 30px;
        }

        .review-card {
            background: #FFF;
            padding: 40px;
            border-radius: 20px;
            display: flex;
            gap: 25px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
        }

        .reviewer-img {
            width: 80px;
            height: 80px;
            border-radius: 15px;
            overflow: hidden;
            flex-shrink: 0;
        }

        .reviewer-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .review-content h3 {
            font-size: 20px;
            margin-bottom: 10px;
        }

        .review-content p {
            color: #6B7280;
            font-style: italic;
            margin-bottom: 15px;
            font-size: 14px;
        }

        .stars {
            display: flex;
            gap: 2px;
            color: #FBBF24;
        }

        /* Related Products */
        .related-section {
            padding: 80px 0;
        }

        .product-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 30px;
        }

        .related-card {
            background: #F9FAFB;
            border-radius: 12px;
            overflow: hidden;
            text-align: center;
            padding: 30px;
            position: relative;
        }

        .related-card img {
            height: 200px;
            margin: 0 auto 20px;
            object-fit: contain;
        }

        .related-card h3 {
            font-size: 18px;
            margin-bottom: 10px;
        }

        .related-price {
            font-weight: 700;
            display: flex;
            justify-content: center;
            gap: 10px;
        }

        .related-old-price {
            text-decoration: line-through;
            color: #9CA3AF;
            font-weight: 400;
        }

        .card-icons {
            position: absolute;
            top: 20px;
            right: 20px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .icon-circ {
            width: 35px;
            height: 35px;
            background: #FFF;
            border-radius: 50%;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: var(--transition);
        }

        .heart-icon {
            color: #ef4444;
        }

        .cart-icon-black {
            position: absolute;
            bottom: 20px;
            right: 20px;
            background: #000;
            color: #FFF;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }

        /* Footer */
        .footer {
            padding: 80px 0 40px;
            border-top: 1px solid #EEE;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: 0.5fr 1fr 1fr 1fr;
            gap: 40px;
            margin-bottom: 60px;
        }

        .footer-logo {
            font-size: 24px;
            font-weight: 700;
        }

        .footer-col h4 {
            font-size: 14px;
            margin-bottom: 20px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #9CA3AF;
        }

        .footer-col ul li {
            margin-bottom: 12px;
        }

        .footer-col ul li a {
            color: #6B7280;
            font-size: 14px;
        }

        .footer-col ul li a:hover {
            color: #000;
        }

        .copyright {
            padding: 30px 0;
            background: #000;
            color: #FFF;
            text-align: center;
            font-size: 14px;
        }

        /* Responsive */
        @media (max-width: 992px) {
            .product-section, .info-section, .reviews-grid, .product-grid {
                grid-template-columns: 1fr;
            }
            .header .search-bar {
                width: 250px;
            }
        }
    </style>
</head>

