<%- include('partials/head') %>
<body>
    <%- include('partials/sidebar', { activePage: 'add-banner' }) %>

    <main class="main-content">
        <header class="page-header">
            <h1 class="page-title">BANNER MANAGEMENT</h1>
        </header>

        <div class="table-container">
            <form action="/admin/add-banner" method="POST" enctype="multipart/form-data">
                <div class="form-group">
                    <label>Banner Image</label>
                    <div class="upload-box">
                        <i data-lucide="image-plus"></i>
                        <p>Click to upload image</p>
                    </div>
                </div>

                <div class="form-group">
                    <label>Add Title</label>
                    <input type="text" name="title" placeholder="Enter banner title">
                </div>

                <div class="form-group">
                    <label>Add Subtitle</label>
                    <input type="text" name="subtitle" placeholder="Enter banner subtitle">
                </div>

                <div style="display: flex; justify-content: flex-end; margin-top: 40px;">
                    <button type="submit" class="btn btn-primary">ADD BANNER</button>
                </div>
            </form>
        </div>
    </main>

    <script>
        lucide.createIcons();
    </script>
</body>
</html>
