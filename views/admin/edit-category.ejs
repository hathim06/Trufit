<%- include('partials/head') %>
<body>
    <%- include('partials/sidebar', { activePage: 'categories' }) %>

    <main class="main-content">
        <!-- Mock internal header from screenshot -->
        <div style="background: #FFF; padding: 20px; border-radius: 12px; margin-bottom: 30px; display: flex; justify-content: center; align-items: center; flex-direction: column; position: relative; border: 1px solid var(--border);">
            <div style="display: flex; align-items: center; gap: 10px;">
                <i data-lucide="watch" style="width: 24px;"></i>
                <div style="font-weight: 700;">Mohid</div>
            </div>
            <div style="font-size: 12px; letter-spacing: 2px;">SMART WATCH</div>
            <i data-lucide="log-out" style="position: absolute; right: 20px; top: 20px; width: 18px; color: #666; cursor: pointer;"></i>
        </div>

        <div style="text-align: center; margin-bottom: 40px;">
            <h1 class="page-title">EDIT CATEGORY</h1>
        </div>

        <div class="table-container" style="max-width: 600px; margin: 0 auto; padding: 40px;">
            <form action="/admin/edit-category" method="POST">
                <div class="form-group">
                    <label>Category Name</label>
                    <input type="text" name="categoryName" value="Sneakers">
                </div>

                <div class="form-group">
                    <label>Offer (optional)</label>
                    <input type="text" name="offer" value="10%" placeholder="Enter category offer">
                </div>

                <div style="margin-top: 40px;">
                    <button type="submit" class="btn btn-primary" style="width: 200px;">UPDATE CATEGORY</button>
                </div>
            </form>
        </div>
    </main>

    <script>
        lucide.createIcons();
    </script>
</body>
</html>
