<%- include('partials/head') %>
<body>
    <%- include('partials/sidebar', { activePage: 'coupons' }) %>

    <main class="main-content">
        <header class="page-header">
            <h1 class="page-title">COUPON MANAGEMENT</h1>
            <button class="btn btn-primary" onclick="location.href='/admin/add-coupon'">ADD COUPON</button>
        </header>

        <div class="filter-bar">
            <input type="text" class="search-input" placeholder="Search Coupons...">
        </div>

        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>COUPON NAME</th>
                        <th>OFFER UPTO</th>
                        <th>STARTING DATE</th>
                        <th>EXPIRY DATE</th>
                        <th>ACTION</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>1</td>
                        <td>New Year Offer</td>
                        <td>Off Upto 20%</td>
                        <td>03/12/2020</td>
                        <td>30/12/2021</td>
                        <td>
                            <div class="action-btns">
                                <button class="action-btn"><i data-lucide="edit-3"></i></button>
                                <button class="action-btn"><i data-lucide="trash-2"></i></button>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td>2</td>
                        <td>Christmas Offer</td>
                        <td>Off Upto 30%</td>
                        <td>03/12/2021</td>
                        <td>31/12/2021</td>
                        <td>
                            <div class="action-btns">
                                <button class="action-btn"><i data-lucide="edit-3"></i></button>
                                <button class="action-btn"><i data-lucide="trash-2"></i></button>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td>3</td>
                        <td>Eid Sale Offer</td>
                        <td>Off Upto 50%</td>
                        <td>03/12/2025</td>
                        <td>31/12/2025</td>
                        <td>
                            <div class="action-btns">
                                <button class="action-btn"><i data-lucide="edit-3"></i></button>
                                <button class="action-btn"><i data-lucide="trash-2"></i></button>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td>4</td>
                        <td>Summer Offer</td>
                        <td>Off Upto 70%</td>
                        <td>03/12/2026</td>
                        <td>31/12/2026</td>
                        <td>
                            <div class="action-btns">
                                <button class="action-btn"><i data-lucide="edit-3"></i></button>
                                <button class="action-btn"><i data-lucide="trash-2"></i></button>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td>5</td>
                        <td>Winter Offer</td>
                        <td>Off Upto 30%</td>
                        <td>03/12/2026</td>
                        <td>30/12/2022</td>
                        <td>
                            <div class="action-btns">
                                <button class="action-btn"><i data-lucide="edit-3"></i></button>
                                <button class="action-btn"><i data-lucide="trash-2"></i></button>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>

            <div style="margin-top: 30px; display: flex; justify-content: center; gap: 10px;">
                <span style="font-weight: 700; border: 1px solid #000; padding: 5px 10px;">1</span>
                <span style="padding: 5px 10px; color: #6B7280; cursor: pointer;">2</span>
                <span style="padding: 5px 10px; color: #6B7280; cursor: pointer;">3</span>
                <span style="padding: 5px 10px; color: #6B7280;">...</span>
                <span style="padding: 5px 10px; color: #6B7280; cursor: pointer;">24</span>
            </div>
        </div>
    </main>

    <script>
        lucide.createIcons();
    </script>
</body>
</html>
