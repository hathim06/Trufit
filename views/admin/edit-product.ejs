<%- include('partials/head') %>
<style>
    /* Specific styles for Product forms */
    .form-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-bottom: 25px;
    }

    .size-grid {
        display: flex;
        gap: 10px;
        margin-top: 10px;
    }

    .size-box {
        width: 40px;
        height: 40px;
        border: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        transition: var(--transition);
        border-radius: 4px;
    }

    .size-box.active {
        background: #000;
        color: #FFF;
        border-color: #000;
    }

    .image-upload-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-top: 10px;
    }

    .image-upload-box {
        aspect-ratio: 1;
        background: #F3F4F6;
        border-radius: 12px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        border: 2px dashed transparent;
        transition: var(--transition);
    }

    .image-upload-box:hover {
        border-color: #000;
    }

    .image-upload-box i {
        margin-bottom: 10px;
        color: #4B5563;
    }

    .description-area {
        width: 100%;
        min-height: 150px;
        padding: 15px;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: #F3F4F6;
        outline: none;
        resize: vertical;
    }

    /* New Generation Selection UI */
    .chip-container {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 10px;
    }

    .chip-checkbox {
        display: none;
    }

    .chip-label {
        padding: 8px 16px;
        border: 1px solid #D1D5DB;
        border-radius: 8px;
        background: #fff;
        color: #374151;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .chip-checkbox:checked + .chip-label {
        background: #000;
        color: #fff;
        border-color: #000;
    }

    .color-swatch-label {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        border: 2px solid #D1D5DB;
        cursor: pointer;
        transition: all 0.2s;
        display: inline-block;
        position: relative;
    }

    .chip-checkbox:checked + .color-swatch-label {
        border-color: #000;
        transform: scale(1.1);
        box-shadow: 0 0 0 2px #fff, 0 0 0 4px #000;
    }

    .color-swatch-label[title]:hover::after {
        content: attr(title);
        position: absolute;
        bottom: 45px;
        left: 50%;
        transform: translateX(-50%);
        background: #000;
        color: #fff;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 10px;
        white-space: nowrap;
    }

    /* Color Swatch Classes */
    .color-swatch-Blue { background-color: #3B82F6; }
    .color-swatch-Red { background-color: #EF4444; }
    .color-swatch-Black { background-color: #000000; }
    .color-swatch-Green { background-color: #10B981; }
    .color-swatch-White { background-color: #FFFFFF; border: 1px solid #D1D5DB; }
    .color-swatch-Gold { background-color: #FBBF24; }
</style>
<body>
    <%- include('partials/sidebar', { activePage: 'products' }) %>

    <main class="main-content">
        <header class="page-header">
            <h1 class="page-title">EDIT PRODUCT</h1>
        </header>

        <div class="table-container">
            <form action="/admin/edit-product/<%= product._id %>" method="POST" enctype="multipart/form-data">
                <div class="form-group">
                    <label>PRODUCT NAME</label>
                    <input type="text" name="productName" value="<%= product.name %>" style="background: #E5E7EB; border: none;">
                </div>

                <div class="form-grid">
                    <div class="form-group">
                        <label>CATEGORY (ID)</label>
                        <input type="text" name="categoryId" value="<%= product.categoryId %>" style="background: #E5E7EB; border: none;">
                    </div>
                    <div class="form-group">
                        <label>OFFER (ID)</label>
                        <input type="text" name="offerId" value="<%= product.offerId %>" style="background: #E5E7EB; border: none;">
                    </div>
                    <div class="form-group">
                        <label>Show on Homepage</label>
                        <select name="showOnHomepage" style="background: #E5E7EB; border: none;">
                            <option value="Yes" <%= product.showOnHomepage ? 'selected' : '' %>>Yes</option>
                            <option value="No" <%= !product.showOnHomepage ? 'selected' : '' %>>No</option>
                        </select>
                    </div>
                </div>

                <div class="form-grid">
                    <div class="form-group">
                        <label>STATUS</label>
                        <select name="status" style="background: #E5E7EB; border: none;">
                            <option value="Active" <%= product.status === 'Active' ? 'selected' : '' %>>Active</option>
                            <option value="Inactive" <%= product.status === 'Inactive' ? 'selected' : '' %>>Inactive</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>PRICE</label>
                        <input type="number" name="price" value="<%= product.price %>" style="background: #E5E7EB; border: none;">
                    </div>
                    <div class="form-group">
                        <label>QUANTITY</label>
                        <input type="number" name="quantity" value="<%= product.quantity %>" style="background: #E5E7EB; border: none;">
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 40px; margin-bottom: 25px;">
                    <div class="form-group">
                        <label>EDIT SIZES</label>
                        <div class="chip-container">
                            <% ['S', 'M', 'L', 'XL', 'XXL', '3XL'].forEach(s => { %>
                                <input type="checkbox" name="size" value="<%= s %>" id="size-<%= s %>" class="chip-checkbox" <%= product.size && product.size.includes(s) ? 'checked' : '' %>>
                                <label for="size-<%= s %>" class="chip-label"><%= s %></label>
                            <% }) %>
                        </div>
                        <p style="font-size: 11px; color: #6B7280; margin-top: 5px;">Click to add/remove sizes.</p>
                    </div>
                    <div class="form-group">
                        <label>EDIT COLORS</label>
                        <div class="chip-container">
                            <% 
                                const colors = ['Blue', 'Red', 'Black', 'Green', 'White', 'Gold'];
                                colors.forEach(c => { 
                            %>
                                <input type="checkbox" name="color" value="<%= c %>" id="color-<%= c %>" class="chip-checkbox" <%= product.color && product.color.includes(c) ? 'checked' : '' %>>
                                <label for="color-<%= c %>" class="color-swatch-label color-swatch-<%= c %>" title="<%= c %>"></label>
                            <% }) %>
                        </div>
                        <p style="font-size: 11px; color: #6B7280; margin-top: 5px;">Click to toggle colors.</p>
                    </div>
                </div>

                <div class="form-group">
                    <label>PRODUCT IMAGES (Upload new to replace individual slots)</label>
                    <div class="image-upload-grid" style="grid-template-columns: 2fr 1fr 1fr 1fr; gap: 15px; height: 200px;">
                        <% 
                            const img0 = (product.image && product.image[0]) ? product.image[0] : "";
                            const img1 = (product.image && product.image[1]) ? product.image[1] : "";
                            const img2 = (product.image && product.image[2]) ? product.image[2] : "";
                            const img3 = (product.image && product.image[3]) ? product.image[3] : "";
                        %>
                        <!-- Main Image Slot -->
                        <div class="image-upload-slot" style="position: relative; border: 2px dashed #D1D5DB; border-radius: 12px; display: flex; flex-direction: column; align-items: center; justify-content: center; background: #F9FAFB; background-image: url('<%= img0 %>'); background-size: cover; background-position: center;">
                            <% if (!img0) { %>
                                <i data-lucide="image" style="width: 32px; height: 32px; color: #9CA3AF; margin-bottom: 8px;"></i>
                                <span style="font-size: 10px; font-weight: 600; color: #4B5563;">Main</span>
                            <% } %>
                            <input type="file" name="mainImage" style="position: absolute; width: 100%; height: 100%; opacity: 0; cursor: pointer;" onchange="previewImage(this)">
                        </div>
                        <!-- Front View Slot -->
                        <div class="image-upload-slot" style="position: relative; border: 2px dashed #D1D5DB; border-radius: 12px; display: flex; flex-direction: column; align-items: center; justify-content: center; background: #F9FAFB; background-image: url('<%= img1 %>'); background-size: cover; background-position: center;">
                            <% if (!img1) { %>
                                <span style="font-size: 10px; font-weight: 600; color: #4B5563;">Front</span>
                            <% } %>
                            <input type="file" name="preview1" style="position: absolute; width: 100%; height: 100%; opacity: 0; cursor: pointer;" onchange="previewImage(this)">
                        </div>
                        <!-- Back View Slot -->
                        <div class="image-upload-slot" style="position: relative; border: 2px dashed #D1D5DB; border-radius: 12px; display: flex; flex-direction: column; align-items: center; justify-content: center; background: #F9FAFB; background-image: url('<%= img2 %>'); background-size: cover; background-position: center;">
                            <% if (!img2) { %>
                                <span style="font-size: 10px; font-weight: 600; color: #4B5563;">Back</span>
                            <% } %>
                            <input type="file" name="preview2" style="position: absolute; width: 100%; height: 100%; opacity: 0; cursor: pointer;" onchange="previewImage(this)">
                        </div>
                        <!-- Side View Slot -->
                        <div class="image-upload-slot" style="position: relative; border: 2px dashed #D1D5DB; border-radius: 12px; display: flex; flex-direction: column; align-items: center; justify-content: center; background: #F9FAFB; background-image: url('<%= img3 %>'); background-size: cover; background-position: center;">
                            <% if (!img3) { %>
                                <span style="font-size: 10px; font-weight: 600; color: #4B5563;">Side</span>
                            <% } %>
                            <input type="file" name="preview3" style="position: absolute; width: 100%; height: 100%; opacity: 0; cursor: pointer;" onchange="previewImage(this)">
                        </div>
                    </div>
                </div>

                <div class="form-group" style="margin-top: 30px;">
                    <label>DESCRIPTION</label>
                    <textarea name="description" class="description-area" placeholder="Enter product description"><%= product.description %></textarea>
                </div>

                <div style="display: flex; justify-content: flex-end; margin-top: 40px;">
                    <button type="submit" class="btn btn-primary" style="padding: 12px 40px;">UPDATE PRODUCT</button>
                </div>
            </form>
        </div>
    </main>

    <script>
        lucide.createIcons();

        function previewImage(input) {
            const slot = input.parentElement;
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    slot.style.backgroundImage = `url(${e.target.result})`;
                    slot.style.backgroundSize = 'cover';
                    slot.style.backgroundPosition = 'center';
                    // Hide icon and text if they exist
                    const icon = slot.querySelector('i');
                    const text = slot.querySelector('span');
                    if(icon) icon.style.display = 'none';
                    if(text) text.style.display = 'none';
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
</body>
</html>
