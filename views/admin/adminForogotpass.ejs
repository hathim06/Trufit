<!DOCTYPE html>
<html lang="en">

<%- include('partials/head') %>
    <style>
        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .auth-container {
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 80px 20px;
        }

        .auth-box {
            width: 100%;
            max-width: 500px;
            border: 1px solid #E5E7EB;
            padding: 40px;
            background: #FFFFFF;
            text-align: center;
        }

        .auth-box h1 {
            font-size: 24px;
            margin-bottom: 15px;
            font-weight: 700;
        }

        .instruction {
            font-size: 13px;
            color: #4B5563;
            margin-bottom: 30px;
            line-height: 1.5;
            padding: 0 20px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
            text-align: left;
            margin-bottom: 30px;
        }

        .form-group label {
            font-size: 13px;
            font-weight: 600;
            color: #000;
        }

        .form-group label span {
            color: #FF0000;
        }

        .form-group input {
            padding: 12px 20px;
            border: 1px solid #D1D5DB;
            border-radius: 4px;
            font-family: inherit;
            font-size: 14px;
            outline: none;
        }

        .submit-btn {
            width: 100%;
            background: #000;
            color: #FFF;
            padding: 12px;
            border: none;
            border-radius: 4px;
            font-weight: 700;
            font-size: 16px;
            cursor: pointer;
            transition: var(--transition);
        }

        .submit-btn:hover {
            opacity: 0.9;
        }

        .back-link {
            display: block;
            margin-top: 25px;
            font-size: 12px;
            color: #4B5563;
            text-decoration: none;
        }

        .back-link a {
            color: #3B82F6;
            text-decoration: none;
            font-weight: 500;
        }
    </style>
    </head>

    <body>
        <%- include('partials/header') %>

            <main class="auth-container">
                <div class="auth-box">
                    <h1>Forgot Password ?</h1>
                    <p class="instruction">Enter your email address and we'll send a link to reset password</p>

                    <form>
                        <div class="form-group">
                            <label>Email <span>*</span></label>
                            <input type="email" required>
                        </div>
                        <button type="submit" class="submit-btn"
                            onclick="location.href='/users/reset-password'; return false;">Send Reset Link</button>
                    </form>

                    <div class="back-link">
                        Go to <a href="/users/login">Sign In</a>
                    </div>
                </div>
            </main>

            <%- include('partials/footer') %>
    </body>

</html>
