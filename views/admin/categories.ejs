<%- include('partials/head') %>
<body>
    <%- include('partials/sidebar', { activePage: 'categories' }) %>

    <main class="main-content">
        <header class="page-header">
            <h1 class="page-title">CATEGORY MANAGEMENT</h1>
            <button class="btn btn-primary" onclick="location.href='/admin/add-category'">ADD CATEGORY</button>
        </header>

        <div class="filter-bar">
            <input type="text" class="search-input" placeholder="Search Category...">
            <select>
                <option>All Category</option>
                <option>Active</option>
                <option>Inactive</option>
            </select>
        </div>

        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th style="width: 40%;">CATEGORY</th>
                        <th style="width: 30%;">STATUS</th>
                        <th>ACTION</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Casual</td>
                        <td><span class="status-badge" style="background: #FEE2E2; color: #991B1B;">INACTIVE</span></td>
                        <td>
                            <div class="action-btns">
                                <button class="action-btn" onclick="location.href='/admin/edit-category/1'"><i data-lucide="edit-3"></i></button>
                                <button class="action-btn"><i data-lucide="trash-2"></i></button>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td>Sports</td>
                        <td><span class="status-badge status-listed">ACTIVE</span></td>
                        <td>
                            <div class="action-btns">
                                <button class="action-btn"><i data-lucide="edit-3"></i></button>
                                <button class="action-btn"><i data-lucide="trash-2"></i></button>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td>Formal</td>
                        <td><span class="status-badge status-listed">ACTIVE</span></td>
                        <td>
                            <div class="action-btns">
                                <button class="action-btn"><i data-lucide="edit-3"></i></button>
                                <button class="action-btn"><i data-lucide="trash-2"></i></button>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td>Sneakers</td>
                        <td><span class="status-badge status-listed">ACTIVE</span></td>
                        <td>
                            <div class="action-btns">
                                <button class="action-btn"><i data-lucide="edit-3"></i></button>
                                <button class="action-btn"><i data-lucide="trash-2"></i></button>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>

            <div style="margin-top: 30px; display: flex; justify-content: center; gap: 10px;">
                <span style="font-weight: 700; border: 1px solid #000; padding: 5px 10px;">1</span>
                <span style="padding: 5px 10px; color: #6B7280; cursor: pointer;">2</span>
                <span style="padding: 5px 10px; color: #6B7280; cursor: pointer;">3</span>
                <span style="padding: 5px 10px; color: #6B7280;">...</span>
                <span style="padding: 5px 10px; color: #6B7280; cursor: pointer;">12</span>
            </div>
        </div>
    </main>

    <script>
        lucide.createIcons();
    </script>
</body>
</html>
