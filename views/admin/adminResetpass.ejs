<!DOCTYPE html>
<html lang="en">

<%- include('partials/head') %>
    <style>
        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .auth-container {
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 80px 20px;
        }

        .auth-box {
            width: 100%;
            max-width: 500px;
            border: 1px solid #E5E7EB;
            padding: 40px;
            background: #FFFFFF;
            text-align: center;
        }

        .auth-box h1 {
            font-size: 24px;
            margin-bottom: 10px;
            font-weight: 700;
        }

        .success-msg {
            font-size: 10px;
            font-weight: 600;
            color: #4B5563;
            text-transform: uppercase;
            margin-bottom: 25px;
            letter-spacing: 0.5px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
            text-align: left;
            margin-bottom: 20px;
        }

        .form-group label {
            font-size: 11px;
            font-weight: 700;
            color: #000;
            text-transform: uppercase;
        }

        .form-group input {
            padding: 12px 20px;
            border: 1px solid #D1D5DB;
            border-radius: 4px;
            font-family: inherit;
            font-size: 14px;
            outline: none;
        }

        .submit-btn {
            width: 100%;
            background: #000;
            color: #FFF;
            padding: 12px;
            border: none;
            border-radius: 4px;
            font-weight: 700;
            font-size: 14px;
            cursor: pointer;
            margin-top: 10px;
            transition: var(--transition);
        }

        .submit-btn:hover {
            opacity: 0.9;
        }
    </style>
    </head>

    <body>
        <%- include('partials/header') %>

            <main class="auth-container">
                <div class="auth-box">
                    <h1>New Password</h1>
                    <p class="success-msg">EMAIL VERIFICATION SUCCESSFULL</p>

                    <form>
                        <div class="form-group">
                            <label>NEW PASSWORD</label>
                            <input type="password" required>
                        </div>
                        <div class="form-group">
                            <label>RE-ENTER PASSWORD</label>
                            <input type="password" required>
                        </div>
                        <button type="submit" class="submit-btn">Reset Password</button>
                    </form>
                </div>
            </main>

            <%- include('partials/footer') %>
    </body>

</html>