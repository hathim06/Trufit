<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Product - Trufit</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <%- include('partials/head') %>
    <style>
        .form-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-bottom: 25px;
        }
        .size-grid {
            display: flex;
            gap: 10px;
            margin-top: 10px;
        }
        .size-box {
            width: 40px;
            height: 40px;
            border: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            border-radius: 4px;
        }
        .description-area {
            width: 100%;
            min-height: 150px;
            padding: 15px;
            border: 1px solid var(--border);
            border-radius: 12px;
            background: #F3F4F6;
            outline: none;
            resize: vertical;
        }

        /* New Generation Selection UI */
        .chip-container {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 10px;
        }

        .chip-checkbox {
            display: none;
        }

        .chip-label {
            padding: 8px 16px;
            border: 1px solid #D1D5DB;
            border-radius: 8px;
            background: #fff;
            color: #374151;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .chip-checkbox:checked + .chip-label {
            background: #000;
            color: #fff;
            border-color: #000;
        }

        .color-swatch-label {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            border: 2px solid #D1D5DB;
            cursor: pointer;
            transition: all 0.2s;
            display: inline-block;
            position: relative;
        }

        .chip-checkbox:checked + .color-swatch-label {
            border-color: #000;
            transform: scale(1.1);
            box-shadow: 0 0 0 2px #fff, 0 0 0 4px #000;
        }

        .color-swatch-label[title]:hover::after {
            content: attr(title);
            position: absolute;
            bottom: 45px;
            left: 50%;
            transform: translateX(-50%);
            background: #000;
            color: #fff;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 10px;
            white-space: nowrap;
        }

        /* Color Swatch Classes */
        .color-swatch-Blue { background-color: #3B82F6; }
        .color-swatch-Red { background-color: #EF4444; }
        .color-swatch-Black { background-color: #000000; }
        .color-swatch-Green { background-color: #10B981; }
        .color-swatch-White { background-color: #FFFFFF; border: 1px solid #D1D5DB; }
        .color-swatch-Gold { background-color: #FBBF24; }
    </style>
</head>

<body>
    <%- include('partials/sidebar', { activePage: 'products' }) %>

    <main class="main-content">
        <header class="page-header">
            <h1 class="page-title">ADD PRODUCT</h1>
            <button class="btn" style="background: #E5E7EB; color: #000; border-radius: 20px;">Add Variant +</button>
        </header>

        <div class="table-container">
            <form action="/admin/add-product" method="POST" enctype="multipart/form-data">
                <div class="form-group">
                    <label>PRODUCT NAME</label>
                    <input type="text" name="productName" placeholder="Enter product name"
                        style="background: #E5E7EB; border: none;" required>
                </div>

                <div class="form-grid">
                    <div class="form-group">
                        <label>CATEGORY (ID)</label>
                        <input type="text" name="categoryId" placeholder="Enter category ID"
                            style="background: #E5E7EB; border: none;">
                    </div>
                    <div class="form-group">
                        <label>OFFER (ID)</label>
                        <input type="text" name="offerId" placeholder="Enter offer ID"
                            style="background: #E5E7EB; border: none;">
                    </div>
                    <div class="form-group">
                        <label>Show on Homepage</label>
                        <select name="showOnHomepage" style="background: #E5E7EB; border: none;">
                            <option value="No">No</option>
                            <option value="Yes">Yes</option>
                        </select>
                    </div>
                </div>

                <div class="form-grid">
                    <div class="form-group">
                        <label>STATUS</label>
                        <select name="status" style="background: #E5E7EB; border: none;">
                            <option>Active</option>
                            <option>Inactive</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>PRICE</label>
                        <input type="number" name="price" placeholder="Enter price"
                            style="background: #E5E7EB; border: none;">
                    </div>
                    <div class="form-group">
                        <label>QUANTITY</label>
                        <input type="number" name="quantity" placeholder="Enter quantity"
                            style="background: #E5E7EB; border: none;">
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 40px; margin-bottom: 25px;">
                    <div class="form-group">
                        <label>SELECT SIZES</label>
                        <div class="chip-container">
                            <% ['S', 'M', 'L', 'XL', 'XXL', '3XL'].forEach(s => { %>
                                <input type="checkbox" name="size" value="<%= s %>" id="size-<%= s %>" class="chip-checkbox" <%= s === 'M' ? 'checked' : '' %>>
                                <label for="size-<%= s %>" class="chip-label"><%= s %></label>
                            <% }) %>
                        </div>
                        <p style="font-size: 11px; color: #6B7280; margin-top: 5px;">Simply click to toggle sizes.</p>
                    </div>
                    <div class="form-group">
                        <label>SELECT COLORS</label>
                        <div class="chip-container">
                            <% 
                                const colors = ['Blue', 'Red', 'Black', 'Green', 'White', 'Gold'];
                                colors.forEach(c => { 
                            %>
                                <input type="checkbox" name="color" value="<%= c %>" id="color-<%= c %>" class="chip-checkbox">
                                <label for="color-<%= c %>" class="color-swatch-label color-swatch-<%= c %>" title="<%= c %>"></label>
                            <% }) %>
                        </div>
                        <p style="font-size: 11px; color: #6B7280; margin-top: 5px;">Click to toggle colors (Up to 3 recommended).</p>
                    </div>
                </div>

                <div class="form-group">
                    <label>PRODUCT IMAGES</label>
                    <div class="image-upload-grid" style="grid-template-columns: 2fr 1fr 1fr 1fr; gap: 15px; height: 200px;">
                        <div class="image-upload-slot" style="position: relative; border: 2px dashed #D1D5DB; border-radius: 12px; display: flex; flex-direction: column; align-items: center; justify-content: center; background: #F9FAFB;">
                            <i data-lucide="image" style="width: 32px; height: 32px; color: #9CA3AF; margin-bottom: 8px;"></i>
                            <span style="font-size: 12px; font-weight: 600; color: #4B5563;">Main Image</span>
                            <input type="file" name="mainImage" style="position: absolute; width: 100%; height: 100%; opacity: 0; cursor: pointer;" required onchange="previewImage(this)">
                        </div>
                        <div class="image-upload-slot" style="position: relative; border: 2px dashed #D1D5DB; border-radius: 12px; display: flex; flex-direction: column; align-items: center; justify-content: center; background: #F9FAFB;">
                            <span style="font-size: 10px; font-weight: 600; color: #4B5563;">Front</span>
                            <input type="file" name="preview1" style="position: absolute; width: 100%; height: 100%; opacity: 0; cursor: pointer;" onchange="previewImage(this)">
                        </div>
                        <div class="image-upload-slot" style="position: relative; border: 2px dashed #D1D5DB; border-radius: 12px; display: flex; flex-direction: column; align-items: center; justify-content: center; background: #F9FAFB;">
                            <span style="font-size: 10px; font-weight: 600; color: #4B5563;">Back</span>
                            <input type="file" name="preview2" style="position: absolute; width: 100%; height: 100%; opacity: 0; cursor: pointer;" onchange="previewImage(this)">
                        </div>
                        <div class="image-upload-slot" style="position: relative; border: 2px dashed #D1D5DB; border-radius: 12px; display: flex; flex-direction: column; align-items: center; justify-content: center; background: #F9FAFB;">
                            <span style="font-size: 10px; font-weight: 600; color: #4B5563;">Side</span>
                            <input type="file" name="preview3" style="position: absolute; width: 100%; height: 100%; opacity: 0; cursor: pointer;" onchange="previewImage(this)">
                        </div>
                    </div>
                </div>

                <div class="form-group" style="margin-top: 30px;">
                    <label>DESCRIPTION</label>
                    <textarea name="description" class="description-area"
                        placeholder="Enter product description"></textarea>
                </div>

                <div style="display: flex; justify-content: flex-end; margin-top: 40px;">
                    <button type="submit" class="btn btn-primary" style="padding: 12px 40px;">ADD PRODUCT</button>
                </div>
            </form>
        </div>
    </main>

    <script>
        lucide.createIcons();

        function previewImage(input) {
            const slot = input.parentElement;
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    slot.style.backgroundImage = `url(${e.target.result})`;
                    slot.style.backgroundSize = 'cover';
                    slot.style.backgroundPosition = 'center';
                    // Hide icon and text
                    const icon = slot.querySelector('i');
                    const text = slot.querySelector('span');
                    if(icon) icon.style.display = 'none';
                    if(text) text.style.display = 'none';
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        // Check for query parameters for success/error messages
        const urlParams = new URLSearchParams(window.location.search);
        const successMsg = urlParams.get('success');
        const errorMsg = urlParams.get('error');

        if (successMsg) {
            Swal.fire({
                icon: 'success',
                title: 'Success!',
                text: successMsg,
                timer: 3000,
                showConfirmButton: false
            });
        }

        if (errorMsg) {
            Swal.fire({
                icon: 'error',
                title: 'Oops...',
                text: errorMsg
            });
        }
    </script>
</body>
</html>