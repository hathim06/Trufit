<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>

<%- include('partials/head') %>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <body>

        <%- include('partials/sidebar', { activePage: 'products' }) %>

            <main class="main-content">
                <%- include('./partials/adminHeader', { title: 'PRODUCT MANAGEMENT' }) %>
                    <div style="margin-bottom: 20px; display: flex; justify-content: flex-end;">
                        <button class="btn btn-primary" onclick="location.href='/admin/add-product'">ADD
                            PRODUCTS</button>
                    </div>

                    <div class="filter-bar">
                        <input type="text" class="search-input" placeholder="Search Product...">
                        <select>
                            <option>All Categories</option>
                            <option>Men</option>
                            <option>Women</option>
                            <option>Smartwatch</option>
                        </select>
                    </div>

                    <div class="table-container">
                        <table>
                            <thead>
                                <tr>
                                    <th>PRODUCTS</th>
                                    <th>CATEGORY</th>
                                    <th>PRICE</th>
                                    <th>OFFER</th>
                                    <th>STATUS</th>
                                    <th>STOCK</th>
                                    <th>ACTION</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (products && products.length> 0) { %>
                                    <% products.forEach(product=> { %>
                                        <tr>
                                            <td>
                                                <div style="display: flex; align-items: center; gap: 10px;">
                                                    <% if (product.image && product.image.length> 0) { %>
                                                        <img src="<%= product.image[0] %>" alt="<%= product.name %>"
                                                            style="width: 40px; height: 40px; object-fit: cover; border-radius: 4px;">
                                                        <% } %>
                                                            <%= product.name %>
                                                </div>
                                            </td>
                                            <td>
                                                <%= product.categoryId ? product.categoryId : 'General' %>
                                            </td>
                                            <td>₹<%= product.price %>
                                            </td>
                                            <td>
                                                <%= product.offer %>%
                                            </td>
                                            <td>
                                                <span
                                                    class="status-badge <%= product.status === 'Active' ? 'status-listed' : 'status-unlisted' %>">
                                                    <%= product.status.toUpperCase() %>
                                                </span>
                                            </td>
                                            <td>
                                                <%= product.quantity %> left
                                            </td>
                                            <td>
                                                <div class="action-btns">
                                                    <button class="action-btn"
                                                        onclick="location.href='/admin/edit-product/<%= product._id %>'"><i
                                                            data-lucide="edit-3"></i></button>
                                                    <button class="action-btn"
                                                        onclick="confirmDelete('<%= product._id %>')"><i
                                                            data-lucide="trash-2"></i></button>
                                                </div>
                                            </td>
                                        </tr>
                                        <% }) %>
                                            <% } else { %>
                                                <tr>
                                                    <td colspan="7" style="text-align: center; padding: 40px;">No
                                                        products found.</td>
                                                </tr>
                                                <% } %>
                            </tbody>
                        </table>

                        <div class="pagination"
                            style="margin-top: 30px; display: flex; justify-content: center; gap: 10px;">
                            <% if (currentPage > 1) { %>
                                <a href="/admin/products?page=<%= currentPage - 1 %>&search=<%= search %>"
                                    style="padding: 5px 10px; text-decoration: none; color: #4F46E5; border: 1px solid #D1D5DB; border-radius: 4px;">&laquo;
                                    Previous</a>
                                <% } %>

                                    <% for(let i=1; i <=totalPages; i++) { %>
                                        <% if (i===currentPage) { %>
                                            <span
                                                style="font-weight: 700; border: 1px solid #000; padding: 5px 10px; background: #000; color: #fff; border-radius: 4px;">
                                                <%= i %>
                                            </span>
                                            <% } else if (i===1 || i===totalPages || (i>= currentPage - 2 && i <=
                                                    currentPage + 2)) { %>
                                                    <a href="/admin/products?page=<%= i %>&search=<%= search %>"
                                                        style="padding: 5px 10px; text-decoration: none; color: #6B7280; border: 1px solid #D1D5DB; border-radius: 4px; margin: 0 2px;">
                                                        <%= i %>
                                                    </a>
                                                    <% } else if (i===currentPage - 3 || i===currentPage + 3) { %>
                                                        <span style="padding: 5px 10px; color: #6B7280;">...</span>
                                                        <% } %>
                                                            <% } %>

                                                                <% if (currentPage < totalPages) { %>
                                                                    <a href="/admin/products?page=<%= currentPage + 1 %>&search=<%= search %>"
                                                                        style="padding: 5px 10px; text-decoration: none; color: #4F46E5; border: 1px solid #D1D5DB; border-radius: 4px;">Next
                                                                        &raquo;</a>
                                                                    <% } %>
                        </div>
                    </div>
            </main>

            <script>
                lucide.createIcons();

                function confirmDelete(productId) {
                    Swal.fire({
                        title: 'Are you sure?',
                        text: "You won't be able to revert this! The product will be unlisted.",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#000',
                        cancelButtonColor: '#d33',
                        confirmButtonText: 'Yes, delete it!'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            fetch(`/admin/delete-product/${productId}`, {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json'
                                }
                            })
                            .then(response => response.json())
                            .then(data => {
                                if (data.success) {
                                    Swal.fire({
                                        title: 'Deleted!',
                                        text: data.message,
                                        icon: 'success',
                                        confirmButtonColor: '#000'
                                    }).then(() => {
                                        location.reload();
                                    });
                                } else {
                                    Swal.fire({
                                        title: 'Error!',
                                        text: data.message,
                                        icon: 'error',
                                        confirmButtonColor: '#000'
                                    });
                                }
                            })
                            .catch(error => {
                                console.error('Error:', error);
                                Swal.fire({
                                    title: 'Error!',
                                    text: 'An unexpected error occurred.',
                                    icon: 'error',
                                    confirmButtonColor: '#000'
                                });
                            });
                        }
                    });
                }
            </script>


    </body>

</html>