<%- include('partials/head') %>
<body>
    <%- include('partials/sidebar', { activePage: 'products' }) %>

    <main class="main-content">
        <header class="page-header">
            <h1 class="page-title">PRODUCT MANAGEMENT</h1>
            <button class="btn btn-primary" onclick="location.href='/admin/add-product'">ADD PRODUCTS</button>
        </header>

        <div class="filter-bar">
            <input type="text" class="search-input" placeholder="Search Product...">
            <select>
                <option>All Categories</option>
                <option>Men</option>
                <option>Women</option>
                <option>Smartwatch</option>
            </select>
        </div>

        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>PRODUCTS</th>
                        <th>CATEGORY</th>
                        <th>PRICE</th>
                        <th>OFFER</th>
                        <th>STATUS</th>
                        <th>STOCK</th>
                        <th>ACTION</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Product Name</td>
                        <td>Men</td>
                        <td>₹1.000</td>
                        <td>10%</td>
                        <td><span class="status-badge status-unlisted">UNLIST</span></td>
                        <td>45 left</td>
                        <td>
                            <div class="action-btns">
                                <button class="action-btn"><i data-lucide="edit-3"></i></button>
                                <button class="action-btn"><i data-lucide="trash-2"></i></button>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td>Product Name</td>
                        <td>Women</td>
                        <td>₹4.000</td>
                        <td>15%</td>
                        <td><span class="status-badge status-listed">LIST</span></td>
                        <td>22 left</td>
                        <td>
                            <div class="action-btns">
                                <button class="action-btn"><i data-lucide="edit-3"></i></button>
                                <button class="action-btn"><i data-lucide="trash-2"></i></button>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td>Product Name</td>
                        <td>Smartwatch</td>
                        <td>₹2.500</td>
                        <td>10%</td>
                        <td><span class="status-badge status-listed">LIST</span></td>
                        <td>15 left</td>
                        <td>
                            <div class="action-btns">
                                <button class="action-btn"><i data-lucide="edit-3"></i></button>
                                <button class="action-btn"><i data-lucide="trash-2"></i></button>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td>Product Name</td>
                        <td>Men</td>
                        <td>₹1.800</td>
                        <td>25%</td>
                        <td><span class="status-badge status-listed">LIST</span></td>
                        <td>5 left</td>
                        <td>
                            <div class="action-btns">
                                <button class="action-btn"><i data-lucide="edit-3"></i></button>
                                <button class="action-btn"><i data-lucide="trash-2"></i></button>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>

            <div style="margin-top: 30px; display: flex; justify-content: center; gap: 10px;">
                <span style="font-weight: 700; border: 1px solid #000; padding: 5px 10px;">1</span>
                <span style="padding: 5px 10px; color: #6B7280; cursor: pointer;">2</span>
                <span style="padding: 5px 10px; color: #6B7280; cursor: pointer;">3</span>
                <span style="padding: 5px 10px; color: #6B7280;">...</span>
                <span style="padding: 5px 10px; color: #6B7280; cursor: pointer;">24</span>
            </div>
        </div>
    </main>

    <script>
        lucide.createIcons();
    </script>
</body>
</html>
