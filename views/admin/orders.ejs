<%- include('partials/head') %>
<style>
    .status-text {
        font-weight: 600;
        font-size: 14px;
    }
    .status-delivered { color: #10B981; }
    .status-pending { color: #F59E0B; }
    .status-cancelled { color: #EF4444; }
    .status-shipped { color: #3B82F6; }
</style>
<body>
    <%- include('partials/sidebar', { activePage: 'orders' }) %>

    <main class="main-content">
        <%- include('./partials/adminHeader', { title: 'ORDER MANAGEMENT' }) %>

        <div class="filter-bar">
            <input type="text" class="search-input" placeholder="Search Order...">
            <select>
                <option>All Status</option>
                <option>Pending</option>
                <option>Shipped</option>
                <option>Delivered</option>
                <option>Cancelled</option>
            </select>
        </div>

        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>ORDER ID</th>
                        <th>CUSTOMER</th>
                        <th>DATE</th>
                        <th>TOTAL PRICE</th>
                        <th>STATUS</th>
                        <th>ACTION</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>#811</td>
                        <td>Hans Burger</td>
                        <td>12/03/2026</td>
                        <td>₹1,999</td>
                        <td><span class="status-text status-delivered">Delivered</span></td>
                        <td>
                            <div class="action-btns">
                                <button class="action-btn" onclick="location.href='/admin/order/811'"><i data-lucide="eye"></i></button>
                                <button class="action-btn" onclick="location.href='/admin/edit-order/811'"><i data-lucide="edit-3"></i></button>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td>#812</td>
                        <td>Kailu Roberts</td>
                        <td>12/03/2026</td>
                        <td>₹3,999</td>
                        <td><span class="status-text status-pending">Pending</span></td>
                        <td>
                            <div class="action-btns">
                                <button class="action-btn"><i data-lucide="eye"></i></button>
                                <button class="action-btn"><i data-lucide="edit-3"></i></button>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td>#813</td>
                        <td>Sarah Conly</td>
                        <td>12/03/2026</td>
                        <td>₹2,500</td>
                        <td><span class="status-text status-cancelled">Cancelled</span></td>
                        <td>
                            <div class="action-btns">
                                <button class="action-btn"><i data-lucide="eye"></i></button>
                                <button class="action-btn"><i data-lucide="edit-3"></i></button>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td>#814</td>
                        <td>Kailu Roberts</td>
                        <td>12/03/2026</td>
                        <td>₹1,100</td>
                        <td><span class="status-text status-shipped">Shipped</span></td>
                        <td>
                            <div class="action-btns">
                                <button class="action-btn"><i data-lucide="eye"></i></button>
                                <button class="action-btn"><i data-lucide="edit-3"></i></button>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>

            <div style="margin-top: 30px; display: flex; justify-content: center; gap: 10px;">
                <span style="font-weight: 700; border: 1px solid #000; padding: 5px 10px;">1</span>
                <span style="padding: 5px 10px; color: #6B7280; cursor: pointer;">2</span>
                <span style="padding: 5px 10px; color: #6B7280; cursor: pointer;">3</span>
                <span style="padding: 5px 10px; color: #6B7280;">...</span>
                <span style="padding: 5px 10px; color: #6B7280; cursor: pointer;">24</span>
            </div>
        </div>
    </main>

    <script>
        lucide.createIcons();
    </script>
</body>
</html>
